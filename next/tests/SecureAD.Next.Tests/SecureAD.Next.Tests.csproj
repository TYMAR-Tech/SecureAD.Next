<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>SecureAD.Next.Tests</RootNamespace>
    <AssemblyName>SecureAD.Next.Tests</AssemblyName>

    <!-- Matched to SecureAD.Cli and SecureAD.Shell, which have said this since they were written.
         Without it this project built as MSIL while referencing their AMD64 output, which every
         build reported as MSB3270 and nobody acted on.

         It also decides where native dependencies land. Left unset, SQLite's native library sits
         under runtimes\win-x64\native and is found only by the .NET host - so a folder copied to
         another machine and driven by a script has to carry that subtree, and a partial copy fails
         at the first connection with a message naming nothing useful. Stated here, the native
         library is written beside the assemblies and a flat copy is enough. SelfContained stays
         off, for the reason the other two projects give. -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- The guards reflect over SecureAD.Shell, which is a WPF assembly, so PresentationFramework
         must resolve here. Taken as a framework reference rather than by setting UseWPF: UseWPF
         swaps the implicit-usings set, which silently removes System.IO from every existing test
         file in this project. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SecureAD.Kernel\SecureAD.Kernel.csproj" />
    <ProjectReference Include="..\..\src\SecureAD.Evidence\SecureAD.Evidence.csproj" />
    <ProjectReference Include="..\..\src\SecureAD.Judgement\SecureAD.Judgement.csproj" />
    <ProjectReference Include="..\..\src\SecureAD.Audit\SecureAD.Audit.csproj" />
    <ProjectReference Include="..\..\src\SecureAD.Cli\SecureAD.Cli.csproj" />
    <ProjectReference Include="..\..\src\SecureAD.Shell\SecureAD.Shell.csproj" />
    <ProjectReference Include="..\..\src\SecureAD.Derivation\SecureAD.Derivation.csproj" />
    <ProjectReference Include="..\SecureAD.Sysvol.TestWorker\SecureAD.Sysvol.TestWorker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopySysvolTestWorker" AfterTargets="Build">
    <ItemGroup>
      <SysvolTestWorkerFiles Include="$(MSBuildThisFileDirectory)..\SecureAD.Sysvol.TestWorker\bin\$(Configuration)\net10.0-windows\win-x64\*" />
    </ItemGroup>
    <Copy SourceFiles="@(SysvolTestWorkerFiles)" DestinationFolder="$(OutDir)SysvolTestWorker" />
  </Target>

</Project>
