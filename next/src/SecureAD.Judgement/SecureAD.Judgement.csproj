<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SecureAD.Judgement</RootNamespace>
    <AssemblyName>SecureAD.Judgement</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <!-- Judgement coordinates executable rules over both sealed evidence and reusable derived facts.
       Evidence and Derivation do not depend on it: capture must be able to produce a bundle with
       nothing that judges it present, and derivation must never see a rule or it could compute what
       one rule wanted rather than what the directory said. -->
  <ItemGroup>
    <ProjectReference Include="..\SecureAD.Evidence\SecureAD.Evidence.csproj" />
    <ProjectReference Include="..\SecureAD.Derivation\SecureAD.Derivation.csproj" />
  </ItemGroup>

</Project>
