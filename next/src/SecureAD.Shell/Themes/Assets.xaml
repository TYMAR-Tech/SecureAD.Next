<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:SecureAD.Shell.Views">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ItemsPanelTemplate x:Key="AssetFooterColumns">
        <views:FieldGrid Columns="2" MinimumColumnWidth="360" />
    </ItemsPanelTemplate>

    <Style x:Key="MissingAttributeToggle" TargetType="CheckBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="MissingToggleOutline" Width="16" Height="16" CornerRadius="3"
                                BorderThickness="1" BorderBrush="{DynamicResource AttributeLabelBrush}"
                                Background="{DynamicResource SurfaceRaisedBackground}" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Path x:Name="Tick" Data="M 0,4 L 3,7 L 9,0" Stretch="Uniform" Margin="3"
                                  Stroke="{DynamicResource FocusBrush}" StrokeThickness="2" Visibility="Collapsed" />
                        </Border>
                        <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource UiFontFamily}" FontSize="{DynamicResource LabelFontSize}"
                                   Foreground="{DynamicResource AttributeLabelBrush}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="MissingToggleOutline" Property="BorderThickness" Value="2" />
                            <Setter TargetName="MissingToggleOutline" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BrowsingScopeSegment" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource AttributeLabelBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBackground}" />
        <Setter Property="Padding" Value="6,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Segment" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="0,0,0,2"
                            Padding="{TemplateBinding Padding}">
                        <TextBlock x:Name="ScopeLabel" Text="{TemplateBinding Content}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Segment" Property="Background" Value="{DynamicResource AttributeHeaderBackground}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Segment" Property="Background" Value="{DynamicResource SelectionBrush}" />
                            <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource FocusBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            <Setter TargetName="Segment" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Segment" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AttributeCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AttributeCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="0,0,10,10" />
    </Style>

    <Style x:Key="AttributeCardLabel" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlock}">
        <Setter Property="FontSize" Value="{StaticResource LabelFontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource EmphasisFontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource AttributeLabelBrush}" />
    </Style>

    <Style x:Key="AttributeCardValue" TargetType="TextBox" BasedOn="{StaticResource SelectableMessage}">
        <Setter Property="FontSize" Value="{StaticResource RowTitleFontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource EmphasisFontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource AttributeValueBrush}" />
    </Style>

</ResourceDictionary>
