<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A choice between a few options, on a light surface.

         WHY THIS EXISTS. The product's only RadioButton style is the one the rail wears: light
         text for a navy background. Worn on a white screen, an unselected option is white on
         white - invisible until clicked. Seen on screen 2026-08-20 on the Assets level control,
         where two of the three options could not be read.

         Keyed rather than implicit, and the rail's style is left alone: the rail has been looked
         at and is right, and restyling it to fix a different screen is how a reviewed thing
         quietly breaks.

         THE COLOUR IS SET ON THE TEXTBLOCK THAT DRAWS THE TEXT. A ContentPresenter may or may not
         pass an inherited Foreground to whatever it builds, and the XAML will not tell you which.

         WHAT WAS HERE BEFORE. This held a pill-shaped style, ChoiceButton, drawing each option as
         a filled rectangle. It went on 2026-09-03 with its last user. The level control moved into
         the 300-pixel tree column, where three pills in a row clipped the third off the screen
         entirely, and the owner asked for radio buttons: a filled pill states the answer but not
         the question, where a ring and a dot say "pick exactly one" without the operator having to
         hover to find out. Deleted rather than kept, because a style nothing wears is one more
         thing the next reader has to decide about. -->

    <!-- One option of a choice: a ring, a dot when it is the answer, and its label.

         STACKS RATHER THAN SITTING IN A ROW, which is what the tree column needs. -->

    <Style x:Key="ChoiceRadio" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse x:Name="Ring"
                                     Stroke="{StaticResource BorderBrush}"
                                     StrokeThickness="1"
                                     Fill="{StaticResource SurfaceRaisedBackground}" />
                            <Ellipse x:Name="Dot"
                                     Width="8" Height="8"
                                     Fill="{StaticResource AccentBrush}"
                                     Visibility="Collapsed" />
                        </Grid>
                        <TextBlock x:Name="Label"
                                   Text="{TemplateBinding Content}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke"
                                    Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Ring" Property="Stroke"
                                    Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
