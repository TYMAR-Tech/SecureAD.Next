<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:SecureAD.Shell.ViewModels">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FluentTreeGeometry.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- The tree. New vocabulary, added for the Assets screen.

         Its own dictionary rather than a block in Controls.xaml because editing tools in this
         workspace will not write to that file - see how-the-app-looks.md, lesson 9.

         COLOUR IS SET ON THE THING THAT DRAWS. A TreeViewItem header is built by a
         ContentPresenter, so the view supplies a TextBlock with a local Foreground; nothing here
         relies on an inherited value reaching it.

         The expander is drawn in XAML; object-type icons use embedded Microsoft vector geometry. -->

    <Style x:Key="TreeNodeIconPath" TargetType="Path">
        <Setter Property="Data" Value="{StaticResource FluentTreeFolder}" />
        <Setter Property="Fill" Value="{DynamicResource FocusBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IconKind}" Value="{x:Static vm:TreeNodeIconKind.Domain}">
                <Setter Property="Data" Value="{StaticResource FluentTreeGlobe}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IconKind}" Value="{x:Static vm:TreeNodeIconKind.Configuration}">
                <Setter Property="Data" Value="{StaticResource FluentTreeSettings}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IconKind}" Value="{x:Static vm:TreeNodeIconKind.Schema}">
                <Setter Property="Data" Value="{StaticResource FluentTreeLayer}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IconKind}" Value="{x:Static vm:TreeNodeIconKind.Unknown}">
                <Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="TreeNodeIcon">
        <Viewbox Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                 IsHitTestVisible="False">
            <Canvas Width="20" Height="20">
                <Path Style="{StaticResource TreeNodeIconPath}" />
                <Path Data="{StaticResource FluentTreeOrganization}" Fill="{DynamicResource FocusBrush}">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="0.48" ScaleY="0.48" />
                            <TranslateTransform X="5.2" Y="7" />
                        </TransformGroup>
                    </Path.RenderTransform>
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IconKind}" Value="{x:Static vm:TreeNodeIconKind.OrganizationalUnit}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <Style x:Key="TreeExpander" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Padding="2">
                        <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 0 8 Z"
                              Fill="{DynamicResource SecondaryTextBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- The shape changes, not its angle. A trigger cannot target a name
                                 inside a RenderTransform - the build says so - and a closed and
                                 an open branch differing in silhouette is what this product
                                 asks of its marks anyway. -->
                            <Setter TargetName="Arrow" Property="Data" Value="M 0 0 L 8 0 L 4 4 Z" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Padding" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ToggleButton x:Name="Expander" Grid.Row="0" Grid.Column="0"
                                      Style="{StaticResource TreeExpander}" ClickMode="Press"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border x:Name="Row" Grid.Row="0" Grid.Column="1" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ItemsPresenter x:Name="Children" Grid.Row="1" Grid.Column="1"
                                        Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Children" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background"
                                    Value="{DynamicResource SelectionBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
    </Style>

</ResourceDictionary>
