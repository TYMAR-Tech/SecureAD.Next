<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:SecureAD.Shell.Views">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Assets.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="DelegationPanel" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{DynamicResource AssetNavigationBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AttributeCardBorderBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="DelegationPanelHeading" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ObjectSectionHeadingBackground}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="7,7,0,0" />
    </Style>
    <Style x:Key="DelegationLabel" TargetType="TextBlock" BasedOn="{StaticResource BlockLabel}">
        <Setter Property="Foreground" Value="{DynamicResource AttributeLabelBrush}" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>
    <Style x:Key="DelegationColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource TableColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource AttributeHeaderBackground}" />
        <Setter Property="ContentTemplate">
            <Setter.Value><DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource AttributeLabelBrush}"
                           FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold" />
            </DataTemplate></Setter.Value>
        </Setter>
    </Style>
    <ItemsPanelTemplate x:Key="DelegationColumns">
        <views:FieldGrid Columns="2" MinimumColumnWidth="470" />
    </ItemsPanelTemplate>
</ResourceDictionary>
