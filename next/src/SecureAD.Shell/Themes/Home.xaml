<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:SecureAD.Shell.Views">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="HomePanel" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{DynamicResource AssetNavigationBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AttributeCardBorderBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="HomePanelHeading" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ObjectSectionHeadingBackground}" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="CornerRadius" Value="7,7,0,0" />
    </Style>
    <Style x:Key="HomeLabel" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlock}">
        <Setter Property="FontSize" Value="{StaticResource LabelFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource AttributeLabelBrush}" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>
    <Style x:Key="HomeColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource TableColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource AttributeHeaderBackground}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="{DynamicResource AttributeLabelBrush}"
                               FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HomeRunCell" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlock}">
        <Setter Property="Margin" Value="8" />
        <Setter Property="FontSize" Value="{StaticResource LabelFontSize}" />
    </Style>
    <ItemsPanelTemplate x:Key="HomeStateColumns">
        <views:FieldGrid Columns="2" MinimumColumnWidth="130" />
    </ItemsPanelTemplate>
</ResourceDictionary>
