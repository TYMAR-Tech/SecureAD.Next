    <SolidColorBrush x:Key="CriticalFindingBrush" Color="{DynamicResource CriticalFindingBrushColor}" />
    <SolidColorBrush x:Key="CriticalFindingSubtleBrush" Color="{DynamicResource CriticalFindingSubtleBrushColor}" />
    <SolidColorBrush x:Key="RailBackground" Color="{DynamicResource RailBackgroundColor}" />
    <SolidColorBrush x:Key="RailSelectedBackground" Color="{DynamicResource RailSelectedBackgroundColor}" />
    <SolidColorBrush x:Key="RailTextBrush" Color="{DynamicResource RailTextBrushColor}" />
    <SolidColorBrush x:Key="RailSelectedTextBrush" Color="{DynamicResource RailSelectedTextBrushColor}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{DynamicResource ScrimBrushColor}" />
    <SolidColorBrush x:Key="TableHeaderBackground" Color="{DynamicResource TableHeaderBackgroundColor}" />
    <SolidColorBrush x:Key="TableHeaderTextBrush" Color="{DynamicResource TableHeaderTextBrushColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerBrushColor}" />
