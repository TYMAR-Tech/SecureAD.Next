<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Stable brush objects. Their colors resolve dynamically from the active semantic palette. -->
    <SolidColorBrush x:Key="WindowBackground" Color="{DynamicResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBackground" Color="{DynamicResource SurfaceBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBackground" Color="{DynamicResource SurfaceRaisedBackgroundColor}" />
    <SolidColorBrush x:Key="AssetCanvasBackground" Color="{DynamicResource AssetCanvasBackgroundColor}" />
    <SolidColorBrush x:Key="AssetNavigationBackground" Color="{DynamicResource AssetNavigationBackgroundColor}" />
    <SolidColorBrush x:Key="AttributeHeaderBackground" Color="{DynamicResource AttributeHeaderBackgroundColor}" />
    <SolidColorBrush x:Key="ObjectSectionHeadingBackground" Color="{DynamicResource ObjectSectionHeadingBackgroundColor}" />
    <SolidColorBrush x:Key="AttributeCardBorderBrush" Color="{DynamicResource AttributeCardBorderBrushColor}" />
    <SolidColorBrush x:Key="AttributeLabelBrush" Color="{DynamicResource AttributeLabelBrushColor}" />
    <SolidColorBrush x:Key="AttributeSourceBrush" Color="{DynamicResource AttributeSourceBrushColor}" />
    <SolidColorBrush x:Key="AttributeValueBrush" Color="{DynamicResource AttributeValueBrushColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{DynamicResource DividerBrushColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderBrushColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{DynamicResource PrimaryTextBrushColor}" />
    <SolidColorBrush x:Key="LabelTextBrush" Color="{DynamicResource LabelTextBrushColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{DynamicResource SecondaryTextBrushColor}" />
