    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{DynamicResource AccentSubtleBrushColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{DynamicResource FocusBrushColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{DynamicResource SelectionBrushColor}" />
    <SolidColorBrush x:Key="EstablishedGoodBrush" Color="{DynamicResource EstablishedGoodBrushColor}" />
    <SolidColorBrush x:Key="EstablishedGoodSubtleBrush" Color="{DynamicResource EstablishedGoodSubtleBrushColor}" />
    <SolidColorBrush x:Key="EstablishedBadBrush" Color="{DynamicResource EstablishedBadBrushColor}" />
