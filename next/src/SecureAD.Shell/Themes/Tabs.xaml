<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Two tiers of tabs, and THEY MUST NOT LOOK ALIKE.

         The whole risk of two rows is that an operator cannot tell which row he is switching. The
         first tier is the product's own navigation - navy, the colour the rail wore, carrying the
         product's identity. The second tier sits on the page beneath it, quieter, marked by an
         underline rather than a fill. Different ground, different mark, different weight.

         COLOUR IS SET ON THE TEXTBLOCK THAT DRAWS THE TEXT, never on anything holding it. -->

    <Style x:Key="PrimaryTab" TargetType="RadioButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Tab" Background="Transparent" Padding="18,12">
                        <TextBlock x:Name="Label"
                                   Text="{TemplateBinding Content}"
                                   FontFamily="{StaticResource UiFontFamily}"
                                   FontSize="{StaticResource BodyFontSize}"
                                   Foreground="{DynamicResource RailTextBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="Foreground"
                                    Value="{DynamicResource RailSelectedTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tab" Property="Background"
                                    Value="{DynamicResource RailSelectedBackground}" />
                            <Setter TargetName="Label" Property="Foreground"
                                    Value="{DynamicResource RailSelectedTextBrush}" />
                            <Setter TargetName="Label" Property="FontWeight"
                                    Value="{StaticResource EmphasisFontWeight}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryTab" TargetType="RadioButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Tab"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,3"
                            Padding="14,8">
                        <TextBlock x:Name="Label"
                                   Text="{TemplateBinding Content}"
                                   FontFamily="{StaticResource UiFontFamily}"
                                   FontSize="{StaticResource BodyFontSize}"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="Foreground"
                                    Value="{DynamicResource PrimaryTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tab" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Label" Property="Foreground"
                                    Value="{DynamicResource PrimaryTextBrush}" />
                            <Setter TargetName="Label" Property="FontWeight"
                                    Value="{StaticResource EmphasisFontWeight}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
