<UserControl x:Class="SecureAD.Shell.Views.DomainDetailsView" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Everything the table stopped carrying: the site, the connection, whether the controller
        serves the partition, the password settings container and the PDC emulator.

        A PANEL OVER THE TABLE, not a window over the shell - 0071. It covers the surface it came
        from, which is what a window did, without a second title bar the product does not draw.

        A row shortcut supplies only the selected domain; the general details action still
        supplies every domain. Both use recorded answers, without new checks.

        EVERY FACT KEEPS ITS MARK. The three states of 0056 travel with the sentence, so a question
        nobody could answer still reads differently from an answer of no.
    -->

    <DockPanel>

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,16">
            <StackPanel>
                <TextBlock Text="{Binding Heading}" Style="{StaticResource ScreenTitle}" />
                <TextBlock Text="Recorded readiness and scope. Viewing details does not run new checks."
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Button Content="Close"
                    Command="{Binding CloseCommand}"
                    MinWidth="100"
                    HorizontalAlignment="Right" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding Domains}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="0,0,0,14"
                                Margin="0,0,0,14">
                            <StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Domain}"
                                               Style="{StaticResource RowTitle}"
                                               FontWeight="{StaticResource EmphasisFontWeight}" />
                                    <TextBlock Text="{Binding Controller}"
                                               Style="{StaticResource Identifier}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0" />
                                </StackPanel>

                                <!-- Each fact: its mark, its name, and the full sentence rather
                                     than the shortened cell the table used to carry. -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <ContentControl Grid.Row="0" Grid.Column="0"
                                                    Content="{Binding SiteState}"
                                                    Style="{StaticResource StateMark}"
                                                    VerticalAlignment="Top" Margin="0,3,8,0" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Site"
                                               Style="{StaticResource FieldLabel}" MinWidth="130" />
                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                               Text="{Binding SiteDetail}"
                                               Tag="{Binding SiteState}"
                                               Style="{StaticResource StateText}"
                                               TextWrapping="Wrap" />

                                    <ContentControl Grid.Row="1" Grid.Column="0"
                                                    Content="{Binding ConnectionState}"
                                                    Style="{StaticResource StateMark}"
                                                    VerticalAlignment="Top" Margin="0,3,8,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Connection"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2"
                                               Text="{Binding ConnectionDetail}"
                                               Tag="{Binding ConnectionState}"
                                               Style="{StaticResource StateText}"
                                               TextWrapping="Wrap" />

                                    <ContentControl Grid.Row="2" Grid.Column="0"
                                                    Content="{Binding ServesThePartitionState}"
                                                    Style="{StaticResource StateMark}"
                                                    VerticalAlignment="Top" Margin="0,3,8,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Serves it"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2"
                                               Text="{Binding ServesThePartitionDetail}"
                                               Tag="{Binding ServesThePartitionState}"
                                               Style="{StaticResource StateText}"
                                               TextWrapping="Wrap" />

                                    <ContentControl Grid.Row="3" Grid.Column="0"
                                                    Content="{Binding PasswordSettingsState}"
                                                    Style="{StaticResource StateMark}"
                                                    VerticalAlignment="Top" Margin="0,3,8,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Password settings"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Row="3" Grid.Column="2"
                                               Text="{Binding PasswordSettingsDetail}"
                                               Tag="{Binding PasswordSettingsState}"
                                               Style="{StaticResource StateText}"
                                               TextWrapping="Wrap" />

                                    <ContentControl Grid.Row="4" Grid.Column="0"
                                                    Content="{Binding PdcEmulatorState}"
                                                    Style="{StaticResource StateMark}"
                                                    VerticalAlignment="Top" Margin="0,3,8,0" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="PDC emulator"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Row="4" Grid.Column="2"
                                               Text="{Binding PdcEmulatorDetail}"
                                               Tag="{Binding PdcEmulatorState}"
                                               Style="{StaticResource StateText}"
                                               TextWrapping="Wrap" />
                                </Grid>

                                <!-- What this domain has to say that will not fit in a line. -->
                                <StackPanel Margin="0,8,0,0"
                                            Visibility="{Binding HasSomethingToSay, Converter={StaticResource Shown}}">
                                    <TextBlock Text="{Binding FailoverNote}"
                                               Style="{StaticResource StateText}" Tag="EstablishedBad"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ChoiceNote}"
                                               Style="{StaticResource StateText}" Tag="EstablishedBad"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding PdcEmulatorWarning}"
                                               Style="{StaticResource StateText}" Tag="EstablishedBad"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBox Text="{Binding Problem,Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                                         Foreground="{DynamicResource CriticalFindingBrush}" Margin="0,8,0,0"
                                         Visibility="{Binding HasProblem,Converter={StaticResource Shown}}" />
                                <ItemsControl ItemsSource="{Binding Faults}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <TextBox Text="{Binding Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                                                 Foreground="{DynamicResource FaultBrush}" Margin="0,6,0,0" />
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Exclusions}">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <StackPanel Margin="0,8,0,14">
                        <TextBlock Text="{Binding Domain}" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="{Binding Why}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Stated}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding AuthorisedBy}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding IsAttested,Converter={StaticResource Shown}}" />
                        <TextBox Text="{Binding Note,Mode=OneWay}" Style="{StaticResource SelectableMessage}" Margin="0,4,0,0"
                                 Visibility="{Binding HasNote,Converter={StaticResource Shown}}" />
                    </StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
