<UserControl x:Class="SecureAD.Shell.Views.ObjectSectionList" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Background="{StaticResource AttributeHeaderBackground}" Padding="16,12" CornerRadius="8,8,0,0">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Back to the listing"
                            Command="{Binding CloseObjectCommand}" Margin="12,0,0,0"
                            VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="{Binding Opened.Name}" Style="{StaticResource ScreenTitle}" />
                        <TextBlock Text="{Binding Opened.ObjectType}" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </DockPanel>
                <TextBox Text="{Binding Opened.DistinguishedName, Mode=OneWay}"
                         Style="{StaticResource SelectableMessage}"
                         FontFamily="{StaticResource IdentifierFontFamily}"
                         FontSize="{StaticResource CaptionFontSize}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
        <ListBox ItemsSource="{Binding Opened.Sections}"
                 SelectedValuePath="Key" SelectedValue="{Binding Opened.SelectedKey, Mode=TwoWay}"
                 BorderThickness="0" Background="{StaticResource AttributeHeaderBackground}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" MaxHeight="140"
                 HorizontalContentAlignment="Stretch" Margin="0,0,0,12"
                 AutomationProperties.Name="Object sections">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="10,7" />
                    <Setter Property="Foreground" Value="{StaticResource AttributeLabelBrush}" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Background" Value="{StaticResource SelectionBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>
