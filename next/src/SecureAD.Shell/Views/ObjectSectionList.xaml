<UserControl x:Class="SecureAD.Shell.Views.ObjectSectionList" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SecureAD.Shell.Controls">
    <StackPanel>
        <Border Background="{DynamicResource AttributeHeaderBackground}" Padding="10,8" CornerRadius="6,6,0,0">
            <StackPanel>
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Top">
                        <Button Content="Back to the listing" Command="{Binding CloseObjectCommand}" Margin="8,0,0,0" />
                        <Button Content="Locate in main window" Command="{Binding LocateObjectCommand}" Margin="8,0,0,0" />
                        <controls:CopyValueButton Content="Copy DN" Text="{Binding Opened.DistinguishedName}"
                                                  Style="{StaticResource BaseButton}" Margin="6,0,0,0" />
                    </WrapPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Opened.Heading}" Style="{StaticResource ScreenTitle}" />
                        <TextBox Text="{Binding Opened.DistinguishedName, Mode=OneWay}"
                                 Style="{StaticResource SelectableMessage}"
                                 FontFamily="{StaticResource IdentifierFontFamily}"
                                 FontSize="{StaticResource CaptionFontSize}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
        <ListBox ItemsSource="{Binding Opened.Sections}"
                 SelectedValuePath="Key" SelectedValue="{Binding Opened.SelectedKey, Mode=TwoWay}"
                 BorderThickness="0" Background="{DynamicResource AttributeHeaderBackground}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" MaxHeight="140"
                 HorizontalContentAlignment="Stretch" Margin="0,0,0,8"
                 AutomationProperties.Name="Object sections">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="8,5" />
                    <Setter Property="Foreground" Value="{DynamicResource AttributeLabelBrush}" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnAccentTextBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>
