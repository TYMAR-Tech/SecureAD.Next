<UserControl x:Class="SecureAD.Shell.Views.AssetsView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SecureAD.Shell.ViewModels"
             xmlns:views="clr-namespace:SecureAD.Shell.Views"
             Background="{DynamicResource AssetCanvasBackground}">
    <UserControl.Resources>

        <!-- A DataGridColumn is not in the visual tree and cannot find the view model by walking
             up to it. This carries the data context to the one column that needs it. -->
        <views:BindingProxy x:Key="Screen" Data="{Binding}" />

        <!-- One container in the tree. The colour is set on the TextBlock that DRAWS the name,
             never on anything holding it. -->
        <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TreeNodeIcon}"
                                Focusable="False" IsHitTestVisible="False" />
                <TextBlock x:Name="Label" Text="{Binding Name}"
                           Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock Text="not captured" Margin="8,0,0,0"
                           Foreground="{StaticResource NotEstablishedBrush}"
                           ToolTip="{Binding Detail}"
                           Visibility="{Binding HasDetail, Converter={StaticResource Shown}}" />
            </StackPanel>
            <HierarchicalDataTemplate.Triggers>
                <!-- Keyed on the FactState VALUE, not on its name as text. A trigger comparing a
                     string against the type matches nothing, every mark falls through to the
                     default, and the product tells an operator that a known fact is unknown. -->
                <DataTrigger Binding="{Binding State}" Value="NotEstablished">
                    <Setter TargetName="Label" Property="Foreground"
                            Value="{StaticResource NotEstablishedBrush}" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

    </UserControl.Resources>

    <DockPanel Margin="{StaticResource ScreenPadding}">

        <!-- NO SCREEN TITLE. The rail says Assets and the tab says which view, so a heading
             repeating the word a third time spent a line of vertical space on nothing. Removed on
             the owner's instruction, 2026-09-03. -->

        <!-- No run chosen is a question the operator has not answered, and is not a claim that
             the run captured nothing. -->
        <TextBlock DockPanel.Dock="Top"
                   Text="Choose a run on the Runs screen to see what it captured."
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Margin="0,0,0,8"
                   Visibility="{Binding HasNoRun, Converter={StaticResource Shown}}" />

        <!-- A refusal, stated on the surface in the product's own colours rather than in a
             MessageBox nothing can theme. Selectable, because a failure an operator cannot copy
             is a failure they cannot report. -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8"
                    Visibility="{Binding HasRefusal, Converter={StaticResource Shown}}">
            <TextBlock Text="{Binding Refusal.Title}" Style="{StaticResource RowTitle}" />
            <TextBox Text="{Binding Refusal.Detail, Mode=OneWay}"
                     Style="{StaticResource SelectableMessage}"
                     Foreground="{StaticResource FaultBrush}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding LoadingText}"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Visibility="{Binding IsOpeningTree, Converter={StaticResource Shown}}" />

        <Grid Visibility="{Binding HasTree, Converter={StaticResource Shown}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="270" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <GridSplitter Grid.Column="1" Grid.RowSpan="2" Width="6" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                          Background="{StaticResource AttributeCardBorderBrush}"
                          AutomationProperties.Name="Resize directory pane"
                          Visibility="{Binding ShowsDirectoryTree, Converter={StaticResource Shown}}" />

            <TextBlock Grid.Column="2" Text="{Binding LoadingText}"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Visibility="{Binding ShowsOtherViewLoading, Converter={StaticResource Shown}}" />

            <StackPanel Grid.Column="2"
                        Visibility="{Binding HasOtherViewRefusal, Converter={StaticResource Shown}}">
                <TextBlock Text="{Binding ViewRefusal.Title}" Style="{StaticResource RowTitle}" />
                <TextBox Text="{Binding ViewRefusal.Detail, Mode=OneWay}"
                         Style="{StaticResource SelectableMessage}"
                         Foreground="{StaticResource FaultBrush}" />
            </StackPanel>

            <Border Grid.Column="0" Grid.RowSpan="2" Background="{StaticResource AssetNavigationBackground}"
                    BorderBrush="{StaticResource AttributeCardBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12"
                    Visibility="{Binding ShowsDirectoryTree, Converter={StaticResource Shown}}">
            <Grid Grid.Column="0"
                  Visibility="{Binding ShowsDirectoryTree, Converter={StaticResource Shown}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8" Background="{StaticResource AttributeHeaderBackground}">
                    <Button Content="Entire captured forest - Groups" Command="{Binding BrowseAllGroupsCommand}"
                            Margin="0,0,0,10" Visibility="{Binding ShowsGroups,Converter={StaticResource Shown}}" />
                    <TextBlock Text="{x:Static vm:ObjectNavigationText.SearchLabel}" Style="{StaticResource BlockLabel}" />
                    <TextBox Text="{Binding ObjectSearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{x:Static vm:ObjectNavigationText.SearchHint}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchObjectsCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="{x:Static vm:ObjectNavigationText.SearchAction}" Command="{Binding SearchObjectsCommand}" Margin="0,0,8,0" />
                        <Button Content="{x:Static vm:ObjectNavigationText.ClearSearch}" Command="{Binding ClearObjectSearchCommand}" />
                    </WrapPanel>
                </StackPanel>

            <TreeView Grid.Row="1" ItemsSource="{Binding Roots}"
                      Background="{StaticResource AssetNavigationBackground}">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem"
                           BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <!-- Collapsed on arrival; the operator drills to what he wants. -->
                        <Setter Property="IsExpanded" Value="False" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

                <!-- THE LEVEL BELONGS TO THE TREE, NOT TO ONE GRID. It sits under the tree it
                     qualifies and governs whichever view is showing, so an operator narrowing to an
                     organisational unit during a LAPS rollout does not have to cross to the objects
                     tab to change it and come back. Until 2026-09-03 it lived in the object listing
                     and that is exactly what it cost.

                     THE WORDS ARE THE DIRECTORY'S OWN. Base, one level and subtree are what an
                     administrator types into every search he runs. Equal-width segments must fit
                     even at the divider's minimum width; the old horizontal pills clipped Subtree. -->
                <StackPanel Grid.Row="2" Margin="0,12,0,0" IsEnabled="{Binding CanChangeBrowsingScope}">
                    <TextBlock Text="Browsing Scope" Style="{StaticResource BlockLabel}"
                               FontSize="{StaticResource CaptionFontSize}"
                               Foreground="{StaticResource AttributeLabelBrush}" />
                    <Border BorderBrush="{StaticResource AttributeCardBorderBrush}" BorderThickness="1"
                            Background="{StaticResource SurfaceRaisedBackground}" CornerRadius="4"
                            Padding="1" Margin="0,6,0,0">
                        <UniformGrid Rows="1" x:Name="ScopeSelector">
                            <RadioButton Style="{StaticResource BrowsingScopeSegment}" Content="Base" GroupName="Scope"
                                         IsChecked="{Binding ShowsBase, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource BrowsingScopeSegment}" Content="One level" GroupName="Scope"
                                         IsChecked="{Binding ShowsOneLevel, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource BrowsingScopeSegment}" Content="Subtree" GroupName="Scope"
                                         IsChecked="{Binding ShowsSubtree, Mode=TwoWay}" />
                        </UniformGrid>
                    </Border>
                </StackPanel>

                <!-- Where you are, said once beside the tree rather than once per view. -->
                <TextBlock Grid.Row="3"
                           Text="{Binding NavigationLocation}"
                           Style="{StaticResource Identifier}"
                           FontSize="{StaticResource CaptionFontSize}" FontWeight="Normal"
                           Foreground="{StaticResource AttributeSourceBrush}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />
            </Grid>
            </Border>

            <DockPanel Grid.Column="2" Visibility="{Binding ShowsObjectListing, Converter={StaticResource Shown}}">

                <TextBlock DockPanel.Dock="Top" Text="{Binding ObjectSearchHeading}" Style="{StaticResource RowTitle}"
                           Margin="0,0,0,6" Visibility="{Binding IsObjectSearch, Converter={StaticResource Shown}}" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding ObjectSearchEmpty}" TextWrapping="Wrap"
                           Margin="0,0,0,6" Visibility="{Binding HasEmptyObjectSearch, Converter={StaticResource Shown}}" />

                <!-- A gesture nothing announces is a gesture nobody finds. -->
                <TextBlock DockPanel.Dock="Top"
                           Text="Double-click a row to open an object"
                           VerticalAlignment="Center"
                           Margin="0,0,0,8"
                           Foreground="{StaticResource SecondaryTextBrush}" />

                <!-- A listing short by an unknown number of objects is not an empty container,
                     and the difference is stated where the objects would be. -->
                <TextBox DockPanel.Dock="Top"
                         Text="{Binding Shortfall, Mode=OneWay}"
                         Style="{StaticResource SelectableMessage}"
                         Foreground="{StaticResource FaultBrush}"
                         Margin="0,0,0,8"
                         Visibility="{Binding IsShort, Converter={StaticResource Shown}}" />

                <!-- Said only when the container was read and genuinely held nothing. -->
                <TextBlock DockPanel.Dock="Top"
                           Text="Nothing was captured here."
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="0,0,0,8"
                           Visibility="{Binding IsEmpty, Converter={StaticResource Shown}}" />

                <DataGrid ItemsSource="{Binding Objects}"
                          ColumnHeaderStyle="{StaticResource TableColumnHeader}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          IsSynchronizedWithCurrentItem="True">

                    <!-- THE WAY IN IS THE ROW ITSELF. A button in a column asked an operator to
                         aim at a control to open the thing he had already picked. This is a
                         MouseBinding rather than a handler because logic behind a view is logic
                         ShellMvvmGateTests fails the build for. -->
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                                      Command="{Binding OpenObjectCommand}"
                                      CommandParameter="{Binding Objects/}" />
                    </DataGrid.InputBindings>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Object Type" Binding="{Binding ObjectType}"
                                            Width="Auto" />
                        <DataGridTextColumn Header="{x:Static vm:ObjectNavigationText.Domain}" Binding="{Binding Domain}" Width="*"
                                            Visibility="{Binding Data.IsObjectSearch, Source={StaticResource Screen}, Converter={StaticResource Shown}}" />
                        <DataGridTextColumn Header="{x:Static vm:ObjectNavigationText.Location}" Binding="{Binding Location}" Width="2*"
                                            Visibility="{Binding Data.IsObjectSearch, Source={StaticResource Screen}, Converter={StaticResource Shown}}" />

                        <!-- Earns its place only when rows come from different containers. Below
                             that it repeats the container just selected on every row, which is
                             what the predecessor's grid did on all 28 of them. -->
                        <DataGridTextColumn Header="In" Binding="{Binding Parent}" Width="*"
                                            Visibility="{Binding Data.ParentIsWorthShowing,
                                                         Source={StaticResource Screen},
                                                         Converter={StaticResource Shown}}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- What the rules found in the selected container. Beside the objects rather than
                 instead of them: the tree stays, because an operator reading a finding is
                 somewhere in the directory and will look at the object next. -->
            <views:FindingsView Grid.Column="2"
                                Visibility="{Binding ShowsFindingsListing, Converter={StaticResource Shown}}" />
            <views:GroupsView Grid.Column="2"
                              Visibility="{Binding ShowsGroupsSurface, Converter={StaticResource Shown}}" />
            <views:Tier0OverviewView Grid.ColumnSpan="3"
                                    Visibility="{Binding ShowsTier0Listing, Converter={StaticResource Shown}}" />

            <!-- Which machines are managing their local administrator password, and by what.
                 Beside the objects for the same reason the findings are: an operator narrowing to
                 an organisational unit during a rollout keeps the tree while he does it. -->
            <views:LapsInventoryView Grid.Column="2"
                                     Visibility="{Binding ShowsLapsListing, Converter={StaticResource Shown}}" />

            <views:DelegationsView Grid.ColumnSpan="3"
                                   Visibility="{Binding ShowsDelegationsListing, Converter={StaticResource Shown}}" />

            <views:ObjectView Visibility="{Binding HasOpenObject, Converter={StaticResource Shown}}">
                <views:ObjectView.Style>
                    <Style TargetType="views:ObjectView">
                        <Setter Property="Grid.Column" Value="2" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowsTier0}" Value="True">
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="3" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:ObjectView.Style>
            </views:ObjectView>

            <Grid Grid.Column="2" Grid.Row="1" Margin="0,8,0,0" x:Name="AssetsFooter">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <views:CaptureCoverageView Grid.Row="0"
                    Visibility="{Binding ShowsCaptureCoverageDetails, Converter={StaticResource Shown}}" />
                <ItemsControl Grid.Row="1" ItemsPanel="{StaticResource AssetFooterColumns}">
                    <WrapPanel VerticalAlignment="Center"
                               Visibility="{Binding ShowsObjectListing, Converter={StaticResource Shown}}">
                        <TextBlock Text="{Binding PageDescription}" TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="Previous" Command="{Binding PreviousPageCommand}"
                                IsEnabled="{Binding HasPreviousPage}" Margin="0,0,8,0" />
                        <Button Content="Next" Command="{Binding NextPageCommand}"
                                IsEnabled="{Binding HasNextPage}" />
                    </WrapPanel>
                    <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center" x:Name="CaptureCoverageSummary">
                        <TextBlock Text="{x:Static vm:ObjectNavigationText.Coverage}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Static vm:ObjectNavigationText.CaptureIncomplete}" VerticalAlignment="Center"
                                   Margin="0,0,12,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource FaultBrush}"
                                   Visibility="{Binding HasCaptureGaps, Converter={StaticResource Shown}}" />
                        <Button Content="{Binding CaptureCoverageAction}" Command="{Binding ToggleCaptureCoverageCommand}" />
                    </WrapPanel>
                </ItemsControl>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
