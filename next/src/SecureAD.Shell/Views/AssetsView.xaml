<UserControl x:Class="SecureAD.Shell.Views.AssetsView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SecureAD.Shell.ViewModels"
             xmlns:views="clr-namespace:SecureAD.Shell.Views">
    <UserControl.Resources>

        <!-- A DataGridColumn is not in the visual tree and cannot find the view model by walking
             up to it. This carries the data context to the one column that needs it. -->
        <views:BindingProxy x:Key="Screen" Data="{Binding}" />

        <!-- One container in the tree. The colour is set on the TextBlock that DRAWS the name,
             never on anything holding it. -->
        <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock x:Name="Label" Text="{Binding Name}"
                           Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock Text="not captured" Margin="8,0,0,0"
                           Foreground="{StaticResource NotEstablishedBrush}"
                           ToolTip="{Binding Detail}"
                           Visibility="{Binding HasDetail, Converter={StaticResource Shown}}" />
            </StackPanel>
            <HierarchicalDataTemplate.Triggers>
                <!-- Keyed on the FactState VALUE, not on its name as text. A trigger comparing a
                     string against the type matches nothing, every mark falls through to the
                     default, and the product tells an operator that a known fact is unknown. -->
                <DataTrigger Binding="{Binding State}" Value="NotEstablished">
                    <Setter TargetName="Label" Property="Foreground"
                            Value="{StaticResource NotEstablishedBrush}" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

    </UserControl.Resources>

    <DockPanel Margin="{StaticResource ScreenPadding}">
        <TextBlock DockPanel.Dock="Top" Text="Assets"
                   Style="{StaticResource ScreenTitle}" Margin="0,0,0,12" />

        <!-- No run chosen is a question the operator has not answered, and is not a claim that
             the run captured nothing. -->
        <TextBlock DockPanel.Dock="Top"
                   Text="Choose a run on the Runs screen to see what it captured."
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Margin="0,0,0,8"
                   Visibility="{Binding HasNoRun, Converter={StaticResource Shown}}" />

        <!-- A refusal, stated on the surface in the product's own colours rather than in a
             MessageBox nothing can theme. Selectable, because a failure an operator cannot copy
             is a failure they cannot report. -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8"
                    Visibility="{Binding HasRefusal, Converter={StaticResource Shown}}">
            <TextBlock Text="{Binding Refusal.Title}" Style="{StaticResource RowTitle}" />
            <TextBox Text="{Binding Refusal.Detail, Mode=OneWay}"
                     Style="{StaticResource SelectableMessage}"
                     Foreground="{StaticResource FaultBrush}" />
        </StackPanel>

        <Grid Visibility="{Binding HasTree, Converter={StaticResource Shown}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- THE LEFT COLUMN HOLDS THE TREE WHILE LISTING AND THE OBJECT'S SECTIONS WHILE
                 READING ONE. Same geometry either way, so nothing reflows and the content half
                 stays full width. -->
            <Grid Grid.Column="0"
                  Visibility="{Binding ShowsListing, Converter={StaticResource Shown}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <TreeView Grid.Row="0" ItemsSource="{Binding Roots}"
                     >
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem"
                           BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <!-- Collapsed on arrival; the operator drills to what he wants. -->
                        <Setter Property="IsExpanded" Value="False" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

                <views:GapsCard Grid.Row="1" />
            </Grid>

            <DockPanel Grid.Column="2" Visibility="{Binding ShowsObjectListing, Converter={StaticResource Shown}}">

                <!-- Where you are, said once here rather than repeated on every row of the grid. -->
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding Selected.DistinguishedName}"
                           Style="{StaticResource Identifier}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,8" />

                <!-- The three scopes the directory itself defines, under the names an
                     administrator already uses. -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Show" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <RadioButton Style="{StaticResource ChoiceButton}" Content="This object" GroupName="Scope" Margin="0,0,16,0"
                                 IsChecked="{Binding ShowsThisObject, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource ChoiceButton}" Content="One level" GroupName="Scope" Margin="0,0,16,0"
                                 IsChecked="{Binding ShowsOneLevel, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource ChoiceButton}" Content="Everything beneath" GroupName="Scope"
                                 IsChecked="{Binding ShowsEverythingBeneath, Mode=TwoWay}" />

                    <!-- A gesture nothing announces is a gesture nobody finds. -->
                    <TextBlock Text="Double-click a row to open an object" Margin="24,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <!-- The pager. Says which objects of how many, so a page can never be mistaken
                     for the whole listing. -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="{Binding PageDescription}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="Previous" Command="{Binding PreviousPageCommand}"
                            IsEnabled="{Binding HasPreviousPage}" Margin="0,0,8,0" />
                    <Button Content="Next" Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding HasNextPage}" />
                </StackPanel>

                <!-- A listing short by an unknown number of objects is not an empty container,
                     and the difference is stated where the objects would be. -->
                <TextBox DockPanel.Dock="Top"
                         Text="{Binding Shortfall, Mode=OneWay}"
                         Style="{StaticResource SelectableMessage}"
                         Foreground="{StaticResource FaultBrush}"
                         Margin="0,0,0,8"
                         Visibility="{Binding IsShort, Converter={StaticResource Shown}}" />

                <!-- Said only when the container was read and genuinely held nothing. -->
                <TextBlock DockPanel.Dock="Top"
                           Text="Nothing was captured here."
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="0,0,0,8"
                           Visibility="{Binding IsEmpty, Converter={StaticResource Shown}}" />

                <DataGrid ItemsSource="{Binding Objects}"
                          ColumnHeaderStyle="{StaticResource TableColumnHeader}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          IsSynchronizedWithCurrentItem="True">

                    <!-- THE WAY IN IS THE ROW ITSELF. A button in a column asked an operator to
                         aim at a control to open the thing he had already picked. This is a
                         MouseBinding rather than a handler because logic behind a view is logic
                         ShellMvvmGateTests fails the build for. -->
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                                      Command="{Binding OpenObjectCommand}"
                                      CommandParameter="{Binding Objects/}" />
                    </DataGrid.InputBindings>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Object Type" Binding="{Binding ObjectType}"
                                            Width="Auto" />

                        <!-- Earns its place only when rows come from different containers. Below
                             that it repeats the container just selected on every row, which is
                             what the predecessor's grid did on all 28 of them. -->
                        <DataGridTextColumn Header="In" Binding="{Binding Parent}" Width="*"
                                            Visibility="{Binding Data.ParentIsWorthShowing,
                                                         Source={StaticResource Screen},
                                                         Converter={StaticResource Shown}}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- What the rules found in the selected container. Beside the objects rather than
                 instead of them: the tree stays, because an operator reading a finding is
                 somewhere in the directory and will look at the object next. -->
            <views:FindingsView Grid.Column="2"
                                Visibility="{Binding ShowsFindingsListing, Converter={StaticResource Shown}}" />

            <!-- One object, opened from a row. It replaces the listing and the tree stays: an
                 operator reading one object is still somewhere in the directory. -->
            <views:ObjectSectionList Grid.Column="0"
                                     Visibility="{Binding HasOpenObject, Converter={StaticResource Shown}}" />

            <views:ObjectView Grid.Column="2"
                              Visibility="{Binding HasOpenObject, Converter={StaticResource Shown}}" />
        </Grid>
    </DockPanel>
</UserControl>
