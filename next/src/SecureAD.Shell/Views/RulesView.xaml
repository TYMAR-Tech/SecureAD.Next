<UserControl x:Class="SecureAD.Shell.Views.RulesView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AssetCanvasBackground}">
    <UserControl.Resources>
        <DataTemplate x:Key="SelectedRuleDetails">
            <Border Style="{StaticResource RuleCard}" Margin="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource AttributeHeaderBackground}" Padding="16,12" CornerRadius="7,7,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Rule}" Style="{StaticResource RuleLabel}" />
                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,8,0,0">
                                <TextBlock Text="{Binding Severity, StringFormat=Severity: {0}}" Style="{StaticResource Caption}" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding Category}" Style="{StaticResource Caption}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource AttributeCardBorderBrush}" BorderThickness="0,1,0,1" Padding="16,10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="This run" Style="{StaticResource Caption}" Margin="0,0,10,0" />
                            <ContentControl DockPanel.Dock="Left" Style="{StaticResource StateMark}" Content="{Binding State}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Outcome}" Style="{StaticResource StateText}" Tag="{Binding State}" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Bottom" Text="Severity classifies a finding; the saved execution outcome is a separate fact. Guidance is not new analysis of this run."
                               Style="{StaticResource Caption}" Margin="16,8" />
                    <ScrollViewer x:Name="RuleExplanationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16" MaxWidth="1100" HorizontalAlignment="Stretch">
                            <TextBlock Text="Looks for" Style="{StaticResource RuleLabel}" />
                            <TextBox Text="{Binding LooksFor, Mode=OneWay}" Style="{StaticResource RuleText}" />
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Evidence used" Style="{StaticResource RuleLabel}" />
                                    <TextBox Text="{Binding DeclaredEvidence, Mode=OneWay}" Style="{StaticResource RuleText}" Margin="0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource AttributeHeaderBackground}" BorderBrush="{StaticResource AttributeSourceBrush}"
                                    BorderThickness="3,0,0,0" Padding="12"
                                    Visibility="{Binding HasScopeNotes, Converter={StaticResource Shown}}">
                                <StackPanel>
                                    <TextBlock Text="Scope and limitations" Style="{StaticResource RuleLabel}" />
                                    <ItemsControl ItemsSource="{Binding ScopeNotes}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock DockPanel.Dock="Left" Text="•" Margin="0,0,8,0" Foreground="{StaticResource AttributeLabelBrush}" />
                                                <TextBox Text="{Binding Mode=OneWay}" Style="{StaticResource SelectableMessage}" Foreground="{StaticResource AttributeLabelBrush}" />
                                            </DockPanel>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="0,14,0,0" Visibility="{Binding HasMicrosoftReference, Converter={StaticResource Shown}}">
                                <TextBlock Text="Microsoft reference" Style="{StaticResource RuleLabel}" />
                                <TextBox Text="{Binding MicrosoftReference, Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                                         Foreground="{StaticResource FocusBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel Margin="{StaticResource ScreenPadding}">
        <Border DockPanel.Dock="Top" Style="{StaticResource RuleCard}" Background="{StaticResource AttributeHeaderBackground}" Padding="14">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding RunName}" Style="{StaticResource RowTitle}" Margin="18,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="Rules and their results" Style="{StaticResource ScreenTitle}" />
                </DockPanel>
                <TextBox Text="{Binding BundlePath, Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                         FontFamily="{StaticResource IdentifierFontFamily}" FontSize="{StaticResource CaptionFontSize}" Margin="0,6,0,0" />
                <TextBlock Text="Whole captured forest. Saved rule outcomes for this run, not a selected directory container."
                           Style="{StaticResource Caption}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
        <TextBlock DockPanel.Dock="Top" Text="Choose a run on Home to see its saved rule results." Style="{StaticResource Caption}"
                   Visibility="{Binding HasNoRun, Converter={StaticResource Shown}}" />
        <TextBlock DockPanel.Dock="Top" Text="Loading saved results..." Style="{StaticResource Caption}"
                   Visibility="{Binding IsLoading, Converter={StaticResource Shown}}" />
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12"
                Visibility="{Binding HasRulesRefusal, Converter={StaticResource Shown}}">
            <StackPanel>
                <TextBlock Text="{Binding RulesRefusal.Title}" Style="{StaticResource RowTitle}" />
                <TextBox Text="{Binding RulesRefusal.Detail, Mode=OneWay}" Style="{StaticResource SelectableMessage}" Foreground="{StaticResource FaultBrush}" />
            </StackPanel>
        </Border>
        <Grid Visibility="{Binding HasResults, Converter={StaticResource Shown}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="260" MaxWidth="600" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource RuleCard}" Margin="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource ObjectSectionHeadingBackground}" Padding="12,10" CornerRadius="7,7,0,0">
                        <TextBlock Text="Rules" Style="{StaticResource RowTitle}" />
                    </Border>
                    <TextBlock DockPanel.Dock="Bottom" Text="Select a rule to read its explanation. Drag the divider to adjust the widths."
                               Style="{StaticResource Caption}" Margin="12,8" />
                    <ListBox x:Name="RulesList" ItemsSource="{Binding RuleRows}" SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource RuleListItem}" Background="Transparent" BorderThickness="0" Padding="6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Rules and saved outcomes">
                        <ListBox.ItemTemplate><DataTemplate>
                            <StackPanel>
                                <WrapPanel>
                                    <TextBlock Text="{Binding Rule}" Style="{StaticResource RuleLabel}" Margin="0,0,12,4" />
                                    <TextBlock Text="{Binding Category}" Style="{StaticResource Caption}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <DockPanel>
                                    <ContentControl DockPanel.Dock="Left" Style="{StaticResource StateMark}" Content="{Binding State}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Outcome}" Style="{StaticResource StateText}" Tag="{Binding State}" TextWrapping="Wrap" />
                                </DockPanel>
                                <TextBlock Text="{Binding Severity, StringFormat=Severity: {0}}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                            </StackPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                          Background="{StaticResource AttributeCardBorderBrush}" AutomationProperties.Name="Resize rules list" />
            <ContentControl Grid.Column="2" x:Name="RuleDetail" Content="{Binding SelectedRule}" ContentTemplate="{StaticResource SelectedRuleDetails}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
    </DockPanel>
</UserControl>
