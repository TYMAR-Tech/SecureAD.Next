<UserControl x:Class="SecureAD.Shell.Views.RulesView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel>

        <!-- WHY A REFUSAL IS A SENTENCE RATHER THAN A LIST OF RULES SAYING THEY DID NOT RUN. "Nobody
             judged this bundle" and "this bundle's judgement will not open" call for different
             actions, and a silent list of not-run rules states the first while the second is
             true. -->
        <Border DockPanel.Dock="Top"
                Style="{StaticResource Card}"
                Margin="0,0,0,8"
                Visibility="{Binding HasRulesRefusal, Converter={StaticResource Shown}}">
            <StackPanel>
                <TextBlock Text="{Binding RulesRefusal.Title}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <TextBox Text="{Binding RulesRefusal.Detail, Mode=OneWay}"
                         Style="{StaticResource SelectableMessage}"
                         Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>

        <!-- THIS SCREEN IS NOT SCOPED BY THE TREE, and says so. A rule is a question asked of the
             whole forest, so "judged 2,082 objects" is a count of the run rather than of whichever
             container is selected - and an operator who assumed otherwise would read every number
             here as smaller than it is. -->
        <TextBlock DockPanel.Dock="Top"
                   Text="Every check this product makes, and what each one did to this run. These cover the whole forest, not the container selected in the tree."
                   TextWrapping="Wrap"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Margin="0,0,0,8" />

        <!-- A ROW PER RULE RATHER THAN A GRID OF CELLS. What a rule looks for is two or three
             sentences, and a table column would truncate it to the width of a screen - which is how
             the same words came to be reachable only by selecting a finding. -->
        <!-- A ROW PER RULE, WITH THE PARAGRAPH FOLDED AWAY. Eleven descriptions expanded at once is
             a wall of text nobody scans, and it buried the line an operator came here to read.
             What stays on screen is the identity of the rule and what it did; what it looks for is
             one click away, per rule. Seen 2026-09-03: at eleven rules the screen already needed
             scrolling to reach the third, and there are sixty-two specified. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding RuleRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- The mark carries what the run established, and it is
                                         deliberately not the severity: a rule that found something
                                         did its job, and the forest is what is wrong. Fault is kept
                                         for the rule itself failing. -->
                                    <ContentControl Grid.Column="0"
                                                    Style="{StaticResource StateMark}"
                                                    Content="{Binding State}"
                                                    Margin="0,0,8,0" />

                                    <TextBlock Grid.Column="1" Text="{Binding Rule}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />

                                    <TextBlock Grid.Column="2" Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,12,0" />

                                    <!-- Severity and category are pushed right rather than left
                                         against the name, so they line up down the list and can be
                                         read as columns instead of hunted for in each row. -->
                                    <TextBlock Grid.Column="3" Text="{Binding Severity}"
                                               Style="{StaticResource BlockLabel}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0" />

                                    <TextBlock Grid.Column="4" Text="{Binding Category}"
                                               Style="{StaticResource BlockLabel}"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <!-- The sentence rather than a count, because four different things
                                     produce no findings and only one of them is a statement about
                                     the forest. It stays on screen while the description folds
                                     away: it is what changes between runs, and the description is
                                     not. Weight and colour come from the same state as the mark,
                                     so a rule that could not run recedes rather than reading as a
                                     clean answer. -->
                                <TextBlock Text="{Binding Outcome}"
                                           Style="{StaticResource StateText}"
                                           Tag="{Binding State}"
                                           TextWrapping="Wrap"
                                           Margin="24,6,0,0" />

                                <Expander Header="What this rule looks for"
                                          Margin="24,6,0,0"
                                          Foreground="{StaticResource SecondaryTextBrush}">
                                    <TextBlock Text="{Binding About}"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,4,0,4" />
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
