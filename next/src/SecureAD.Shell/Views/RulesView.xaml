<UserControl x:Class="SecureAD.Shell.Views.RulesView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AssetCanvasBackground}">
    <UserControl.Resources>
        <DataTemplate x:Key="SelectedRuleDetails">
            <Border Style="{StaticResource RuleCard}" Margin="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource AttributeHeaderBackground}" Padding="16,12" CornerRadius="7,7,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Rule}" Style="{StaticResource RuleLabel}" />
                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,8,0,0">
                                <TextBlock Text="{Binding Severity, StringFormat=Severity: {0}}" Style="{StaticResource Caption}" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding Category}" Style="{StaticResource Caption}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource AttributeCardBorderBrush}" BorderThickness="0,1,0,1" Padding="16,10">
                        <WrapPanel>
                            <ContentControl Style="{StaticResource StateMark}" Content="{Binding State}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Assessment}" Style="{StaticResource StateText}" Tag="{Binding State}" Margin="0,0,16,0" />
                            <TextBlock Text="{Binding FindingSummary}" FontWeight="SemiBold" Margin="0,0,16,0" />
                            <TextBlock Text="{Binding Judged,StringFormat={}{0:N0} objects judged}" Style="{StaticResource Caption}" />
                        </WrapPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Bottom" Text="Severity classifies a finding; the saved execution outcome is a separate fact. Guidance is not new analysis of this run."
                               Style="{StaticResource Caption}" Margin="16,8" />
                    <ScrollViewer x:Name="RuleExplanationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TabControl Margin="12">
                            <TabItem Header="Summary">
                                <StackPanel>
                                    <TextBlock Text="What this rule detects" Style="{StaticResource RuleLabel}" />
                                    <TextBox Text="{Binding LooksFor,Mode=OneWay}" Style="{StaticResource RuleText}" />
                                    <TextBlock Text="Why it matters" Style="{StaticResource RuleLabel}" />
                                    <TextBox Text="{Binding WhyItMatters,Mode=OneWay}" Style="{StaticResource RuleText}" />
                                    <TextBlock Text="What to do" Style="{StaticResource RuleLabel}" />
                                    <TextBox Text="{Binding WhatToDo,Mode=OneWay}" Style="{StaticResource RuleText}" />
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Evidence used">
                                <StackPanel>
                                    <TextBlock Text="Evidence used" Style="{StaticResource RuleLabel}" />
                                    <TextBox Text="{Binding DeclaredEvidence,Mode=OneWay}" Style="{StaticResource RuleText}" />
                                    <TextBox Text="{Binding Outcome,Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                                             Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Scope &amp; limitations">
                                <StackPanel Visibility="{Binding HasScopeNotes,Converter={StaticResource Shown}}">
                                    <TextBlock Text="Scope and limitations" Style="{StaticResource RuleLabel}" />
                                    <ItemsControl ItemsSource="{Binding ScopeNotes}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock DockPanel.Dock="Left" Text="•" Margin="0,0,8,0" Foreground="{DynamicResource AttributeLabelBrush}" />
                                                <TextBox Text="{Binding Mode=OneWay}" Style="{StaticResource SelectableMessage}" Foreground="{DynamicResource AttributeLabelBrush}" />
                                            </DockPanel>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Reference">
                                <StackPanel>
                                    <TextBlock Text="Microsoft reference" Style="{StaticResource RuleLabel}" />
                                    <TextBox Text="{Binding MicrosoftReference,Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                                             Foreground="{DynamicResource FocusBrush}"
                                             Visibility="{Binding HasMicrosoftReference,Converter={StaticResource Shown}}" />
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel Margin="{StaticResource ScreenPadding}">
        <TextBlock DockPanel.Dock="Top" Text="Choose a run on Home to see its saved rule results." Style="{StaticResource Caption}"
                   Visibility="{Binding HasNoRun, Converter={StaticResource Shown}}" />
        <TextBlock DockPanel.Dock="Top" Text="Loading saved results..." Style="{StaticResource Caption}"
                   Visibility="{Binding IsLoading, Converter={StaticResource Shown}}" />
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12"
                Visibility="{Binding HasRulesRefusal, Converter={StaticResource Shown}}">
            <StackPanel>
                <TextBlock Text="{Binding RulesRefusal.Title}" Style="{StaticResource RowTitle}" />
                <TextBox Text="{Binding RulesRefusal.Detail, Mode=OneWay}" Style="{StaticResource SelectableMessage}" Foreground="{DynamicResource FaultBrush}" />
            </StackPanel>
        </Border>
        <Grid Visibility="{Binding HasResults, Converter={StaticResource Shown}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="560" MinWidth="420" MaxWidth="760" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource RuleCard}" Margin="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource ObjectSectionHeadingBackground}" Padding="12,10" CornerRadius="7,7,0,0">
                        <TextBlock Text="Rule results" Style="{StaticResource RowTitle}" />
                    </Border>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource AttributeHeaderBackground}" Padding="10">
                        <WrapPanel>
                            <TextBox Width="230" Text="{Binding RuleSearchText,UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search rule identifier, name or category" Margin="0,0,8,0" />
                            <ComboBox Width="120" ItemsSource="{Binding RuleAssessmentChoices}"
                                      SelectedItem="{Binding RuleAssessmentFilter}" Margin="0,0,8,0" />
                            <ComboBox Width="110" ItemsSource="{Binding RuleSeverityChoices}"
                                      SelectedItem="{Binding RuleSeverityFilter}" />
                        </WrapPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Bottom" Text="Zero reported does not mean the assessment completed; read the separate saved status."
                               Style="{StaticResource Caption}" Margin="12,8" />
                    <DataGrid x:Name="RulesTable" ItemsSource="{Binding VisibleRuleRows}"
                              SelectedItem="{Binding SelectedRule,Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" SelectionMode="Single"
                              AutomationProperties.Name="Rules and saved outcomes">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Rule" Width="3*" MinWidth="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2">
                                            <TextBlock Text="{Binding Rule}" Style="{StaticResource RuleLabel}" />
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="Auto" MinWidth="80" />
                            <DataGridTemplateColumn Header="Assessment" Width="*" MinWidth="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <ContentControl DockPanel.Dock="Left" Style="{StaticResource StateMark}"
                                                            Content="{Binding State}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Assessment}" Style="{StaticResource StateText}"
                                                       Tag="{Binding State}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Reported" Binding="{Binding Findings}" Width="Auto" MinWidth="75" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                          Background="{DynamicResource AttributeCardBorderBrush}" AutomationProperties.Name="Resize rules list" />
            <ContentControl Grid.Column="2" x:Name="RuleDetail" Content="{Binding SelectedRule}" ContentTemplate="{StaticResource SelectedRuleDetails}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
    </DockPanel>
</UserControl>
