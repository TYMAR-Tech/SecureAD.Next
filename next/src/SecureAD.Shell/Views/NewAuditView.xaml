<UserControl x:Class="SecureAD.Shell.Views.NewAuditView" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SecureAD.Shell.ViewModels"
        xmlns:capture="clr-namespace:SecureAD.Kernel.Capture;assembly=SecureAD.Kernel"
        xmlns:views="clr-namespace:SecureAD.Shell.Views"
        Background="{DynamicResource AssetCanvasBackground}">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:DomainDetailsViewModel}">
            <views:DomainDetailsView />
        </DataTemplate>
        <Style x:Key="WizardCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AssetNavigationBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AttributeCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="WizardText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="WizardHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource TableColumnHeader}">
            <Setter Property="Background" Value="{DynamicResource AttributeHeaderBackground}" />
            <Setter Property="ContentTemplate">
                <Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource AttributeLabelBrush}" TextWrapping="Wrap" /></DataTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ReadinessAction" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="170" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Foreground" Value="{DynamicResource NotEstablishedBrush}" />
            <Setter Property="Background" Value="{DynamicResource NotEstablishedSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NotEstablishedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ReadinessStatus}" Value="{x:Static vm:AuditReadinessStatus.Ready}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ReadinessStatus}" Value="{x:Static vm:AuditReadinessStatus.Review}">
                    <Setter Property="Foreground" Value="{DynamicResource FaultBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource FaultBrush}" />
                    <Setter Property="Background" Value="{DynamicResource FaultSubtleBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ReadinessStatus}" Value="{x:Static vm:AuditReadinessStatus.ExclusionNeedsAuthorization}">
                    <Setter Property="Foreground" Value="{DynamicResource FaultBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource FaultBrush}" />
                    <Setter Property="Background" Value="{DynamicResource FaultSubtleBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ReadinessStatus}" Value="{x:Static vm:AuditReadinessStatus.Blocked}">
                    <Setter Property="Foreground" Value="{DynamicResource CriticalFindingBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CriticalFindingBrush}" />
                    <Setter Property="Background" Value="{DynamicResource CriticalFindingSubtleBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProgressStep" TargetType="Border" BasedOn="{StaticResource WizardCard}">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="{x:Static vm:AuditOutputState.Active}">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProgressMark" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlock}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="{x:Static vm:AuditOutputState.Active}"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Trigger>
                <Trigger Property="Tag" Value="{x:Static vm:AuditOutputState.Saved}"><Setter Property="Foreground" Value="{DynamicResource EstablishedGoodBrush}" /></Trigger>
                <Trigger Property="Tag" Value="{x:Static vm:AuditOutputState.SavedWithLimitations}"><Setter Property="Foreground" Value="{DynamicResource FaultBrush}" /></Trigger>
                <Trigger Property="Tag" Value="{x:Static vm:AuditOutputState.Stopped}"><Setter Property="Foreground" Value="{DynamicResource FaultBrush}" /></Trigger>
                <Trigger Property="Tag" Value="{x:Static vm:AuditOutputState.Failed}"><Setter Property="Foreground" Value="{DynamicResource CriticalFindingBrush}" /></Trigger>
                <Trigger Property="Tag" Value="{x:Static vm:AuditOutputState.NoOutput}"><Setter Property="Foreground" Value="{DynamicResource CriticalFindingBrush}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CaptureRowMark" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static capture:CaptureReadState.Reading}"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static capture:CaptureReadState.ReadComplete}"><Setter Property="Foreground" Value="{DynamicResource EstablishedGoodBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static capture:CaptureReadState.AttemptFailed}"><Setter Property="Foreground" Value="{DynamicResource FaultBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static capture:CaptureReadState.Stopped}"><Setter Property="Foreground" Value="{DynamicResource FaultBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProgressStateText" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Style.Triggers>
                <Trigger Property="Tag" Value="{x:Static vm:AuditOutputState.SavedWithLimitations}"><Setter Property="Foreground" Value="{DynamicResource FaultBrush}" /></Trigger>
                <Trigger Property="Tag" Value="{x:Static vm:AuditOutputState.Stopped}"><Setter Property="Foreground" Value="{DynamicResource FaultBrush}" /></Trigger>
                <Trigger Property="Tag" Value="{x:Static vm:AuditOutputState.Failed}"><Setter Property="Foreground" Value="{DynamicResource CriticalFindingBrush}" /></Trigger>
                <Trigger Property="Tag" Value="{x:Static vm:AuditOutputState.NoOutput}"><Setter Property="Foreground" Value="{DynamicResource CriticalFindingBrush}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ResultsSummaryText" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasOutputLimitations}" Value="True"><Setter Property="Foreground" Value="{DynamicResource FaultBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding WasStopped}" Value="True"><Setter Property="Foreground" Value="{DynamicResource FaultBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding HasRunError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource CriticalFindingBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RunMetric" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlock}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="RunLeaveButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasRunOutput}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <DockPanel Margin="20,14,20,0">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding ScreenHeading}" Style="{StaticResource ScreenTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ForestFqdn}" Style="{StaticResource Identifier}" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding RunScopeLabel,StringFormat='  &#x00b7; {0}'}" Foreground="{DynamicResource SecondaryTextBrush}"
                                   Visibility="{Binding ShowsRunSurface,Converter={StaticResource Shown}}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DomainCountLabel}" Style="{StaticResource WizardText}" HorizontalAlignment="Right"
                               Visibility="{Binding ShowsWizardSteps,Converter={StaticResource Shown}}" />
                    <StackPanel Visibility="{Binding ShowsRunSurface,Converter={StaticResource Shown}}">
                        <TextBlock Text="Elapsed" Style="{StaticResource Caption}" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding Progress.ElapsedClock}" Style="{StaticResource RunMetric}" HorizontalAlignment="Right" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10" Visibility="{Binding ShowsWizardSteps,Converter={StaticResource Shown}}">
                <Border x:Name="DomainsStep" Padding="10,6,10,3" CornerRadius="5,5,0,0" Margin="0,0,10,0" BorderThickness="0,0,0,3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource AssetNavigationBackground}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsOnDomains}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Domains &amp; readiness" FontWeight="SemiBold" />
                </Border>
                <Border x:Name="ReviewStep" Padding="10,6,10,3" CornerRadius="5,5,0,0" BorderThickness="0,0,0,3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource AssetNavigationBackground}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsOnReview}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Review &amp; run" FontWeight="SemiBold" />
                </Border>
            </WrapPanel>

            <Border x:Name="ReadinessPhaseProgress" DockPanel.Dock="Top" Style="{StaticResource WizardCard}" Padding="10"
                    Visibility="{Binding ShowsReadinessProgress,Converter={StaticResource Shown}}">
                <StackPanel>
                    <TextBlock Text="{Binding Progress.Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Progress.Status}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <ProgressBar IsIndeterminate="{Binding Progress.IsActive}" Height="4" Margin="0,6,0,4"
                                 Visibility="{Binding Progress.IsActive,Converter={StaticResource Shown}}" />
                    <WrapPanel>
                        <TextBlock Text="{Binding Progress.Counter}" TextWrapping="Wrap" Margin="0,0,18,0" />
                        <TextBlock Text="{Binding Progress.Elapsed}" TextWrapping="Wrap" Margin="0,0,18,0" />
                        <TextBlock Text="{Binding Progress.LastUpdateAge}" TextWrapping="Wrap" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Progress.Caveat}" Style="{StaticResource Caption}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>

            <UniformGrid x:Name="RunStages" DockPanel.Dock="Top" Columns="3" Margin="0,2,0,12"
                         Visibility="{Binding ShowsRunSurface,Converter={StaticResource Shown}}">
                <Border Style="{StaticResource ProgressStep}" Tag="{Binding CaptureOutput}" Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CaptureMark}" Style="{StaticResource ProgressMark}" Tag="{Binding CaptureOutput}" Width="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"><TextBlock Text="Capture &amp; seal" FontWeight="SemiBold" /><TextBlock Text="{Binding CaptureStepText}" Tag="{Binding CaptureOutput}" Style="{StaticResource ProgressStateText}" /></StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource ProgressStep}" Tag="{Binding DerivationOutput}" Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DerivationMark}" Style="{StaticResource ProgressMark}" Tag="{Binding DerivationOutput}" Width="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"><TextBlock Text="Prepare analysis" FontWeight="SemiBold" /><TextBlock Text="{Binding DerivationOutputText}" Tag="{Binding DerivationOutput}" Style="{StaticResource ProgressStateText}" /></StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource ProgressStep}" Tag="{Binding JudgementOutput}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding JudgementMark}" Style="{StaticResource ProgressMark}" Tag="{Binding JudgementOutput}" Width="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"><TextBlock Text="Assess evidence" FontWeight="SemiBold" /><TextBlock Text="{Binding JudgementOutputText}" Tag="{Binding JudgementOutput}" Style="{StaticResource ProgressStateText}" /></StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>
            <Border x:Name="AuditPhaseProgress" DockPanel.Dock="Top" Style="{StaticResource WizardCard}" CornerRadius="7,7,0,0"
                    BorderThickness="1,1,1,0" Padding="14,12,14,4" Margin="0"
                    Visibility="{Binding ShowsRunActivity,Converter={StaticResource Shown}}">
                <StackPanel>
                    <TextBlock Text="{Binding Progress.Status}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="{Binding Progress.IsActive}" Height="4" Margin="0,10,0,8"
                                 Visibility="{Binding Progress.IsActive,Converter={StaticResource Shown}}"
                                 AutomationProperties.Name="Current audit operation; no completion percentage" />
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Top" Background="{DynamicResource FaultSubtleBrush}" BorderBrush="{DynamicResource FaultBrush}"
                    BorderThickness="1" Padding="12,8" Margin="0,0,0,10" Visibility="{Binding ShowsPreparationNotice,Converter={StaticResource Shown}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissNoticeCommand}" VerticalAlignment="Top" />
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{Binding Notice.Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBox Text="{Binding Notice.Detail,Mode=OneWay}" Style="{StaticResource SelectableMessage}" MaxHeight="70" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Padding="12,10" Margin="0,10,0,0">
                <DockPanel LastChildFill="True">
                    <WrapPanel DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button Command="{Binding LeaveCommand}" Style="{StaticResource RunLeaveButton}" Margin="0,0,8,0" Visibility="{Binding CanLeave,Converter={StaticResource Shown}}">
                            <TextBlock Text="{Binding LeaveLabel}">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlock}">
                                    <Style.Triggers><DataTrigger Binding="{Binding HasRunOutput}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource OnAccentTextBrush}" />
                                    </DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Content="Back" Command="{Binding BackCommand}" Margin="0,0,8,0" Visibility="{Binding ShowsBackAction,Converter={StaticResource Shown}}" />
                        <Button Command="{Binding ReviewCommand}" Style="{StaticResource PrimaryButton}"
                                Visibility="{Binding IsOnDomains,Converter={StaticResource Shown}}">
                            <TextBlock Text="Next: review run" Foreground="{DynamicResource OnAccentTextBrush}" />
                        </Button>
                        <Button Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}"
                                Visibility="{Binding ShowsStartAction,Converter={StaticResource Shown}}">
                            <TextBlock Text="{Binding StartLabel}" Foreground="{DynamicResource OnAccentTextBrush}" />
                        </Button>
                        <Button Command="{Binding RequestAuditStopCommand}" Style="{StaticResource DangerButton}"
                                Visibility="{Binding CanRequestAuditStop,Converter={StaticResource Shown}}">
                            <TextBlock Text="Stop audit" Foreground="{DynamicResource OnAccentTextBrush}" />
                        </Button>
                    </WrapPanel>
                    <TextBox Text="{Binding FooterStatus,Mode=OneWay}" Style="{StaticResource SelectableMessage}" VerticalAlignment="Center"
                             MaxHeight="60" VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowsRunPreparation,Converter={StaticResource Shown}}" />
                    <Button Content="Details" Command="{Binding ToggleRunDetailsCommand}" HorizontalAlignment="Left"
                            AutomationProperties.HelpText="Show or hide the recorded activity, outcome reasons and coverage"
                            Visibility="{Binding ShowsRunSurface,Converter={StaticResource Shown}}" />
                </DockPanel>
            </Border>

            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsOnDomains,Converter={StaticResource Shown}}">
                    <StackPanel>
                        <WrapPanel Margin="0,4,0,10">
                            <TextBlock Text="This machine's site: " Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding SiteDescription}" TextWrapping="Wrap" Foreground="{DynamicResource NotEstablishedBrush}" />
                        </WrapPanel>
                        <StackPanel Visibility="{Binding IsBusy,Converter={StaticResource Shown}}" Margin="0,0,0,10">
                            <TextBlock Text="{Binding BusyMessage}" Style="{StaticResource WizardText}" />
                            <Button Content="Cancel checks" Command="{Binding StopCommand}" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" />
                        </StackPanel>
                        <Button Content="Look again" Command="{Binding OpenCommand}" HorizontalAlignment="Left" Margin="0,0,0,10"
                                Visibility="{Binding MayLookAgain,Converter={StaticResource Shown}}" />
                        <Border Style="{StaticResource WizardCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="Domain details" Command="{Binding ShowDetailsCommand}" />
                                    <TextBlock Text="Domains to read" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                          SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          ColumnHeaderStyle="{StaticResource WizardHeader}" HorizontalScrollBarVisibility="Auto"
                                          MinRowHeight="{StaticResource DenseRowMinHeight}" MaxHeight="300"
                                          Background="Transparent" BorderBrush="{DynamicResource DividerBrush}"
                                          HorizontalGridLinesBrush="{DynamicResource DividerBrush}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Include" MinWidth="72" Width="72">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <CheckBox IsChecked="{Binding IsIncluded,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding MayChangeInclusion}" Margin="8" />
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" IsReadOnly="True" MinWidth="150" Width="*" />
                                        <DataGridTextColumn Header="Read from" Binding="{Binding Controller}" IsReadOnly="True" MinWidth="190" Width="*" />
                                        <DataGridTemplateColumn Header="Readiness" MinWidth="190" Width="Auto">
                                            <DataGridTemplateColumn.CellStyle>
                                                <Style TargetType="DataGridCell" BasedOn="{StaticResource TableCell}">
                                                    <Setter Property="Padding" Value="0" />
                                                </Style>
                                            </DataGridTemplateColumn.CellStyle>
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <Grid Width="170" Height="34" Margin="8,4" ToolTip="{Binding ReadinessText}">
                                                    <Path x:Name="ReadyToReadMark" Width="23" Height="20" Stretch="Uniform"
                                                          Data="M 1,10 L 8,17 L 22,1" Stroke="{DynamicResource EstablishedGoodBrush}"
                                                          StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ReadinessStatus}" Value="{x:Static vm:AuditReadinessStatus.Ready}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                        <AutomationProperties.Name>
                                                            <MultiBinding StringFormat="{}{0}: ready to read"><Binding Path="Domain" /></MultiBinding>
                                                        </AutomationProperties.Name>
                                                    </Path>
                                                    <Button Style="{StaticResource ReadinessAction}"
                                                            Command="{Binding DataContext.ShowRowDetailsCommand,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <AutomationProperties.Name>
                                                            <MultiBinding StringFormat="{}{0}: {1}"><Binding Path="Domain" /><Binding Path="ReadinessText" /></MultiBinding>
                                                        </AutomationProperties.Name>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding ReadinessSymbol}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                                                       FontWeight="SemiBold" FontSize="16" Width="19" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding ReadinessActionText}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Controller choice" MinWidth="240" Width="*">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <Expander Header="Change controller" Margin="6"
                                                          Visibility="{Binding MayNameAController,Converter={StaticResource Shown}}">
                                                    <StackPanel>
                                                        <TextBox Text="{Binding NamedController,UpdateSourceTrigger=PropertyChanged}" MinWidth="210"
                                                                 FontFamily="{StaticResource IdentifierFontFamily}" />
                                                        <Button Content="Validate" Command="{Binding ValidateCommand}" HorizontalAlignment="Left" Margin="0,6,0,4" />
                                                        <TextBlock Text="{Binding ControllerCheckText,Mode=OneWay}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Expander>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="An excluded domain is different from an unreachable one. Exclusion requires a reason and the person authorizing it."
                                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsOnReview,Converter={StaticResource Shown}}">
                    <StackPanel Margin="0,0,0,10">
                        <StackPanel Visibility="{Binding ShowsRunPreparation,Converter={StaticResource Shown}}">
                            <Border Style="{StaticResource WizardCard}">
                                <StackPanel>
                                    <TextBlock Text="What this run will do" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                                    <RadioButton Style="{StaticResource ChoiceRadio}" GroupName="Intent"
                                                 IsChecked="{Binding CaptureAndAnalyse,Mode=TwoWay}" IsEnabled="{Binding MayChangeObjectScope}">
                                        <StackPanel><TextBlock Text="Capture and analyse" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <TextBlock Text="Capture evidence, then analyse it and save findings."
                                                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" MaxWidth="680" /></StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource ChoiceRadio}" GroupName="Intent" Margin="0,12,0,0"
                                                 IsChecked="{Binding CaptureOnly,Mode=TwoWay}" IsEnabled="{Binding MayChangeObjectScope}">
                                        <StackPanel><TextBlock Text="Capture only" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <TextBlock Text="Capture evidence now; analyse the saved run later."
                                                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" MaxWidth="680" /></StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource WizardCard}">
                                <StackPanel x:Name="ReviewScope">
                                    <DockPanel Margin="0,0,0,12">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Review.ReadCount,StringFormat='{}{0} selected'}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <TextBlock Text="Domains to audit" Style="{StaticResource SectionTitle}" />
                                    </DockPanel>
                                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <Grid x:Name="ReviewDomainHeader" Background="{DynamicResource AttributeHeaderBackground}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="0.44*" /><ColumnDefinition Width="0.56*" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Domain" Margin="12,7" FontWeight="SemiBold" Foreground="{DynamicResource AttributeLabelBrush}" />
                                                <TextBlock Grid.Column="1" Text="Domain controller" Margin="12,7" FontWeight="SemiBold" Foreground="{DynamicResource AttributeLabelBrush}" />
                                            </Grid>
                                            <ItemsControl x:Name="ReviewDomains" ItemsSource="{Binding Review.WillBeRead}">
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="0.44*" /><ColumnDefinition Width="0.56*" /></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Domain}" Style="{StaticResource BaseTextBlock}" Margin="12,8" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Controller}" Style="{StaticResource BaseTextBlock}" Margin="12,8"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding UnattestedExclusionNote}" Style="{StaticResource WizardText}" Foreground="{DynamicResource FaultBrush}" Visibility="{Binding HasUnattestedExclusions,Converter={StaticResource Shown}}" />
                                    <TextBlock TextWrapping="Wrap" Margin="0,10,0,12">
                                        <TextBlock.Style><Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Review.NotReadHeading}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Review.NotReadCount}" Value="0">
                                                    <Setter Property="Text" Value="No domains excluded." />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style></TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Exclusions}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Domain}" Style="{StaticResource BaseTextBlock}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Why}" Style="{StaticResource BaseTextBlock}" />
                                                <TextBlock Text="{Binding Stated}" Style="{StaticResource BaseTextBlock}" />
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource BaseTextBlock}" Visibility="{Binding HasNote,Converter={StaticResource Shown}}" />
                                                <TextBlock Text="{Binding AuthorisedBy,StringFormat='Authorised by {0}, as typed.'}" Style="{StaticResource BaseTextBlock}" Visibility="{Binding IsAttested,Converter={StaticResource Shown}}" />
                                            </StackPanel>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <WrapPanel x:Name="ReviewOptions">
                                        <Expander Header="Object scope and optional inclusion" Margin="0,0,10,0" MaxWidth="680" VerticalAlignment="Top">
                                            <StackPanel Margin="8">
                                                <TextBlock Text="{Binding ObjectClassesHeading}" Style="{StaticResource WizardText}" FontWeight="SemiBold" />
                                                <CheckBox x:Name="IncludeEnatelSsoCheckBox" Content="{Binding IncludeEnatelSsoLabel}"
                                                          IsChecked="{Binding IncludeEnatelSso,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding MayChangeObjectScope}" />
                                                <TextBlock Text="{Binding ObjectScopeHelp}" Style="{StaticResource WizardText}" />
                                                <TextBlock Text="{Binding ExcludedClassesHeading}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <ItemsControl ItemsSource="{Binding ExcludedObjectClasses}" />
                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="Optional SYSVOL check" MaxWidth="680" VerticalAlignment="Top">
                                            <StackPanel Margin="8">
                                                <CheckBox Content="{Binding ScanGppPasswordsLabel}"
                                                          IsChecked="{Binding ScanGppPasswords,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding MayChangeObjectScope}" />
                                                <TextBlock Text="{Binding ScanGppPasswordsHelp}" Style="{StaticResource WizardText}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Expander>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Style="{StaticResource WizardCard}" CornerRadius="0,0,7,7" BorderThickness="1,0,1,1"
                                Visibility="{Binding ShowsRunActivity,Converter={StaticResource Shown}}">
                            <StackPanel>
                                <ScrollViewer x:Name="CaptureScopeScroll" MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                        Visibility="{Binding ShowsCaptureActivity,Converter={StaticResource Shown}}">
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <Grid Background="{DynamicResource AttributeHeaderBackground}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="0.38*" /><ColumnDefinition Width="0.2*" /><ColumnDefinition Width="0.42*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Scope" Margin="10,6" FontWeight="SemiBold" Foreground="{DynamicResource AttributeLabelBrush}" />
                                            <TextBlock Grid.Column="1" Text="Objects read" Margin="10,6" TextAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource AttributeLabelBrush}" />
                                            <TextBlock Grid.Column="2" Text="Status" Margin="10,6" FontWeight="SemiBold" Foreground="{DynamicResource AttributeLabelBrush}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding CaptureRows}">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.38*" /><ColumnDefinition Width="0.2*" /><ColumnDefinition Width="0.42*" /></Grid.ColumnDefinitions>
                                                        <StackPanel Margin="10,7">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BaseTextBlock}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Foreground="{DynamicResource SecondaryTextBrush}"
                                                                       Visibility="{Binding HasDetail,Converter={StaticResource Shown}}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding ObjectsText}" Style="{StaticResource BaseTextBlock}" Margin="10,7" TextAlignment="Right" />
                                                        <Grid Grid.Column="2" Margin="10,7">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Mark}" Style="{StaticResource CaptureRowMark}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource BaseTextBlock}" />
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                </ScrollViewer>
                                <StackPanel Margin="0,10,0,12" Visibility="{Binding ShowsAnalysisActivity,Converter={StaticResource Shown}}">
                                    <TextBlock Text="{Binding Progress.WorkCountText}" Style="{StaticResource RunMetric}" FontSize="44" />
                                    <TextBlock Text="{Binding Progress.WorkUnit}" Style="{StaticResource WizardText}" />
                                </StackPanel>
                                <UniformGrid Columns="3" Margin="0,12,0,0">
                                    <StackPanel Visibility="{Binding ShowsCaptureActivity,Converter={StaticResource Shown}}">
                                        <TextBlock Text="{Binding Progress.WorkCountText}" Style="{StaticResource RunMetric}" />
                                        <TextBlock Text="{Binding Progress.WorkUnit}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding ShowsCaptureActivity,Converter={StaticResource Shown}}">
                                        <TextBlock Text="{Binding DomainReadsText}" Style="{StaticResource RunMetric}" />
                                        <TextBlock Text="Domain reads finished" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Progress.LastWorkReportAge}" Style="{StaticResource RunMetric}" />
                                        <TextBlock Text="Last work report" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource WizardCard}" Visibility="{Binding HasRunEnded,Converter={StaticResource Shown}}">
                            <StackPanel>
                                <TextBlock Text="{Binding ResultsSummary}" Style="{StaticResource ResultsSummaryText}" Margin="0,0,0,14" />
                                <UniformGrid Columns="3" Margin="0,0,0,12" Visibility="{Binding HasResultMetrics,Converter={StaticResource Shown}}">
                                    <StackPanel><TextBlock Text="{Binding ResultObjectsText}" Style="{StaticResource RunMetric}" />
                                        <TextBlock Text="{Binding ResultObjectsLabel}" Style="{StaticResource Caption}" /></StackPanel>
                                    <StackPanel Visibility="{Binding HasSavedDerivation,Converter={StaticResource Shown}}">
                                        <TextBlock Text="{Binding ResultPrincipalsText}" Style="{StaticResource RunMetric}" /><TextBlock Text="Principals" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding HasSavedDerivation,Converter={StaticResource Shown}}">
                                        <TextBlock Text="{Binding ResultRelationshipsText}" Style="{StaticResource RunMetric}" /><TextBlock Text="Nesting relationships" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="{Binding ResultsMessage}" Style="{StaticResource WizardText}" Visibility="{Binding HasResultsMessage,Converter={StaticResource Shown}}" />
                                <Border Background="{DynamicResource FaultSubtleBrush}" BorderBrush="{DynamicResource FaultBrush}" BorderThickness="1" Padding="10,6" Margin="0,4,0,6"
                                        Visibility="{Binding HasRuleLimitations,Converter={StaticResource Shown}}">
                                    <DockPanel><Button DockPanel.Dock="Right" Content="Details" Command="{Binding ShowRunDetailsCommand}" />
                                        <TextBlock Text="{Binding RuleLimitationsText}" Style="{StaticResource BaseTextBlock}" VerticalAlignment="Center" Margin="0,0,12,0" /></DockPanel>
                                </Border>
                                <Border Background="{DynamicResource AttributeHeaderBackground}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Padding="10,6" Margin="0,4,0,6"
                                        Visibility="{Binding HasCoverage,Converter={StaticResource Shown}}">
                                    <DockPanel><Button DockPanel.Dock="Right" Content="Coverage" Command="{Binding ShowRunDetailsCommand}" />
                                        <TextBlock Text="{Binding CoverageText}" Style="{StaticResource BaseTextBlock}" VerticalAlignment="Center" Margin="0,0,12,0" /></DockPanel>
                                </Border>
                                <Border Background="{DynamicResource FaultSubtleBrush}" BorderBrush="{DynamicResource FaultBrush}" BorderThickness="1" Padding="10,6" Margin="0,4,0,6"
                                        Visibility="{Binding HasRunError,Converter={StaticResource Shown}}">
                                    <DockPanel><Button DockPanel.Dock="Right" Content="Details" Command="{Binding ShowRunDetailsCommand}" />
                                        <TextBlock Text="An audit error was recorded." Style="{StaticResource BaseTextBlock}" VerticalAlignment="Center" /></DockPanel>
                                </Border>
                                <StackPanel Margin="0,10,0,0" Visibility="{Binding HasSealedEvidence,Converter={StaticResource Shown}}">
                                    <TextBlock Text="Saved run" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding BundleDirectory,Mode=OneWay}" Style="{StaticResource SelectableMessage}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="RunDetailsPanel" Style="{StaticResource WizardCard}" views:ScrollToVisible.Enabled="True"
                                Visibility="{Binding ShowsRunDetails,Converter={StaticResource Shown}}">
                            <StackPanel>
                                <TextBlock Text="Run details" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding Progress.RecentReports}" Visibility="{Binding ShowsRunActivity,Converter={StaticResource Shown}}">
                                    <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" Style="{StaticResource BaseTextBlock}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource BaseTextBlock}" />
                                    </Grid></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding UnresolvedReasons}">
                                    <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Reason}" Style="{StaticResource BaseTextBlock}" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding ObjectsAffected,StringFormat='{}{0:N0}'}" Style="{StaticResource BaseTextBlock}" />
                                            <TextBlock Text="Objects" Style="{StaticResource Caption}" /></StackPanel>
                                    </Grid></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Margin="0,12,0,4" Visibility="{Binding HasCoverage,Converter={StaticResource Shown}}">
                                    <TextBlock Text="Coverage" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding CoverageDetail}" Style="{StaticResource BaseTextBlock}" />
                                </StackPanel>
                                <Expander Header="Recorded capture report" Visibility="{Binding HasCaptureReport,Converter={StaticResource Shown}}" Margin="0,8,0,0">
                                    <TextBox Text="{Binding Report,Mode=OneWay}" Style="{StaticResource SelectableMessage}" MaxHeight="180" VerticalScrollBarVisibility="Auto" />
                                </Expander>
                                <Expander Header="Recorded preparation report" Visibility="{Binding HasDerivationReport,Converter={StaticResource Shown}}" Margin="0,8,0,0">
                                    <TextBox Text="{Binding DerivationReport,Mode=OneWay}" Style="{StaticResource SelectableMessage}" MaxHeight="180" VerticalScrollBarVisibility="Auto" />
                                </Expander>
                                <Expander Header="Recorded assessment and coverage report" Visibility="{Binding HasJudgingReport,Converter={StaticResource Shown}}" Margin="0,8,0,0">
                                    <TextBox Text="{Binding JudgingReport,Mode=OneWay}" Style="{StaticResource SelectableMessage}" MaxHeight="220" VerticalScrollBarVisibility="Auto" />
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
        <Border Background="{DynamicResource ScrimBrush}" Visibility="{Binding HasDetails,Converter={StaticResource Shown}}">
            <Border Background="{DynamicResource SurfaceBackground}" Margin="28" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8">
                <ContentControl Content="{Binding Details}" />
            </Border>
        </Border>
        <Border Background="{DynamicResource ScrimBrush}" Visibility="{Binding StopConfirmationRequested,Converter={StaticResource Shown}}">
            <Border Style="{StaticResource WizardCard}" MaxWidth="540" Margin="20" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Stop this audit?" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding StopExplanation}" Style="{StaticResource WizardText}" Margin="0,12,0,12" />
                    <WrapPanel HorizontalAlignment="Right">
                        <Button Content="Keep running" Command="{Binding KeepAuditRunningCommand}" Margin="0,0,8,0" />
                        <Button Command="{Binding ConfirmAuditStopCommand}" Style="{StaticResource DangerButton}">
                            <TextBlock Text="Stop audit" Foreground="{DynamicResource OnAccentTextBrush}" />
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
