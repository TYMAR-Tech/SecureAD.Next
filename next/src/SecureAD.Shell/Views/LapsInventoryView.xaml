<UserControl x:Class="SecureAD.Shell.Views.LapsInventoryView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="LAPS coverage" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Saved computer states and expiry values; no password is read and no rotation is performed."
                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
        </StackPanel>
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource AttributeHeaderBackground}"
                BorderBrush="{DynamicResource AttributeCardBorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{Binding ScopeTreeAction}" Command="{Binding ToggleScopeTreeCommand}"
                        Margin="12,0,0,0" />
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                    <Run Text="Scope: " FontWeight="SemiBold" /><Run Text="{Binding LapsLocation,Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- THE COUNTS ARE THE FEATURE. An operator watching a rollout is reading "412 not managed"
             far more often than any row, and a page of a hundred machines says nothing about an
             estate. Every state appears, including the ones at zero: a list that omits what it did
             not find reads as a shorter question than the one that was asked. -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding LapsCounts}" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Width="190" Margin="0,0,8,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Count,StringFormat={}{0:N0}}" Style="{StaticResource SectionTitle}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border DockPanel.Dock="Top" Background="{DynamicResource AttributeHeaderBackground}"
                BorderBrush="{DynamicResource AttributeCardBorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <DockPanel>
                <ComboBox DockPanel.Dock="Right" Width="155" ItemsSource="{Binding LapsStateChoices}"
                          SelectedItem="{Binding LapsStateFilter}" Margin="10,0,0,0" />
                <TextBox Text="{Binding LapsSearchText,UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filter computers in the selected scope by computer or domain." />
            </DockPanel>
        </Border>

        <!-- WHY A REFUSAL IS A SENTENCE RATHER THAN AN EMPTY TABLE, as the findings grid says: a
             container with no computers and a bundle that would not open draw the same blank grid,
             and an operator reads a blank grid as an answer. -->
        <Border DockPanel.Dock="Top"
                Style="{StaticResource Card}"
                Margin="0,0,0,8"
                Visibility="{Binding HasLapsRefusal, Converter={StaticResource Shown}}">
            <StackPanel>
                <TextBlock Text="{Binding LapsRefusal.Title}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <TextBox Text="{Binding LapsRefusal.Detail, Mode=OneWay}"
                         Style="{StaticResource SelectableMessage}"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>

        <!-- A listing short by an unknown number of machines says so, per 0002. Without it, a
             rollout looks further along than it is: the machines nobody could read are exactly the
             ones nobody has deployed to. -->
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding LapsShortfall}"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Visibility="{Binding HasLapsShortfall, Converter={StaticResource Shown}}" />

        <TextBlock DockPanel.Dock="Bottom"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Margin="0,8,0,0">
            <Run Text="{Binding LapsTotal, Mode=OneWay}" />
            <Run Text="computers in this container" />
        </TextBlock>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,8,0,0"
                Visibility="{Binding HasSelectedLapsComputer,Converter={StaticResource Shown}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Open object window"
                        Command="{Binding OpenLapsComputerCommand}" CommandParameter="{Binding SelectedLapsComputer}"
                        Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" />
                <StackPanel>
                    <TextBlock Text="{Binding SelectedLapsComputer.Name}" Style="{StaticResource RowTitle}" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Caption}">
                        <Run Text="{Binding SelectedLapsComputer.Domain,Mode=OneWay}" /><Run Text=" · " />
                        <Run Text="{Binding SelectedLapsComputer.Management,Mode=OneWay}" /><Run Text=" · " />
                        <Run Text="{Binding SelectedLapsComputer.Capability,Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Caption}">
                        <Run Text="Windows expiry " /><Run Text="{Binding SelectedLapsComputer.WindowsLapsExpiry,Mode=OneWay}" />
                        <Run Text=" · Legacy expiry " /><Run Text="{Binding SelectedLapsComputer.LegacyLapsExpiry,Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="{Binding LapsPageNumber,StringFormat=Page {0}}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="Previous" Command="{Binding PreviousLapsCommand}"
                    IsEnabled="{Binding HasEarlierLaps}" Margin="0,0,8,0" />
            <Button Content="Next" Command="{Binding NextLapsCommand}"
                    IsEnabled="{Binding HasMoreLaps}" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding VisibleLapsComputers}" SelectedItem="{Binding SelectedLapsComputer,Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="*" />

                <!-- The state, and the mark beside it. Unexpected is not coloured as bad: the
                     machine is managed and there is no exposure - what is wrong is that Microsoft
                     says the combination cannot occur. -->
                <DataGridTextColumn Header="LAPS" Binding="{Binding Management}" Width="Auto" />

                <DataGridTextColumn Header="Windows LAPS expiry"
                                    Binding="{Binding WindowsLapsExpiry}" Width="Auto" />

                <!-- BOTH TIMESTAMPS, NOT THE ONE THAT SUITS THE TIER. The predecessor showed
                     whichever matched the tier it had assigned, so a migrated machine looked modern
                     and the legacy value it still carried was invisible. -->
                <DataGridTextColumn Header="Legacy LAPS expiry"
                                    Binding="{Binding LegacyLapsExpiry}" Width="Auto" />

                <DataGridTextColumn Header="Operating system"
                                    Binding="{Binding OperatingSystem}" Width="*" />

                <DataGridTextColumn Header="Capable of" Binding="{Binding Capability}"
                                    Width="Auto" />

                <!-- WHY THIS COLUMN EXISTS. Both rules are silent about a domain controller and
                     about a disabled account, and an operator who could not see them here would
                     have no way to tell a machine the product deliberately ignored from one it
                     never captured. The first ad.lab run reported two excluded machines as
                     findings because there was nowhere else for them to appear. -->
                <DataGridTextColumn Header="Rules skip it because"
                                    Binding="{Binding NotJudgedBecause}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
