<UserControl x:Class="SecureAD.Shell.Views.DelegationsView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SecureAD.Shell.ViewModels">
    <Grid Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{x:Static vm:DelegationText.Heading}" Style="{StaticResource RowTitle}" />
            <TextBlock Text="{Binding DelegationBoundary}" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,10" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <WrapPanel IsEnabled="{Binding DelegationControlsAreEnabled}">
                <StackPanel Margin="0,0,12,6">
                    <TextBlock Text="{x:Static vm:DelegationText.Principal}" Style="{StaticResource BlockLabel}" />
                    <TextBox Text="{Binding DelegationPrincipalSearch, UpdateSourceTrigger=PropertyChanged}" MinWidth="250" />
                </StackPanel>
                <Button Content="{x:Static vm:DelegationText.FindPrincipal}" Command="{Binding FindDelegationPrincipalCommand}"
                        VerticalAlignment="Bottom" Margin="0,0,12,6" />
                <Button Content="{x:Static vm:DelegationText.MorePrincipals}" Command="{Binding NextDelegationPrincipalsCommand}"
                        VerticalAlignment="Bottom" Margin="0,0,0,6" />
            </WrapPanel>
            <TextBlock Text="{x:Static vm:DelegationText.MatchingPrincipal}" Style="{StaticResource BlockLabel}" />
            <ComboBox ItemsSource="{Binding DelegationPrincipals}" SelectedItem="{Binding SelectedDelegationPrincipal}"
                      DisplayMemberPath="Label" IsEnabled="{Binding DelegationControlsAreEnabled}" Margin="0,0,0,4" />
            <TextBlock Text="{Binding DelegationPrincipalStatus}" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8" />
            <WrapPanel IsEnabled="{Binding DelegationControlsAreEnabled}">
                <StackPanel Margin="0,0,12,6">
                    <TextBlock Text="{x:Static vm:DelegationText.Permission}" Style="{StaticResource BlockLabel}" />
                    <ComboBox ItemsSource="{Binding DelegationPermissions}" SelectedItem="{Binding DelegationPermissionFilter}"
                              DisplayMemberPath="Name" MinWidth="225" />
                </StackPanel>
                <CheckBox Content="{x:Static vm:DelegationText.IncludeInherited}" IsChecked="{Binding IncludeInheritedDelegations}"
                          VerticalAlignment="Bottom" Margin="0,0,12,10" />
                <CheckBox Content="{x:Static vm:DelegationText.IncludeGroups}" IsChecked="{Binding IncludeGroupHeldPermissions}"
                          VerticalAlignment="Bottom" Margin="0,0,12,10" />
                <Button Content="{x:Static vm:DelegationText.FindDelegations}" Command="{Binding FindDelegationsCommand}"
                        VerticalAlignment="Bottom" Margin="0,0,0,6" />
            </WrapPanel>
            <WrapPanel Visibility="{Binding IsLoading, Converter={StaticResource Shown}}">
                <TextBlock Text="{Binding LoadingText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="{x:Static vm:DelegationText.Cancel}" Command="{Binding CancelDelegationSearchCommand}" />
            </WrapPanel>
            <StackPanel Visibility="{Binding HasViewRefusal, Converter={StaticResource Shown}}">
                <TextBlock Text="{Binding ViewRefusal.Title}" Style="{StaticResource RowTitle}" />
                <TextBox Text="{Binding ViewRefusal.Detail, Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                         Foreground="{StaticResource FaultBrush}" />
            </StackPanel>
            <TextBlock Text="{Binding DelegationStatus}" TextWrapping="Wrap" Margin="0,4,0,4" />
            <TextBlock Text="{Binding DelegationCoverage}" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6" />
        </StackPanel>
        </ScrollViewer>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Delegations}" SelectedItem="{Binding SelectedDelegation}"
                  AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True" CanUserSortColumns="False"
                  Visibility="{Binding HasDelegationAnswer, Converter={StaticResource Shown}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static vm:DelegationText.RecordedOn}" Binding="{Binding RecordedOn}" Width="2*" MinWidth="170" />
                <DataGridTextColumn Header="{x:Static vm:DelegationText.Domain}" Binding="{Binding Domain}" Width="*" MinWidth="105" />
                <DataGridTextColumn Header="{x:Static vm:DelegationText.PermissionHolder}" Binding="{Binding PermissionHeldBy}" Width="*" MinWidth="150" />
                <DataGridTextColumn Header="{x:Static vm:DelegationText.Permission}" Binding="{Binding Permission}" Width="*" MinWidth="145" />
                <DataGridTextColumn Header="{x:Static vm:DelegationText.AppliesTo}" Binding="{Binding AppliesTo}" Width="*" MinWidth="145" />
                <DataGridTextColumn Header="{x:Static vm:DelegationText.EntryType}" Binding="{Binding EntryType}" Width="Auto" />
                <DataGridTextColumn Header="{x:Static vm:DelegationText.Inheritance}" Binding="{Binding Inheritance}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="{x:Static vm:DelegationText.InheritedNote}" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBox Text="{Binding SelectedDelegation.Detail, Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                     MaxHeight="80" VerticalScrollBarVisibility="Auto"
                     Visibility="{Binding HasDelegationSelection, Converter={StaticResource Shown}}" />
            <WrapPanel Margin="0,6,0,0">
                <Button Content="{x:Static vm:DelegationText.Previous}" Command="{Binding PreviousDelegationsCommand}" Margin="0,0,8,0" />
                <Button Content="{x:Static vm:DelegationText.Next}" Command="{Binding NextDelegationsCommand}" Margin="0,0,16,0" />
                <Button Content="{x:Static vm:DelegationText.OpenDetails}" Command="{Binding OpenDelegationDetailsCommand}" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>
