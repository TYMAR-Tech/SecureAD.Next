<UserControl x:Class="SecureAD.Shell.Views.HomeView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AssetCanvasBackground}">
    <Grid Margin="{StaticResource ScreenPadding}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="0.48*" MinWidth="280" MaxWidth="420" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
            <Border Style="{StaticResource HomePanel}" Padding="18" Background="{StaticResource AttributeHeaderBackground}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Margin="20,0,0,0" VerticalAlignment="Center">
                        <Button Content="New audit" Command="{Binding NewAuditCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" />
                        <TextBlock Text="Review scope before capture starts" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Active Directory security auditing" Style="{StaticResource Caption}" />
                        <TextBlock Text="Capture once. Investigate offline." Style="{StaticResource ScreenTitle}" Margin="0,4,0,8" />
                        <TextBlock Text="SecureAD captures your Active Directory forest as sealed evidence. Explore objects, permissions, group membership and security findings from that saved capture, without reconnecting to the directory."
                                   Style="{StaticResource BaseTextBlock}" Foreground="{StaticResource AttributeLabelBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource HomePanel}" Margin="0,12,0,14" Padding="12" Background="{StaticResource AttributeHeaderBackground}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Choose run library..." Command="{Binding ChooseLibraryCommand}" Margin="16,0,0,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="Run library" Style="{StaticResource HomeLabel}" />
                        <TextBox Text="{Binding LibraryDescription, Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                                 FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource AttributeSourceBrush}" />
                        <TextBox Text="{Binding Location.Problem, Mode=OneWay}" Style="{StaticResource SelectableMessage}" Foreground="{StaticResource FaultBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Status belongs to the work's named run, not to whichever row is selected now. -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                    Visibility="{Binding Library.HasAnalysisStatus, Converter={StaticResource Shown}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Stop" Command="{Binding Library.StopAnalysisCommand}"
                            Style="{StaticResource DangerButton}" Margin="12,0,0,0"
                            Visibility="{Binding Library.IsAnalysing, Converter={StaticResource Shown}}" />
                    <TextBox Text="{Binding Library.AnalysisStatus, Mode=OneWay}" Style="{StaticResource SelectableMessage}" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" BorderBrush="{StaticResource FaultBrush}"
                    Visibility="{Binding Library.HasProblem, Converter={StaticResource Shown}}">
                <TextBox Text="{Binding Library.Problem, Mode=OneWay}" Style="{StaticResource SelectableMessage}" Foreground="{StaticResource FaultBrush}" />
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource HomePanel}" Margin="0,0,16,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource HomePanelHeading}">
                    <TextBlock Text="Saved runs" Style="{StaticResource SectionTitle}" />
                </Border>
                <TextBlock DockPanel.Dock="Top" Text="Select a run to see its details. Runs with the same recorded domain scope are grouped together."
                           Style="{StaticResource Caption}" Margin="12,10" />
                <TextBlock DockPanel.Dock="Bottom" Text="Listed capture and analysis states are not a security verdict. Evidence is checked when a run is opened, not merely selected in this list."
                           Style="{StaticResource Caption}" Margin="12,10" />
                <TextBlock DockPanel.Dock="Top" Text="This run library holds no runs yet." Style="{StaticResource BaseTextBlock}" Margin="14"
                           Visibility="{Binding Library.IsEmpty, Converter={StaticResource Shown}}" />
                <Grid>
                    <DataGrid x:Name="SavedRunsTable" ItemsSource="{Binding Library.RunsView}" SelectedItem="{Binding Library.Selected, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource AttributeCardBorderBrush}"
                              Background="Transparent" BorderThickness="0" ColumnHeaderStyle="{StaticResource HomeColumnHeader}">
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <StackPanel>
                                                        <Border Background="{StaticResource SelectionBrush}" Padding="10,8">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Items[0].GroupHeading}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                                           Foreground="{StaticResource AttributeLabelBrush}" />
                                                                <TextBlock Text="{Binding ItemCount, StringFormat={}{0} run(s)}"
                                                                           FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource AttributeSourceBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ItemsPresenter />
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <!-- Keep content-sized, resizable columns rather than hiding long identifiers. -->
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Run" Width="Auto" MinWidth="190">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <StackPanel Margin="8">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource AttributeLabelBrush}" />
                                        <TextBlock Text="{Binding Identifier}" FontFamily="{StaticResource IdentifierFontFamily}"
                                                   FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource AttributeSourceBrush}"
                                                   Visibility="{Binding IsNamed, Converter={StaticResource Shown}}" />
                                        <TextBlock Text="Baseline" Foreground="{StaticResource FocusBrush}" FontSize="{StaticResource CaptionFontSize}"
                                                   Visibility="{Binding IsBaseline, Converter={StaticResource Shown}}" />
                                    </StackPanel>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="When (local time)" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <StackPanel Margin="8" ToolTip="{Binding When}">
                                        <TextBlock Text="{Binding WhenDate}" />
                                        <TextBlock Text="{Binding WhenTime}" />
                                        <TextBlock Text="folder date - the run recorded none" TextWrapping="Wrap" MaxWidth="180"
                                                   FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource AttributeSourceBrush}"
                                                   Visibility="{Binding WhenWasNotRecorded, Converter={StaticResource Shown}}" />
                                    </StackPanel>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Capture" Binding="{Binding State}" Width="Auto" MinWidth="95" ElementStyle="{StaticResource HomeRunCell}" />
                            <DataGridTextColumn Header="Analysis" Binding="{Binding Analysis, TargetNullValue=Not established}"
                                                Width="Auto" MinWidth="110" ElementStyle="{StaticResource HomeRunCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="2" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding Library.HasSelection, Converter={StaticResource Shown}}">
            <Border Style="{StaticResource HomePanel}">
                <StackPanel>
                    <Border Background="{StaticResource AttributeHeaderBackground}" Padding="14" CornerRadius="7,7,0,0">
                        <StackPanel>
                            <TextBlock Text="Selected run" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Library.Selected.Name}" Style="{StaticResource ScreenTitle}" Margin="0,4,0,6" />
                            <TextBox Text="{Binding Library.Selected.Identifier, Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                                     FontFamily="{StaticResource IdentifierFontFamily}" FontSize="{StaticResource CaptionFontSize}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="14">
                        <ItemsControl ItemsPanel="{StaticResource HomeStateColumns}" Margin="0,0,0,12">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Capture" Style="{StaticResource HomeLabel}" />
                                <TextBlock Text="{Binding Library.Selected.State}" Style="{StaticResource RowTitle}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Analysis" Style="{StaticResource HomeLabel}" />
                                <TextBlock Text="{Binding Library.Selected.Analysis, TargetNullValue=Not established}" Style="{StaticResource RowTitle}" />
                            </StackPanel>
                        </ItemsControl>
                        <TextBlock Text="{Binding Library.Selected.Meaning}" Style="{StaticResource BaseTextBlock}" Margin="0,0,0,12" />
                        <Button Content="Open run" Command="{Binding Library.OpenRunCommand}" Style="{StaticResource PrimaryButton}"
                                IsEnabled="{Binding Library.Selected.FinishedCleanly}" />
                        <TextBox Text="{Binding Library.Selected.Detail, Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                                 Foreground="{StaticResource FaultBrush}" Margin="0,10,0,0"
                                 Visibility="{Binding Library.Selected.HasDetail, Converter={StaticResource Shown}}" />
                        <Border Height="1" Background="{StaticResource AttributeCardBorderBrush}" Margin="0,14" />
                        <TextBlock Text="Run name" Style="{StaticResource HomeLabel}" />
                        <TextBox Text="{Binding Library.TypedName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Notes" Style="{StaticResource HomeLabel}" Margin="0,12,0,5" />
                        <TextBox Text="{Binding Library.TypedNotes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="68" MaxHeight="160" VerticalScrollBarVisibility="Auto" />
                        <Button Content="Save name and notes" Command="{Binding Library.SaveAnnotationCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        <TextBlock Text="Your name and notes do not change the sealed evidence." Style="{StaticResource Caption}" Margin="0,8,0,0" />
                        <Expander Header="Run location" Margin="0,14,0,0">
                            <TextBox Text="{Binding Library.Selected.Path, Mode=OneWay}" Style="{StaticResource SelectableMessage}" Margin="0,8,0,0" />
                        </Expander>
                        <Expander Header="Run actions" Margin="0,12,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="Analysis actions can take time. Replacing results and deleting runs remain separate, confirmed actions."
                                           Style="{StaticResource Caption}" Margin="0,0,0,10" />
                                <Button Content="Set as baseline" Command="{Binding Library.MarkAsBaselineCommand}" HorizontalAlignment="Left" Margin="0,0,0,10" />
                                <Grid>
                                <Button Content="Derive facts" Command="{Binding Library.DeriveFactsCommand}" HorizontalAlignment="Left" Margin="0,0,0,10"
                                        Visibility="{Binding Library.CanDerive, Converter={StaticResource Shown}}" />
                                <Button Content="Judge" Command="{Binding Library.JudgeCommand}" HorizontalAlignment="Left" Margin="0,0,0,10"
                                        Visibility="{Binding Library.CanJudge, Converter={StaticResource Shown}}" />
                                <Button Command="{Binding Library.DiscardJudgementAndJudgeAgainCommand}" Style="{StaticResource DangerButton}" Margin="0,0,0,10"
                                        Visibility="{Binding Library.CanDiscardJudgement, Converter={StaticResource Shown}}">
                                    <TextBlock Text="Discard judgement and judge again" TextWrapping="Wrap" />
                                </Button>
                                </Grid>
                                <Border Height="1" Background="{StaticResource AttributeCardBorderBrush}" Margin="0,6,0,14" />
                                <Button Content="Delete run" Command="{Binding Library.DeleteRunCommand}" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
