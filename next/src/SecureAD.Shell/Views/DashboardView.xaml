<UserControl x:Class="SecureAD.Shell.Views.DashboardView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AssetCanvasBackground}">
    <Grid>
        <TextBlock Text="Loading saved results..." Style="{StaticResource Caption}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsLoading, Converter={StaticResource Shown}}" />
        <TextBlock Text="Choose a run on Home to see what it captured." Style="{StaticResource Caption}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding HasNoRun, Converter={StaticResource Shown}}" />
        <Border Style="{StaticResource Card}" MaxWidth="620" Margin="18"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding HasRefusal, Converter={StaticResource Shown}}">
            <StackPanel>
                <TextBlock Text="{Binding Refusal.Title}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding Refusal.Detail}" TextWrapping="Wrap"
                           Foreground="{DynamicResource FaultBrush}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasRun, Converter={StaticResource Shown}}">
            <StackPanel Margin="20" MaxWidth="1600">
                <!-- A domain without a controller is not a deliberate exclusion. -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                        Background="{DynamicResource FaultSubtleBrush}" BorderBrush="{DynamicResource FaultBrush}"
                        Visibility="{Binding HasWarning, Converter={StaticResource Shown}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Warning.Title}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource FaultBrush}" />
                        <TextBlock Text="{Binding Warning.Detail}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DashboardPanel}" Background="{DynamicResource AttributeHeaderBackground}" Padding="18">
                    <StackPanel>
                        <ItemsControl ItemsPanel="{StaticResource DashboardCoverageColumns}">
                            <StackPanel Margin="0,0,24,8">
                                <TextBlock Text="Captured forest" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding ForestFqdn}" Style="{StaticResource ScreenTitle}" />
                                <TextBlock Text="Coverage and inventory" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Style="{StaticResource DashboardCoverageBadge}" Margin="0,0,0,8" HorizontalAlignment="Right">
                                <StackPanel>
                                    <TextBlock Text="{Binding DomainCoverageSummary}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Within the recorded object-class scope" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </ItemsControl>
                        <Expander Header="Capture scope and exclusions" IsExpanded="{Binding ShowsCaptureScope, Mode=TwoWay}" Margin="0,6,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{Binding CoverageHeadline}" Style="{StaticResource BaseTextBlock}" />
                                <TextBlock Text="{Binding ObjectClassScopeStatement}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                                <TextBlock Text="Domain coverage describes what the capture read. It does not mean every attribute was returned or that the directory is secure."
                                           Style="{StaticResource Caption}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                        Background="{DynamicResource FaultSubtleBrush}" BorderBrush="{DynamicResource FaultBrush}"
                        Visibility="{Binding HasCoverageLimitations, Converter={StaticResource Shown}}">
                    <StackPanel>
                        <TextBlock Text="Some captured evidence needs qualification" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Review the domain coverage and the Group Policy, membership and attribute qualifications below."
                                   Style="{StaticResource BaseTextBlock}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,18,0,8">
                    <TextBlock Text="Captured inventory" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding TotalsCover}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                </StackPanel>
                <ItemsControl ItemsPanel="{StaticResource DashboardMetricColumns}"
                              Visibility="{Binding HasTotals, Converter={StaticResource Shown}}">
                    <ItemsControl ItemsPanel="{StaticResource DashboardMetricPairColumns}">
                    <Border Style="{StaticResource DashboardMetric}"><StackPanel>
                        <TextBlock Text="Users" Style="{StaticResource DashboardMetricLabel}" />
                        <TextBlock Text="{Binding TotalUsers}" Style="{StaticResource DashboardMetricValue}" />
                    </StackPanel></Border>
                    <Border Style="{StaticResource DashboardMetric}"><StackPanel>
                        <TextBlock Text="Computers" Style="{StaticResource DashboardMetricLabel}" />
                        <TextBlock Text="{Binding TotalComputers}" Style="{StaticResource DashboardMetricValue}" />
                    </StackPanel></Border>
                    </ItemsControl>
                    <ItemsControl ItemsPanel="{StaticResource DashboardMetricPairColumns}">
                    <Border Style="{StaticResource DashboardMetric}"><StackPanel>
                        <TextBlock Text="Groups" Style="{StaticResource DashboardMetricLabel}" />
                        <TextBlock Text="{Binding TotalGroups}" Style="{StaticResource DashboardMetricValue}" />
                    </StackPanel></Border>
                    <Border Style="{StaticResource DashboardMetric}"><StackPanel>
                        <TextBlock Text="Organisational units" Style="{StaticResource DashboardMetricLabel}" />
                        <TextBlock Text="{Binding TotalOrganisationalUnits}" Style="{StaticResource DashboardMetricValue}" />
                    </StackPanel></Border>
                    </ItemsControl>
                </ItemsControl>

                <Border Style="{StaticResource DashboardPanel}" Margin="0,0,0,16">
                    <StackPanel>
                        <Border Style="{StaticResource DashboardPanelHeading}">
                            <TextBlock Text="Inventory by domain" Style="{StaticResource SectionTitle}" />
                        </Border>
                        <DataGrid x:Name="DomainInventoryTable" ItemsSource="{Binding Domains}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  CanUserDeleteRows="False" CanUserReorderColumns="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" MaxHeight="420"
                                  HorizontalGridLinesBrush="{DynamicResource AttributeCardBorderBrush}"
                                  Background="{DynamicResource AssetNavigationBackground}"
                                  BorderThickness="0" ColumnHeaderStyle="{StaticResource DashboardColumnHeader}">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="DetailsVisibility" Value="{Binding ExplanationIsShown, Converter={StaticResource Shown}}" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="12,4,12,12"
                                               Foreground="{DynamicResource FaultBrush}" />
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Domain" Binding="{Binding DomainFqdn}" Width="2*" MinWidth="160"
                                                    ElementStyle="{StaticResource DashboardCell}" />
                                <DataGridTemplateColumn Header="Capture status" Width="1.5*" MinWidth="120">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <TextBlock Text="{Binding CaptureStatus}" Style="{StaticResource DashboardStatusLabel}" Margin="8" />
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Users" Binding="{Binding Users}" Width="*" MinWidth="65"
                                                    HeaderStyle="{StaticResource DashboardNumberHeader}" ElementStyle="{StaticResource DashboardNumberCell}" />
                                <DataGridTextColumn Header="Computers" Binding="{Binding Computers}" Width="*" MinWidth="90"
                                                    HeaderStyle="{StaticResource DashboardNumberHeader}" ElementStyle="{StaticResource DashboardNumberCell}" />
                                <DataGridTextColumn Header="Groups" Binding="{Binding Groups}" Width="*" MinWidth="65"
                                                    HeaderStyle="{StaticResource DashboardNumberHeader}" ElementStyle="{StaticResource DashboardNumberCell}" />
                                <DataGridTextColumn Header="OUs" Binding="{Binding OrganisationalUnits}" Width="*" MinWidth="65"
                                                    HeaderStyle="{StaticResource DashboardNumberHeader}" ElementStyle="{StaticResource DashboardNumberCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Captured objects, not live directory counts. Uncounted domains have no figures; they are not empty domains."
                                   Style="{StaticResource Caption}" Margin="14,10" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsPanel="{StaticResource DashboardCoverageColumns}">
                    <Border Style="{StaticResource DashboardPanel}" Margin="0,0,12,12">
                        <StackPanel>
                            <Border Style="{StaticResource DashboardPanelHeading}">
                                <TextBlock Text="Group Policy coverage" Style="{StaticResource SectionTitle}" />
                            </Border>
                            <StackPanel Margin="14">
                                <TextBlock Text="{Binding PolicyCoverageSummary}" Style="{StaticResource ScreenTitle}" />
                                <ProgressBar x:Name="PolicyCoverageBar" Minimum="0" Maximum="{Binding PoliciesDeclaredCount}"
                                             Value="{Binding PoliciesReadCount, Mode=OneWay}" Height="6" Margin="0,12"
                                             Foreground="{DynamicResource AttributeSourceBrush}"
                                             Background="{DynamicResource AttributeHeaderBackground}"
                                             AutomationProperties.Name="Group Policy read coverage"
                                             Visibility="{Binding HasDeclaredPolicies, Converter={StaticResource Shown}}" />
                                <TextBlock Text="{Binding Policies}" Style="{StaticResource BaseTextBlock}" Margin="0,6,0,0" />
                                <TextBlock Text="Directory declarations and SYSVOL file evidence; not a policy-security verdict."
                                           Style="{StaticResource Caption}" Margin="0,8,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardPanel}" Margin="0,0,0,12">
                        <StackPanel>
                            <Border Style="{StaticResource DashboardPanelHeading}">
                                <TextBlock Text="Group membership coverage" Style="{StaticResource SectionTitle}" />
                            </Border>
                            <StackPanel Margin="14">
                                <TextBlock Text="{Binding MembershipSummary}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{Binding MembershipDetail}" Style="{StaticResource BaseTextBlock}" Margin="0,8,0,0" />
                                <TextBlock Text="Saved membership evidence, not a permission check or proof of a path to Tier 0."
                                           Style="{StaticResource Caption}" Margin="0,8,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ItemsControl>
                <Border Style="{StaticResource Card}"
                        Background="{DynamicResource FaultSubtleBrush}" BorderBrush="{DynamicResource FaultBrush}"
                        Visibility="{Binding HasConfidentialCaveat, Converter={StaticResource Shown}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ConfidentialCaveat.Title}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding ConfidentialCaveat.Detail}" Style="{StaticResource BaseTextBlock}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
