<UserControl x:Class="SecureAD.Shell.Views.FindingsView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SecureAD.Shell.Views">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Severity" Style="{StaticResource FieldLabel}"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding Severities}" SelectedItem="{Binding SeverityFilter,Mode=TwoWay}"
                      MinWidth="120" Margin="0,0,16,0" />
            <TextBlock Text="Rule" Style="{StaticResource FieldLabel}"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding Rules}" SelectedItem="{Binding RuleFilter,Mode=TwoWay}"
                      MinWidth="120" Margin="0,0,16,0" />
            <Button Content="Clear" Command="{Binding ClearFindingsFiltersCommand}"
                    Visibility="{Binding IsFiltered,Converter={StaticResource Shown}}" />
        </StackPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8"
                Visibility="{Binding HasTier0Summary,Converter={StaticResource Shown}}">
            <StackPanel>
                <TextBlock Text="{Binding Tier0SummaryHeading}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="Tier0FindingSummary" Text="{Binding Tier0SummaryText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <Button Content="Tier 0 overview" Command="{Binding ShowTier0OverviewCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8"
                Visibility="{Binding HasFindingsRefusal,Converter={StaticResource Shown}}">
            <StackPanel>
                <TextBlock Text="{Binding FindingsRefusal.Title}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Text="{Binding FindingsRefusal.Detail,Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>
        <TextBlock DockPanel.Dock="Top" Text="{Binding NothingFoundReason}"
                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"
                   Visibility="{Binding NothingWasFound,Converter={StaticResource Shown}}" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="{Binding FindingsPageNumber,StringFormat=Page {0}}"
                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="Previous" Command="{Binding PreviousFindingsCommand}"
                    IsEnabled="{Binding HasEarlierFindings}" Margin="0,0,8,0" />
            <Button Content="Next" Command="{Binding NextFindingsCommand}" IsEnabled="{Binding HasMoreFindings}" />
            <TextBlock Text="Double-click a finding to open its details" Margin="24,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Visibility="{Binding HasFindings,Converter={StaticResource Shown}}" />
        </StackPanel>
        <DataGrid x:Name="FindingsGrid" ItemsSource="{Binding Findings}" SelectedItem="{Binding SelectedFinding,Mode=TwoWay}"
                  views:GridRowAction.Command="{Binding OpenFindingCommand}"
                  ColumnHeaderStyle="{StaticResource TableColumnHeader}" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="Auto" />
                <DataGridTemplateColumn Header="Finding" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding FindingTitle}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Rule}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Principal" Binding="{Binding Principal}" Width="*" />
                <DataGridTextColumn Header="Affected object" Binding="{Binding Target}" Width="*" />
                <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="Auto" />
                <DataGridTextColumn Header="Coverage" Binding="{Binding Coverage}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
