<UserControl x:Class="SecureAD.Shell.Views.NotBuiltView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- What stands in for a section or view that does not exist yet.

         THIS IS ONE STEP FROM A SCREEN THAT LIES, AND THE WORDING IS THE WHOLE SAFEGUARD.
         docs/decisions/0045 left such screens out entirely, on the grounds that a screen which
         appears to report and reports nothing is worse than no screen at all. The owner reversed
         that on 2026-09-12 so the navigation can be judged before the screens exist.

         What survives of the original reasoning: this NEVER SHOWS AN EMPTY RESULT. No empty
         findings table, no zero, no grid with no rows. It names what is missing and says outright
         that it reports nothing about the directory, because an administrator looking at an empty
         findings list concludes his forest is clean. -->

    <Border Style="{StaticResource Card}"
            MaxWidth="640"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <StackPanel>
            <TextBlock Text="{Binding Name}"
                       Style="{StaticResource SectionTitle}"
                       Margin="0,0,0,8" />

            <TextBlock Text="Not built yet."
                       Foreground="{StaticResource NotEstablishedBrush}"
                       Margin="0,0,0,8" />

            <TextBlock Text="{Binding Absent}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
    </Border>
</UserControl>
