<UserControl x:Class="SecureAD.Shell.Views.ObjectView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SecureAD.Shell.Views">

    <!-- ONE OBJECT, READ RATHER THAN JUDGED.

         A HOST AND NOT A SCREEN. It shows the object's name and whichever section is selected, and
         it does not know how many sections there are: the ContentControl below binds to the
         selected section and WPF picks its template by type. Adding a section touches the catalogue
         and the template dictionary, and never this file.

         NOTHING HERE IS A VERDICT. Whether a permission is dangerous is a separate question, asked
         only when the operator asks it. -->

    <Border Background="{StaticResource AssetCanvasBackground}" CornerRadius="8"
            BorderBrush="{StaticResource AttributeCardBorderBrush}" BorderThickness="1" Padding="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MaxHeight="220" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <views:ObjectSectionList />
        </ScrollViewer>
        <Border Grid.Row="1" Style="{StaticResource ObjectSectionHeading}">
        <TextBlock
                   Text="{Binding Opened.Selected.Title}"
                   Style="{StaticResource SectionTitle}" />
        </Border>
        <Grid Grid.Row="2">
            <TextBlock Text="{Binding Opened.LoadingText}"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Visibility="{Binding Opened.IsLoading, Converter={StaticResource Shown}}" />
            <StackPanel Visibility="{Binding Opened.HasRefusal, Converter={StaticResource Shown}}">
                <TextBlock Text="{Binding Opened.Refusal.Title}" Style="{StaticResource RowTitle}" />
                <TextBox Text="{Binding Opened.Refusal.Detail, Mode=OneWay}"
                         Style="{StaticResource SelectableMessage}"
                         Foreground="{StaticResource FaultBrush}" />
            </StackPanel>
            <ContentControl Content="{Binding Opened.Content}" />
        </Grid>
    </Grid>
    </Border>
</UserControl>
