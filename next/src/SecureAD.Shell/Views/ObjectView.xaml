<UserControl x:Class="SecureAD.Shell.Views.ObjectView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ONE OBJECT, READ RATHER THAN JUDGED.

         A HOST AND NOT A SCREEN. It shows the object's name and whichever section is selected, and
         it does not know how many sections there are: the ContentControl below binds to the
         selected section and WPF picks its template by type. Adding a section touches the catalogue
         and the template dictionary, and never this file.

         THE SECTION LIST IS NOT HERE. It is the left column, where the tree was, so this half stays
         full width. See ObjectSectionList.

         NOTHING HERE IS A VERDICT. Whether a permission is dangerous is a separate question, asked
         only when the operator asks it. -->

    <DockPanel>

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding Opened.DistinguishedName}"
                   Style="{StaticResource Identifier}"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,0,0,8" />

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding Opened.Selected.Title}"
                   Style="{StaticResource SectionTitle}"
                   Margin="0,0,0,8" />

        <!-- A LINE OF TEXT HAS A READABLE LENGTH AND A WIDE MONITOR DOES NOT CHANGE IT.

             Left to fill the window, a two-column field grid put a label and its value an inch
             apart on a 2,048-pixel screen and an operator had to track across the gap for every
             one. The permissions table is exempt: it is a table, it has columns, and it uses
             every pixel it is given. -->
        <ContentControl Content="{Binding Opened.Selected}" />
    </DockPanel>
</UserControl>
