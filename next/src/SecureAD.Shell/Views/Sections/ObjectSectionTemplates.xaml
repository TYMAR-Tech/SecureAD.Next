<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:SecureAD.Shell.ViewModels"
                    xmlns:views="clr-namespace:SecureAD.Shell.Views"
                    xmlns:controls="clr-namespace:SecureAD.Shell.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../Themes/Assets.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ONE TEMPLATE PER SECTION, PICKED BY TYPE.

         The predecessor's object window is 1,311 lines holding sixteen sections in one file, each
         shown and hidden by its own visibility binding. That file is the reason a seventeenth
         section is expensive. Here the host binds a ContentControl to the selected section and WPF
         picks the template by DataType, so the host never learns how many sections there are and
         adding one touches one place.

         NOTHING HERE IS A VERDICT. No severity, no risk, no colour an administrator would read as
         a security judgement. -->

    <DataTemplate DataType="{x:Type vm:GroupMembershipSectionViewModel}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <ComboBox ItemsSource="{Binding Views}" SelectedItem="{Binding SelectedView}" Width="180" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding Qualification}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0" />
                <TextBlock Text="{Binding PrimaryGroup}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0" />
                <TextBox Text="{Binding Error,Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                         Foreground="{DynamicResource FaultBrush}" Visibility="{Binding HasError,Converter={StaticResource Shown}}" />
                <TextBlock Text="Reading captured member references..." Visibility="{Binding IsLoading,Converter={StaticResource Shown}}" />
            </StackPanel>
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock Text="{Binding PageDescription}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="Previous" Command="{Binding PreviousCommand}" Margin="0,0,8,0" />
                <Button Content="Next" Command="{Binding NextCommand}" Margin="0,0,12,0" />
                <Button Content="Open member" Command="{Binding OpenMemberCommand}" CommandParameter="{Binding SelectedMember}" />
            </WrapPanel>
            <controls:GroupInventoryGrid ItemsSource="{Binding Members}" SelectedItem="{Binding SelectedMember}"
                OpenItemCommand="{Binding OpenMemberCommand}" AutoGenerateColumns="False" IsReadOnly="True"
                HeadersVisibility="Column" CanUserSortColumns="False" Style="{StaticResource {x:Type DataGrid}}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Object" Width="2*">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <Button Content="{Binding Name}" IsEnabled="{Binding CanOpen}" HorizontalAlignment="Left"
                                Command="{Binding DataContext.OpenMemberCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                CommandParameter="{Binding}" Margin="3" />
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="*" />
                    <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="*" />
                    <DataGridTextColumn Header="Recorded reference" Binding="{Binding RecordedName}" Width="2*" />
                </DataGrid.Columns>
            </controls:GroupInventoryGrid>
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SavedTier0PathSectionViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <StackPanel.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlock}">
                        <Setter Property="TextWrapping" Value="Wrap" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </StackPanel.Resources>
                <Button HorizontalAlignment="Left" Margin="0,0,0,10"
                        Command="{Binding DataContext.ShowObjectFindingsCommand,RelativeSource={RelativeSource AncestorType=views:ObjectView}}">
                    <TextBlock Text="View this object's findings" TextWrapping="Wrap" />
                </Button>
                <StackPanel Visibility="{Binding HasRoutes,Converter={StaticResource Shown}}">
                    <Border Background="{DynamicResource FaultSubtleBrush}"
                            BorderBrush="{DynamicResource FaultBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Routes.Classification,StringFormat='Tier 0 classification: {0}. Reachability is a separate saved result.'}"
                                   TextWrapping="Wrap" />
                    </Border>
                    <WrapPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,12" Width="380">
                            <StackPanel>
                                <TextBlock Text="Shortest supported distance" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Routes.Distance}" FontSize="24" />
                                <TextBlock Text="{Binding Routes.Minimum}" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Width="380">
                            <StackPanel>
                                <TextBlock Text="Best-supported route" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Routes.Best}" FontSize="20" />
                                <TextBlock Text="{Binding Routes.Explanation}" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <CheckBox IsChecked="{Binding ShowShortest}" Margin="0,0,0,12">
                        <TextBlock Text="Show shortest supported route instead of best-supported route" TextWrapping="Wrap" />
                    </CheckBox>
                    <ItemsControl ItemsSource="{Binding SelectedSteps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource AttributeCardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding SelectedConditions}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <Expander Margin="0,8,0,12">
                        <Expander.Header><TextBlock Text="Saved grade and coverage" TextWrapping="Wrap" /></Expander.Header>
                        <StackPanel Margin="8">
                            <TextBlock Text="{Binding Routes.Grade}" />
                            <TextBlock Text="{Binding Routes.GradingCoverage}" />
                            <TextBlock Text="{Binding Routes.Coverage}" />
                            <TextBlock Text="Proof grades do not attest live access, a current access token or complete forest coverage." />
                        </StackPanel>
                    </Expander>
                    <Border Style="{StaticResource Card}" Margin="0,4,0,10">
                        <StackPanel>
                            <TextBlock Text="Existing assessed results" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Saved permission, requester, membership and ownership results remain separate from a completed Tier 0 route."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="SavedPathResult" Text="{Binding Result}" FontWeight="SemiBold" />
                <TextBlock x:Name="SavedPathSeverity" Text="{Binding Severity}" />
                <TextBlock Text="{Binding Detail}" />
                <TextBlock Text="{Binding Boundary}" />
                <ItemsControl ItemsSource="{Binding Groups}" />
                <TextBlock Text="{Binding CoverageHeading}" FontWeight="SemiBold" Margin="0,16,0,8" />
                <TextBlock x:Name="SavedPathChecks" Text="{Binding AutomaticChecks}" />
                <TextBlock Text="{Binding Scope}" />
                <ItemsControl x:Name="SavedPathLimitations" ItemsSource="{Binding Limitations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Expander x:Name="SavedPathRecordDetails" IsExpanded="False" Margin="0,8,0,0">
                    <Expander.Style>
                        <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRecordDetails}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Expander.Style>
                    <Expander.Header><TextBlock Text="{Binding RecordDetailsHeading}" TextWrapping="Wrap" /></Expander.Header>
                    <StackPanel Margin="8">
                        <TextBlock x:Name="SavedPathProvenance" Text="{Binding Provenance}" />
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SavedPathGroupViewModel}">
                                    <ItemsControl ItemsSource="{Binding Questions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SavedPathQuestionViewModel}">
                                                <StackPanel Margin="0,8,0,8">
                                                    <TextBlock Text="{Binding Heading}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                    <ItemsControl x:Name="SavedPathRecordFields" ItemsSource="{Binding RecordDetails}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SavedPathGroupViewModel}">
        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,8,0,8">
            <Expander.Header><TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" /></Expander.Header>
            <StackPanel Margin="8">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Questions}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding PageNumber, StringFormat=Page {0}}" TextWrapping="Wrap" Margin="0,0,12,0" />
                    <Button Command="{Binding PreviousCommand}" IsEnabled="{Binding HasPrevious}" Margin="0,0,8,0">
                        <TextBlock Text="Previous" TextWrapping="Wrap" />
                    </Button>
                    <Button Command="{Binding NextCommand}" IsEnabled="{Binding HasNext}">
                        <TextBlock Text="Next" TextWrapping="Wrap" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Expander>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SavedPathQuestionViewModel}">
        <StackPanel Margin="0,0,0,16">
            <StackPanel.Resources>
                <Style x:Key="RecommendationBlock" TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRecommendation}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Resources>
            <TextBlock x:Name="SavedPermissionHeadline" Text="{Binding Heading}" TextWrapping="Wrap" FontWeight="SemiBold" />
            <StackPanel Style="{StaticResource RecommendationBlock}">
                <TextBlock Text="{Binding RecommendationHeading}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,4" />
                <TextBlock x:Name="SavedPermissionChange" Text="{Binding RecommendedChange}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding WhereHeading}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,4" />
                <TextBlock x:Name="SavedPermissionWhere" Text="{Binding WhereToChange}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{Binding ExplanationHeading}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,4" />
            <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" />
            <StackPanel Style="{StaticResource RecommendationBlock}">
                <TextBlock Text="{Binding RecommendationBoundaryHeading}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,4" />
                <TextBlock Text="{Binding RecommendationBoundary}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{Binding PermissionDetailsHeading}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,12,0,4" />
            <ItemsControl x:Name="SavedPermissionFields" ItemsSource="{Binding PermissionDetails}" />
            <TextBlock Text="{Binding Membership}" TextWrapping="Wrap" />
            <ItemsControl x:Name="SavedPathSteps" ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SavedPathStepViewModel}">
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl x:Name="SavedPermissionEntries" ItemsSource="{Binding Entries}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SavedPathFieldViewModel}">
        <StackPanel Margin="0,0,0,8">
            <TextBlock Text="{Binding Label, StringFormat={}{0}:}" TextWrapping="Wrap" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ControlEdgesSectionViewModel}">
        <DataTemplate.Resources>
            <Style x:Key="ControlStatusChip" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource AttributeHeaderBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AttributeCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="7,3" />
                <Setter Property="Margin" Value="0,0,6,6" />
            </Style>
        </DataTemplate.Resources>
        <ScrollViewer x:Name="ControlEdgesScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <views:BindingProxy x:Key="ControlSection" Data="{Binding}" />
                <CollectionViewSource x:Key="GroupedControlRows" Source="{Binding VisibleRows}">
                    <CollectionViewSource.GroupDescriptions>
                        <PropertyGroupDescription PropertyName="Group" />
                    </CollectionViewSource.GroupDescriptions>
                </CollectionViewSource>
            </ScrollViewer.Resources>
            <StackPanel>
                <Border Background="{DynamicResource AttributeHeaderBackground}"
                        BorderBrush="{DynamicResource AttributeCardBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="1" Margin="0,0,0,8">
                    <DockPanel>
                        <UniformGrid Rows="1" HorizontalAlignment="Left">
                            <RadioButton Content="{Binding OnObjectQuestion}" GroupName="ControlDirection"
                                         Style="{StaticResource BrowsingScopeSegment}"
                                         IsChecked="{Binding ShowsEdgesOnObject,Mode=TwoWay}" />
                            <RadioButton Content="{Binding HeldByObjectQuestion}" GroupName="ControlDirection"
                                         Style="{StaticResource BrowsingScopeSegment}"
                                         IsChecked="{Binding ShowsEdgesHeldByObject,Mode=TwoWay}"
                                         IsEnabled="{Binding HasPrincipal}" />
                        </UniformGrid>
                    </DockPanel>
                </Border>

                <WrapPanel Margin="0,0,0,4">
                    <Border Style="{StaticResource ControlStatusChip}"><TextBlock Text="{Binding AnalysisSummary}" /></Border>
                    <Border Style="{StaticResource ControlStatusChip}"><TextBlock Text="{Binding CaptureSummary}" /></Border>
                    <Border Style="{StaticResource ControlStatusChip}"><TextBlock Text="{Binding UnexpectedSummary}" /></Border>
                    <Border Style="{StaticResource ControlStatusChip}"><TextBlock Text="{Binding ExpectednessUnknownSummary}" /></Border>
                    <Border Style="{StaticResource ControlStatusChip}"><TextBlock Text="{Binding ExpectedSummary}" /></Border>
                </WrapPanel>
                <Border Background="{DynamicResource FaultSubtleBrush}" BorderBrush="{DynamicResource FaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,0,0,8"
                        Visibility="{Binding HasCoverageWarning,Converter={StaticResource Shown}}">
                    <TextBlock Text="{Binding Coverage}" TextWrapping="Wrap" />
                </Border>

                <controls:AdaptiveDetailPanel x:Name="ControlDetailLayout"
                                              Breakpoint="1050" Gap="12" Margin="0,0,0,10">
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{DynamicResource AttributeHeaderBackground}"
                                    Padding="10,8" CornerRadius="6,6,0,0">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Content="Show expected"
                                              IsChecked="{Binding IncludeExpected}" Margin="12,0,0,0" />
                                    <TextBox Text="{Binding EdgeSearchText,UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Search the displayed page by holder, target or capability" />
                                </DockPanel>
                            </Border>
                            <WrapPanel DockPanel.Dock="Bottom" Margin="10">
                                <Button Content="First page" Command="{Binding FirstPageCommand}" Margin="0,0,8,0" />
                                <Button Content="Next page" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasMore}" />
                            </WrapPanel>
                            <StackPanel x:Name="DirectHolderEmptyState"
                                        DockPanel.Dock="Bottom" Margin="10"
                                        Visibility="{Binding ShowsDirectHolderEmptyState,Converter={StaticResource Shown}}">
                                <TextBlock Text="{Binding DirectHolderEmptyHeading}"
                                           FontWeight="{StaticResource EmphasisFontWeight}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding DirectHolderEmptyDetail}"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock x:Name="DirectHolderMembershipStatus"
                                           Text="{Binding ThroughMembershipCoverage}"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Bottom"
                                       Text="No control edges are displayed on this page. This does not establish that no supported control exists."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="10"
                                       Visibility="{Binding ShowsGenericEmptyState,Converter={StaticResource Shown}}" />
                            <DataGrid x:Name="ControlPermissions"
                                      ItemsSource="{Binding Source={StaticResource GroupedControlRows}}"
                                      SelectedItem="{Binding SelectedEdge}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      MinHeight="150" MaxHeight="320" BorderThickness="0">
                                <DataGrid.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap"
                                                           FontWeight="SemiBold" Margin="6,5">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlock}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Name}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </DataGrid.GroupStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Holder" Binding="{Binding Holder}" Width="2*" MinWidth="170"
                                                        Visibility="{Binding Data.ShowsHolderColumn,Source={StaticResource ControlSection},Converter={StaticResource Shown}}" />
                                    <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="2*" MinWidth="170"
                                                        Visibility="{Binding Data.ShowsTargetColumn,Source={StaticResource ControlSection},Converter={StaticResource Shown}}" />
                                    <DataGridTextColumn Header="Capability" Binding="{Binding Capability}" Width="2*" MinWidth="190" />
                                    <DataGridTextColumn Header="Support" Binding="{Binding Evaluation}" Width="Auto" MinWidth="105" />
                                    <DataGridTextColumn Header="Expectedness" Binding="{Binding Expectedness}" Width="Auto" MinWidth="115" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="0">
                        <StackPanel>
                            <Border Background="{DynamicResource AttributeHeaderBackground}"
                                    Padding="10,8" CornerRadius="6,6,0,0">
                                <TextBlock Text="Why this control relationship exists" Style="{StaticResource RowTitle}" />
                            </Border>
                            <UniformGrid Rows="1">
                                <RadioButton Content="Evidence" GroupName="ControlDetails"
                                             Style="{StaticResource BrowsingScopeSegment}"
                                             IsChecked="{Binding ShowsEvidenceDetails,Mode=TwoWay}" />
                                <RadioButton Content="Requester check" GroupName="ControlDetails"
                                             Style="{StaticResource BrowsingScopeSegment}"
                                             IsChecked="{Binding ShowsRequesterDetails,Mode=TwoWay}" />
                                <RadioButton Content="Membership" GroupName="ControlDetails"
                                             Style="{StaticResource BrowsingScopeSegment}"
                                             IsChecked="{Binding ShowsMembershipDetails,Mode=TwoWay}" />
                            </UniformGrid>
                            <Grid Margin="10">
                                <StackPanel Visibility="{Binding ShowsEvidenceDetails,Converter={StaticResource Shown}}">
                                    <TextBlock Text="Saved permission support" Style="{StaticResource RowTitle}" Margin="0,0,0,5" />
                                    <Grid Margin="0,0,0,7" Visibility="{Binding HasSelectedEdge,Converter={StaticResource Shown}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Holder" Style="{StaticResource Caption}" Margin="0,0,10,3" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedEdge.Holder}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="1" Text="Capability" Style="{StaticResource Caption}" Margin="0,0,10,3" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedEdge.Capability}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="2" Text="Support" Style="{StaticResource Caption}" Margin="0,0,10,3" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedEdge.Evaluation}" />
                                        <TextBlock Grid.Row="3" Text="Expectedness" Style="{StaticResource Caption}" Margin="0,0,10,0" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedEdge.Expectedness}" />
                                    </Grid>
                                    <TextBlock Text="{Binding SelectedEdge.CountStatus}" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <TextBlock Text="Select a saved edge to inspect its original permission proof and preconditions."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               Visibility="{Binding HasNoSelectedEdge,Converter={StaticResource Shown}}" />
                                    <Expander x:Name="ControlEvidence" Header="Original permission proof"
                                              Visibility="{Binding HasSelectedEdge,Converter={StaticResource Shown}}">
                                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                            <TextBox Text="{Binding SelectedEdge.Evidence,Mode=OneWay}"
                                                     Style="{StaticResource SelectableMessage}" />
                                        </ScrollViewer>
                                    </Expander>
                                </StackPanel>

                                <StackPanel Visibility="{Binding ShowsRequesterDetails,Converter={StaticResource Shown}}">
                                    <TextBlock Text="{Binding RequesterCoverage}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <DataGrid x:Name="RequesterAssessmentsTable"
                                              ItemsSource="{Binding RequesterAssessments}"
                                              SelectedItem="{Binding SelectedRequesterAssessment,Mode=TwoWay}"
                                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                              MaxHeight="210">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Requester" Binding="{Binding Requester}" Width="*" MinWidth="150" />
                                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="*" MinWidth="150" />
                                            <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="Auto" />
                                            <DataGridTextColumn Header="Authorized?" Binding="{Binding Authorization}" Width="Auto" />
                                            <DataGridTextColumn Header="Own account?" Binding="{Binding OwnAccount}" Width="Auto" />
                                            <DataGridTextColumn Header="Ready?" Binding="{Binding Readiness}" Width="Auto" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Expander x:Name="RequesterEvidence"
                                              Header="{Binding SelectedRequesterAssessment.EvidenceHeader}" Margin="0,8,0,0">
                                        <Expander.Style>
                                            <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedRequesterAssessment}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Expander.Style>
                                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                            <TextBox Text="{Binding SelectedRequesterAssessment.Evidence,Mode=OneWay}"
                                                     Style="{StaticResource SelectableMessage}" />
                                        </ScrollViewer>
                                    </Expander>
                                </StackPanel>

                                <StackPanel Visibility="{Binding ShowsMembershipDetails,Converter={StaticResource Shown}}">
                                    <StackPanel DataContext="{Binding MemberPanel}">
                                        <TextBlock Text="{Binding Heading}" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="{Binding Counting}" TextWrapping="Wrap" Margin="0,4,0,4" />
                                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                                        <Expander x:Name="MemberEvidence" Header="{Binding RoutesHeading}" Margin="0,6,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding RoutesCaveat}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Showing}" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                                    <Button Content="{Binding FirstPageLabel}" Command="{Binding FirstPageCommand}" Margin="0,0,8,0" />
                                                    <Button Content="{Binding NextPageLabel}" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasMore}" />
                                                </StackPanel>
                                                <DataGrid x:Name="MemberPrincipals"
                                                          ItemsSource="{Binding Rows}"
                                                          SelectedItem="{Binding SelectedRow,Mode=TwoWay}"
                                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                                          MaxHeight="220">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Member" Binding="{Binding Member}" Width="*" />
                                                        <DataGridTextColumn Header="Identity" Binding="{Binding IdentityStatus}" Width="*" />
                                                        <DataGridTextColumn Header="Routes" Binding="{Binding Routes}" Width="2*" />
                                                        <DataGridTextColumn Header="Applicability" Binding="{Binding Applicability}" Width="2*" />
                                                        <DataGridTextColumn Header="Account" Binding="{Binding AccountStatus}" Width="*" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <TextBox Text="{Binding SelectedRow.Routes,Mode=OneWay}"
                                                         Style="{StaticResource SelectableMessage}" MaxHeight="160"
                                                         VerticalScrollBarVisibility="Auto" />
                                                <TextBox Text="{Binding Evidence,Mode=OneWay}"
                                                         Style="{StaticResource SelectableMessage}" MaxHeight="160"
                                                         VerticalScrollBarVisibility="Auto" />
                                            </StackPanel>
                                        </Expander>
                                        <TextBlock Text="{Binding Caveat}" Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Expander x:Name="ThroughMembershipEvidence"
                                              Header="{Binding ThroughMembershipHeading}" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ThroughMembershipCoverage}" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                <Button Content="{Binding MemberPanel.FirstPageLabel}"
                                                        Command="{Binding FirstMembershipPermissionPageCommand}" Margin="0,0,8,0" />
                                                <Button Content="{Binding MemberPanel.NextPageLabel}"
                                                        Command="{Binding NextMembershipPermissionPageCommand}"
                                                        IsEnabled="{Binding HasMoreThroughMembership}" />
                                            </StackPanel>
                                            <DataGrid x:Name="GroupPermissionReferences"
                                                      ItemsSource="{Binding ThroughMembership}"
                                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                                      MaxHeight="220">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Holder" Binding="{Binding HolderSid}" Width="*" />
                                                    <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="2*" />
                                                    <DataGridTextColumn Header="Capability" Binding="{Binding Capability}" Width="*" />
                                                    <DataGridTextColumn Header="Membership" Binding="{Binding Membership}" Width="*" />
                                                    <DataGridTextColumn Header="Applicability" Binding="{Binding ResourceApplicability}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <TextBlock Text="{Binding MemberPanel.Caveat}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </controls:AdaptiveDetailPanel>

            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ObjectHelpSectionViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="{DynamicResource AttributeHeaderBackground}"
                        BorderBrush="{DynamicResource AttributeCardBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Help for object details" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Definitions and calculation boundaries live here so the data tabs can stay focused on saved results."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <controls:AdaptiveDetailPanel Breakpoint="1000" Gap="10">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="What Control edges answers" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Who can control this object, and what can this principal control? Each row is a saved permission-derived relationship, not a completed operation."
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Support" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Established means captured evidence supports the capability. Not established means the supported case was disproved. Unknown means evidence or analysis remains unresolved."
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </controls:AdaptiveDetailPanel>
                <controls:AdaptiveDetailPanel Breakpoint="1000" Gap="10" Margin="0,10,0,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Expectedness" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Expected means the relationship matches a recognized administrative pattern. It does not mean safe. Unknown expectedness is separate from unknown permission support."
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Evidence, requester and membership" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Permission proof, a concrete account's authorization check and stored group membership answer different questions. Membership alone does not prove requester authorization."
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </controls:AdaptiveDetailPanel>
                <controls:AdaptiveDetailPanel Breakpoint="1000" Gap="10" Margin="0,10,0,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Coverage" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Incomplete capture, unsupported analysis and processing that was not scheduled are shown separately. None of them means no control exists."
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Not a Tier 0 path" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="A control edge is one building block. The separate Tier 0 tab shows whether supported relationships were chained to a qualified Tier 0 target."
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </controls:AdaptiveDetailPanel>
                <Expander Header="How control relationships are counted" Margin="0,10,0,0">
                    <StackPanel Margin="8">
                        <TextBlock Text="One group-held permission remains one permission relationship. Member attribution, requester checks and later routes are supporting answers and are not added to that permission count."
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Full-control summaries may group supporting permissions without deleting their original evidence."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding SupportedControlScope}" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ONE FIELD: THE LABEL ABOVE THE VALUE, AND THE STORED FORM UNDER BOTH.

         Label above rather than beside, because that is what lets fields sit two to a row without
         a label column wide enough for "Protected by AdminSDHolder" wasting half the width of
         every other row. Seen on screen 2026-08-20 at a fixed 180: that label was cut mid-word.

         A worded value is this product's reading of what the directory holds, and a wrong reading
         does not look wrong - it looks like a confident statement about the object. So the field
         carries the attribute's own name and, whenever the wording differs from what was stored,
         the stored form beneath it. That is what makes an answer here checkable against ldp.exe
         instead of merely believable.

         An attribute with no value says so in the product's quiet ink and says nothing about the
         object: the directory omits an absent attribute without saying whether the caller was
         refused it (docs/decisions/0022). -->
    <DataTemplate DataType="{x:Type vm:AttributeValueViewModel}">
        <Border x:Name="AttributeCardSurface" Style="{StaticResource AttributeCard}">
        <StackPanel>
            <Border x:Name="AttributeCardHeader" Background="{DynamicResource AttributeHeaderBackground}"
                    Padding="14,9" CornerRadius="7,7,0,0"
                    BorderBrush="{DynamicResource AttributeCardBorderBrush}" BorderThickness="0,0,0,1">
                <TextBlock x:Name="AttributeTitle" Style="{StaticResource AttributeCardLabel}">
                    <Run Text="{Binding Label, Mode=OneWay}" /><Run Text="{Binding AttributeCaption, Mode=OneWay}"
                         FontFamily="{StaticResource IdentifierFontFamily}"
                         FontSize="{StaticResource CaptionFontSize}" FontWeight="Normal"
                         Foreground="{DynamicResource AttributeSourceBrush}" />
                </TextBlock>
            </Border>

            <StackPanel Margin="14,10,14,12">
            <TextBox x:Name="AttributeValue" Text="{Binding Worded, Mode=OneWay}"
                     Style="{StaticResource AttributeCardValue}" />

            <!-- Shown only when the wording is not the stored value, so a field that was not
                 interpreted does not print itself twice. Monospaced, because a SID or a GUID is
                 read character by character and compared by eye. -->
            <TextBox x:Name="AttributeStored" Text="{Binding Stored, Mode=OneWay}"
                     Style="{StaticResource SelectableMessage}"
                     Margin="0,1,0,0"
                     FontFamily="{StaticResource IdentifierFontFamily}"
                     FontSize="{StaticResource CaptionFontSize}"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     Visibility="{Binding IsInterpreted, Converter={StaticResource Shown}}" />

            <!-- What a reader must know before drawing a conclusion. lastLogonTimestamp is
                 designed to be days out of date, and a dormant-account judgement made without
                 knowing that is wrong by up to a fortnight. Said on the row, not in a manual.

                 Ruled down its left edge so it reads as an aside about the value above rather than
                 as more of the value. It is the longest thing in any field and was the reason the
                 old panel inflated every other one. -->
            <Border Margin="0,5,0,0" Padding="8,0,0,0"
                    BorderThickness="2,0,0,0"
                    BorderBrush="{DynamicResource NotEstablishedSubtleBrush}"
                    Visibility="{Binding HasCaveat, Converter={StaticResource Shown}}">
                <TextBlock x:Name="AttributeCaveat" Text="{Binding Caveat}" TextWrapping="Wrap"
                           FontSize="{StaticResource CaptionFontSize}"
                           Foreground="{DynamicResource NotEstablishedBrush}" />
            </Border>
            </StackPanel>
        </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Column count follows available space; a long caveat only enlarges its own row. -->
    <ItemsPanelTemplate x:Key="FieldColumns">
        <views:FieldGrid Columns="3" MinimumColumnWidth="340" />
    </ItemsPanelTemplate>

    <DataTemplate x:Key="AttributeCards" DataType="{x:Type vm:AttributeCardsViewModel}">
        <StackPanel>
            <CheckBox Content="Show missing attributes" Style="{StaticResource MissingAttributeToggle}"
                      IsChecked="{Binding ShowMissingAttributes, Mode=TwoWay}"
                      Margin="0,0,0,12" Visibility="{Binding HasMissingAttributes, Converter={StaticResource Shown}}" />
            <ItemsControl ItemsSource="{Binding VisibleValues}" ItemsPanel="{StaticResource FieldColumns}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:OverviewSectionViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <Border Background="{DynamicResource AttributeHeaderBackground}"
                    BorderBrush="{DynamicResource AttributeCardBorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,10">
                <WrapPanel>
                    <TextBlock Text="{Binding ObjectType}" FontWeight="SemiBold" Margin="0,0,18,0" />
                    <TextBlock Text="{Binding EntryCount,StringFormat={}{0} captured permission entries}"
                               Foreground="{DynamicResource AttributeSourceBrush}" />
                </WrapPanel>
            </Border>

            <views:FieldGrid Columns="2" MinimumColumnWidth="440">
                <Border Style="{StaticResource Card}" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="Identity &amp; ownership" Style="{StaticResource RowTitle}" Margin="0,0,0,8" />
                        <TextBlock Text="Owner (nTSecurityDescriptor)" Style="{StaticResource FieldLabel}"
                                   Width="Auto" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding Owner}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding OwnerQualification}" Style="{StaticResource Caption}"
                                   Margin="0,3,0,10" TextWrapping="Wrap"
                                   Visibility="{Binding HasOwnerQualification,Converter={StaticResource Shown}}" />
                        <ContentControl Content="{Binding IdentityCards}" ContentTemplate="{StaticResource AttributeCards}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Account state &amp; activity" Style="{StaticResource RowTitle}" Margin="0,0,0,8" />
                        <ContentControl Content="{Binding ActivityCards}" ContentTemplate="{StaticResource AttributeCards}" />
                        <StackPanel DataContext="{Binding Account}" Visibility="{Binding HasAccount,Converter={StaticResource Shown}}">
                            <ItemsControl ItemsSource="{Binding Flags}">
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" /></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding UnwordedBits}" TextWrapping="Wrap"
                                       Visibility="{Binding HasUnwordedBits,Converter={StaticResource Shown}}" />
                            <TextBlock Text="{Binding Emptiness.Detail}" TextWrapping="Wrap"
                                       Visibility="{Binding HasEmptiness,Converter={StaticResource Shown}}" />
                        </StackPanel>
                        <TextBlock Text="The adminCount marker alone does not establish current AdminSDHolder protection."
                                   Style="{StaticResource Caption}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </views:FieldGrid>
        </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- THE SEVEN SECTIONS THAT ARE THEIR ATTRIBUTES. One template, because they are one shape:
         every value the catalogue says the section is answerable for, and a plain statement when
         the bundle holds none of them.

         A SECTION WITH NOTHING IN IT STILL APPEARS, and says which silence it is. Hiding an empty
         Delegation section would hide "we were refused this" behind "there is nothing here", and
         the directory does not let a reader tell those apart. -->
    <DataTemplate DataType="{x:Type vm:AttributeSectionViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <ContentControl Content="{Binding Cards}" ContentTemplate="{StaticResource AttributeCards}" />

            <Border Style="{StaticResource Card}"
                    Visibility="{Binding HasEmptiness, Converter={StaticResource Shown}}">
                <StackPanel>
                    <TextBlock Text="{Binding Emptiness.Title}" Style="{StaticResource RowTitle}" />
                    <TextBox Text="{Binding Emptiness.Detail, Mode=OneWay}"
                             Style="{StaticResource SelectableMessage}"
                             Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- THE POLICIES LINKED TO A CONTAINER, STRONGEST FIRST.

         Sorted by precedence rather than shown in the order the attribute stores them, because
         precedence is the question. Microsoft: the links are read left to right and applied in
         reverse, so the last one in the string wins. Both numbers are on the row, so an operator
         reading the raw attribute beside this can still follow it.

         THE OPTIONS ARE NOT WORDED. A link can be disabled or enforced and both matter, but the
         attribute's own page does not give the values, and this product does not word a bit it has
         not seen documented. -->
    <DataTemplate DataType="{x:Type vm:PolicyLinksSectionViewModel}">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                    Visibility="{Binding HasLinks, Converter={StaticResource Shown}}">
                <StackPanel>
                    <TextBlock Text="Linked policies, strongest first"
                               Style="{StaticResource RowTitle}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Links}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Precedence}"
                                               Style="{StaticResource RowTitle}"
                                               Margin="0,0,12,0" MinWidth="24" />

                                    <StackPanel Grid.Column="1">
                                        <TextBox Text="{Binding DistinguishedName, Mode=OneWay}"
                                                 Style="{StaticResource SelectableMessage}"
                                                 FontFamily="{StaticResource IdentifierFontFamily}"
                                                 Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="stored as link "
                                                       FontSize="{StaticResource CaptionFontSize}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding Order}"
                                                       FontSize="{StaticResource CaptionFontSize}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text=", options "
                                                       FontSize="{StaticResource CaptionFontSize}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding Options}"
                                                       FontSize="{StaticResource CaptionFontSize}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text=" (not worded by this build)"
                                                       FontSize="{StaticResource CaptionFontSize}"
                                                       Foreground="{DynamicResource NotEstablishedBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                    Visibility="{Binding HasErrors, Converter={StaticResource Shown}}">
                <StackPanel>
                    <TextBlock Text="This value did not read cleanly"
                               Style="{StaticResource RowTitle}" />
                    <ItemsControl ItemsSource="{Binding Errors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Mode=OneWay}"
                                         Style="{StaticResource SelectableMessage}"
                                         Foreground="{DynamicResource FaultBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                    Visibility="{Binding HasEmptiness, Converter={StaticResource Shown}}">
                <StackPanel>
                    <TextBlock Text="{Binding Emptiness.Title}" Style="{StaticResource RowTitle}" />
                    <TextBox Text="{Binding Emptiness.Detail, Mode=OneWay}"
                             Style="{StaticResource SelectableMessage}"
                             Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <ContentControl Content="{Binding Cards}" ContentTemplate="{StaticResource AttributeCards}" />
            </Border>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:PermissionsSectionViewModel}">
        <DockPanel>

            <DockPanel.Resources>
                <!-- A DataGridColumn is not part of the visual tree, so a binding on one cannot
                     walk up to this section. The proxy carries the section to it. -->
                <views:BindingProxy x:Key="Section" Data="{Binding}" />
            </DockPanel.Resources>

            <!-- THE STRIP SAYS WHAT IT HAS NOT COUNTED.

                 Nothing here renders a zero where nothing has looked (0002). Of the two ways to
                 read a "Dangerous 0", the wrong one is the reassuring one, and an auditor who
                 reads it off an object nobody classified stops looking. A counter with nothing
                 behind it shows an em dash, says "not computed" underneath, and explains why in
                 its tooltip.

                 CONTROL AND FINDINGS CAN NEVER BE COMPUTED BY THIS BUILD. A control edge is
                 derived across a whole forest and a finding is a rule's verdict; neither layer
                 exists. They are shown anyway, because a strip that quietly left them off would
                 make the object look fully assessed. -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                <DockPanel>
                    <ItemsControl ItemsSource="{Binding Counters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,28,0" ToolTip="{Binding Explanation}">
                                    <TextBlock Text="{Binding Display}"
                                               Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="{StaticResource CaptionFontSize}"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />

                                    <!-- The dash alone is a thing to guess at, so the absence is
                                         also stated in words. -->
                                    <TextBlock Text="{Binding Status}"
                                               FontSize="{StaticResource CaptionFontSize}"
                                               Foreground="{DynamicResource NotEstablishedBrush}"
                                               Visibility="{Binding IsNotComputed, Converter={StaticResource Shown}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>


            <!-- NOTHING RENDERS AN EMPTY TABLE. A null list grants everyone everything, an empty
                 one grants nobody anything, an unreadable one is unknown, and a run that never
                 asked is a fourth thing. All four produce no entries, and one of them is the most
                 open object in the forest. -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12"
                    Visibility="{Binding IsEmpty, Converter={StaticResource Shown}}">
                <StackPanel>
                    <TextBlock Text="{Binding Emptiness.Title}" Style="{StaticResource RowTitle}" />
                    <TextBox Text="{Binding Emptiness.Detail, Mode=OneWay}"
                             Style="{StaticResource SelectableMessage}"
                             Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>

            <!-- What is true of the list as a whole. Every one of these is a reason the list reads
                 shorter or safer than the object is, and the predecessor showed none of them. -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12"
                    Visibility="{Binding HasStatements, Converter={StaticResource Shown}}">
                <ItemsControl ItemsSource="{Binding Statements}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12"
                    Visibility="{Binding HasErrors, Converter={StaticResource Shown}}">
                <StackPanel>
                    <TextBlock Text="This descriptor did not read cleanly"
                               Style="{StaticResource RowTitle}" />
                    <ItemsControl ItemsSource="{Binding Errors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Mode=OneWay}"
                                         Style="{StaticResource SelectableMessage}"
                                         Foreground="{DynamicResource FaultBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Top" Background="{DynamicResource AttributeHeaderBackground}"
                    BorderBrush="{DynamicResource AttributeCardBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="10" Margin="0,0,0,10">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Content="Highlight saved risky readings"
                              IsChecked="{Binding HighlightRiskyPermissions,Mode=TwoWay}"
                              ToolTip="{Binding HighlightHelp}" Margin="14,0,0,0" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Width="150" Margin="10,0,0,0">
                        <TextBlock Text="Type" Style="{StaticResource Caption}" />
                        <ComboBox ItemsSource="{Binding PermissionTypeChoices}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding PermissionTypeFilter}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Search principal or permission" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding PermissionSearchText,UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- PRINCIPAL ON THE LEFT, THEIR ENTRIES ON THE RIGHT.

                 Reversed from the grouped table of 2026-08-20, on the owner's judgement having
                 seen both. That decision rejected two panes because two panes plus the directory
                 tree left no room for an entry table on a laptop. The object view took the tree's
                 place, so the premise is gone: this half is now the full width of the window.

                 The question an administrator is asking is WHO CAN DO WHAT TO THIS OBJECT, and it
                 is asked one principal at a time. Reading left to right answers it in that order.

                 EACH PRINCIPAL CARRIES ROUGHLY WHAT THEY HOLD, so the column answers the question
                 at a glance and the pane on the right answers it exactly. A list of bare names
                 makes an operator click through twenty principals to find the one that matters. -->
            <TabControl>
                <TabItem Header="A - Principal reading pane">
            <Grid Margin="0,8,0,0">
                <!-- THE DIVIDER MOVES. The principal column was fixed at 340px, chosen for a
                     laptop, and an operator on a wide screen could not reclaim it for the
                     entry table where the long text actually is. MinWidth on both sides so
                     neither pane can be dragged shut - a pane collapsed to nothing reads as
                     a screen that has lost its data. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" MinWidth="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <ListBox Grid.Column="0"
                         ItemsSource="{Binding VisiblePrincipals}"
                         SelectedItem="{Binding SelectedPrincipal, Mode=TwoWay}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding HasVisiblePrincipals, Converter={StaticResource Shown}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="8,6" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Principal}"
                                               Style="{StaticResource RowTitle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Domain}"
                                               FontSize="{StaticResource CaptionFontSize}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding VisibleRightsSummary}" TextWrapping="Wrap"
                                               Margin="0,2,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding VisibleEntryCount}"
                                           Margin="8,0,0,0" VerticalAlignment="Top"
                                           FontSize="{StaticResource CaptionFontSize}"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <GridSplitter Grid.Column="1" Width="6"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent"
                              ResizeBehavior="PreviousAndNext"
                              ToolTip="Drag to resize" />

                <DockPanel Grid.Column="2" DataContext="{Binding SelectedPrincipal}">

                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Principal}"
                                   Style="{StaticResource SectionTitle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Domain}"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>

                    <!-- Why a principal has no name. The predecessor showed a bare
                         S-1-5-21-...-25601 holding Full Control with no explanation; it was an
                         orphaned identifier. -->
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Unresolved}" TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource NotEstablishedBrush}"
                               Visibility="{Binding IsUnresolved, Converter={StaticResource Shown}}" />

                    <!-- COLUMNS RESIZE AND REORDER. What matters on this table differs by
                         the question being asked: somebody auditing inheritance wants that
                         column wide, somebody reading rights wants the first one. Both are
                         on by default in WPF and both are stated here so neither is lost to
                         a later edit that sets one of them.

                         Rows size to their content because Right and Scope both wrap, and a
                         fixed row height clips a wrapped cell without any sign it did. -->
                    <DataGrid ItemsSource="{Binding VisibleEntries}"
                              ColumnHeaderStyle="{StaticResource TableColumnHeader}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              CanUserResizeColumns="True"
                              CanUserReorderColumns="True"
                              CanUserSortColumns="True"
                              ColumnWidth="Auto"
                              RowHeight="NaN"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>

                            <!-- THE MASK MAY CARRY RIGHTS THIS BUILD HAS NO WORD FOR, and when it
                                 does the summary says so and this reads as not established. A
                                 viewer that showed the named rights in the same ink as a fully
                                 named entry would hide access an administrator is looking straight
                                 at, which is the one thing an audit tool cannot do.

                                 Keyed on the FactState VALUE, never on its name as text: a trigger
                                 comparing a string against the type matches nothing, every mark
                                 falls through to the default, and the product tells an operator
                                 that an unknown fact is known. -->
                            <!-- THE SPARE WIDTH GOES HERE, AND THE MARK LIVES INSIDE IT.

                                 ONE ROW IS STILL ONE ACCESS CONTROL ENTRY. That is what the
                                 directory holds, what canonical order applies to, and what an
                                 administrator removes; a table of rights would show a list the
                                 object does not contain and nobody can act on.

                                 BUT THE MARK BELONGS TO THE RIGHT THAT EARNED IT. An ACCESS_MASK
                                 is a set of bits Windows evaluates independently - AccessCheck
                                 tests each right and accumulates across entries - and the
                                 classifier judges them differently by construction. A row reading
                                 "Write userAccountControl, Read userAccountControl" under one
                                 Takeover mark states something true of the entry and useless about
                                 the rights: the administrator deciding what to remove cannot tell
                                 which half earned it. So there is no Risk column any more, and
                                 each right carries its own mark on its own line.

                                 RED IS SPENT HERE DELIBERATELY - 0074. It marks a right the
                                 classifier calls a takeover of this object, and only while the
                                 toggle is on. A component of a takeover is amber instead: it is
                                 not one on its own, and one entry cannot say what else its
                                 principal holds.

                                 NOTHING IS MARKED GREEN. A right examined and found ordinary
                                 carries no mark, because a reassurance on most rows of most
                                 objects is one an operator stops reading. A right this build could
                                 not classify carries no mark either - it is neither reported as
                                 safe nor accused.

                                 THE MARK IS A WORD AND NOT ONLY A COLOUR, per 0056. An operator
                                 who cannot separate red from amber still reads "Takeover" and
                                 "Component".

                                 AND THE MASK MAY CARRY BITS THIS BUILD HAS NO WORD FOR. That is
                                 its own line, in the not-established ink, rather than a greying of
                                 the whole cell - which used to put "we could not read this" on
                                 rights the classifier had just called a takeover. -->
                            <DataGridTemplateColumn Header="Right" Width="*" MinWidth="280">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Rights}"
                                                      Margin="0,2,0,2">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Keyed on the enum VALUE, never on its
                                                             name as text: a trigger comparing a
                                                             string against the type matches
                                                             nothing, every mark falls through to
                                                             the default, and the screen then tells
                                                             an operator that a takeover is
                                                             unremarkable. -->
                                                        <TextBlock Grid.Column="0"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,0,10,0"
                                                                   ToolTip="{Binding RiskReason}"
                                                                   Visibility="{Binding IsMarked, Converter={StaticResource Shown}}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlock}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Mark}"
                                                                                     Value="Dangerous">
                                                                            <Setter Property="Text" Value="Takeover" />
                                                                            <Setter Property="Foreground"
                                                                                    Value="{DynamicResource CriticalFindingBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Mark}"
                                                                                     Value="DangerousInCombination">
                                                                            <Setter Property="Text" Value="Component" />
                                                                            <Setter Property="Foreground"
                                                                                    Value="{DynamicResource EstablishedBadBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Name}"
                                                                    ToolTip="{Binding ClassificationReason}"
                                                                   TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlock}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding State}"
                                                                                     Value="NotEstablished">
                                                                            <Setter Property="Foreground"
                                                                                    Value="{DynamicResource NotEstablishedBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="Auto" />

                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}"
                                                Width="SizeToCells" MinWidth="140" />

                            <DataGridTextColumn Header="Inheritance"
                                                Binding="{Binding Inheritance}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
                </TabItem>
                <TabItem Header="B - Expandable principal groups">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding VisiblePrincipals}"
                                      Visibility="{Binding HasVisiblePrincipals,Converter={StaticResource Shown}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PrincipalGroupViewModel}">
                                    <Expander Margin="0,0,0,8"
                                              Background="{DynamicResource SurfaceRaisedBackground}"
                                              BorderBrush="{DynamicResource AttributeCardBorderBrush}"
                                              BorderThickness="1">
                                        <Expander.Header>
                                            <Grid Margin="8,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Principal}" Style="{StaticResource RowTitle}"
                                                               TextWrapping="Wrap" />
                                                    <WrapPanel>
                                                        <TextBlock Text="{Binding Domain}" Style="{StaticResource Caption}"
                                                                   Margin="0,0,12,0" />
                                                        <TextBlock Text="{Binding VisibleRightsSummary}" Style="{StaticResource Caption}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding VisibleEntryCount}" Style="{StaticResource Caption}"
                                                           Margin="12,0,0,0" VerticalAlignment="Top" />
                                            </Grid>
                                        </Expander.Header>
                                        <StackPanel Margin="10,4,10,10">
                                            <TextBlock Text="{Binding Unresolved}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                       Foreground="{DynamicResource NotEstablishedBrush}"
                                                       Visibility="{Binding IsUnresolved,Converter={StaticResource Shown}}" />
                                            <DataGrid ItemsSource="{Binding VisibleEntries}"
                                                      ColumnHeaderStyle="{StaticResource TableColumnHeader}"
                                                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                                      GridLinesVisibility="Horizontal" CanUserResizeColumns="True"
                                                      CanUserReorderColumns="True" CanUserSortColumns="True"
                                                      RowHeight="NaN" HorizontalScrollBarVisibility="Auto" MaxHeight="360">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="Right" Width="*" MinWidth="280">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ItemsControl ItemsSource="{Binding Rights}" Margin="0,2">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Grid.Column="0" FontWeight="SemiBold"
                                                                                           Margin="0,0,10,0"
                                                                                           ToolTip="{Binding RiskReason}"
                                                                                           Visibility="{Binding IsMarked,Converter={StaticResource Shown}}">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlock}">
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding Mark}" Value="Dangerous">
                                                                                                    <Setter Property="Text" Value="Takeover" />
                                                                                                    <Setter Property="Foreground" Value="{DynamicResource CriticalFindingBrush}" />
                                                                                                </DataTrigger>
                                                                                                <DataTrigger Binding="{Binding Mark}" Value="DangerousInCombination">
                                                                                                    <Setter Property="Text" Value="Component" />
                                                                                                    <Setter Property="Foreground" Value="{DynamicResource EstablishedBadBrush}" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                                           ToolTip="{Binding ClassificationReason}"
                                                                                           TextWrapping="Wrap">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlock}">
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding State}" Value="NotEstablished">
                                                                                                    <Setter Property="Foreground" Value="{DynamicResource NotEstablishedBrush}" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="Auto" />
                                                    <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="SizeToCells" MinWidth="140" />
                                                    <DataGridTextColumn Header="Inheritance" Binding="{Binding Inheritance}" Width="Auto" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:EvidenceSectionViewModel}">
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="How this run came by this object"
                           Style="{StaticResource RowTitle}" />
                <TextBox Text="{Binding DescriptorState, Mode=OneWay}"
                         Style="{StaticResource SelectableMessage}"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- WHAT THE RULES CONCLUDED ABOUT THIS OBJECT.

         The verdict and the list are exclusive by construction: Verdict is null exactly when there
         is a list to show, so the section cannot say "nothing was found" above a table of findings
         and cannot show an empty table with nothing explaining it. Which of the three silences it
         is - nobody judged, the judgement would not open, or the rules found nothing here - is
         decided in the view model, where a test can reach it. -->
    <DataTemplate DataType="{x:Type vm:FindingsSectionViewModel}">
        <StackPanel>
            <Button Content="Open Path to Tier 0" HorizontalAlignment="Left" Margin="0,0,0,10"
                    Command="{Binding DataContext.ShowObjectPathCommand,RelativeSource={RelativeSource AncestorType=views:ObjectView}}" />
            <Border Style="{StaticResource Card}"
                    Visibility="{Binding HasVerdict, Converter={StaticResource Shown}}">
                <TextBox Text="{Binding Verdict, Mode=OneWay}"
                         Style="{StaticResource SelectableMessage}"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
            </Border>

            <ItemsControl ItemsSource="{Binding Findings}"
                          Visibility="{Binding HasFindings, Converter={StaticResource Shown}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}">
                                    <Run Text="{Binding Rule, Mode=OneWay}" />
                                    <Run Text=" — " Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <Run Text="{Binding Severity, Mode=OneWay}" />
                                </TextBlock>

                                <TextBox Text="{Binding Detail, Mode=OneWay}"
                                         Style="{StaticResource SelectableMessage}"
                                         Margin="0,4,0,0" />

                                <!-- A finding resting on evidence that may be incomplete is a
                                     weaker claim than one resting on a complete read, and it is
                                     said here rather than left for the operator to assume. -->
                                <TextBlock Text="{Binding Coverage}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,4,0,0" />
                                <Expander Header="View membership evidence" Margin="0,8,0,0"
                                          Visibility="{Binding HasMembershipEvidence, Converter={StaticResource Shown}}">
                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MembershipCompleteness}" TextWrapping="Wrap" Margin="0,4,0,6" />
                                            <TextBox Text="{Binding MembershipDetails, Mode=OneWay}"
                                                     Style="{StaticResource SelectableMessage}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:OtherValuesSectionViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12"
                           Text="Populated attributes outside this object's standard sections. These are recorded values, not additional security conclusions." />
                <ContentControl Content="{Binding Cards}" ContentTemplate="{StaticResource AttributeCards}" />
                <Border Style="{StaticResource Card}" Visibility="{Binding HasEmptiness, Converter={StaticResource Shown}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Emptiness.Title}" Style="{StaticResource RowTitle}" />
                        <TextBox Text="{Binding Emptiness.Detail, Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- Present and honest rather than absent. Leaving an unbuilt section out would make an object
         look completely described when it is not, and an operator would have no way to tell a class
         with no delegation from a build that cannot read it. -->
    <DataTemplate DataType="{x:Type vm:NotBuiltSectionViewModel}">
        <Border Style="{StaticResource Card}">
            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                       Foreground="{DynamicResource NotEstablishedBrush}" />
        </Border>
    </DataTemplate>

</ResourceDictionary>
