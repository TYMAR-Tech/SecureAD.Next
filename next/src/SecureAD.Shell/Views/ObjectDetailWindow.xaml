<Window x:Class="SecureAD.Shell.Views.ObjectDetailWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SecureAD.Shell.Views"
        Title="{Binding ObjectTitle}" Width="1180" Height="820" MinWidth="780" MinHeight="520"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <DockPanel Margin="8">
        <Expander DockPanel.Dock="Bottom" Header="Capture coverage" Margin="0,6,0,0"
                  Foreground="{DynamicResource SecondaryTextBrush}">
            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <views:CaptureCoverageView />
            </ScrollViewer>
        </Expander>
        <TextBlock DockPanel.Dock="Top" Text="Reading captured object..."
                   Style="{StaticResource Caption}"
                   Visibility="{Binding IsOpeningObject,Converter={StaticResource Shown}}" />
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}"
                Visibility="{Binding HasObjectRefusal,Converter={StaticResource Shown}}">
            <StackPanel>
                <TextBlock Text="{Binding ObjectRefusal.Title}" Style="{StaticResource RowTitle}" />
                <TextBox Text="{Binding ObjectRefusal.Detail,Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                         Foreground="{DynamicResource FaultBrush}" />
            </StackPanel>
        </Border>
        <views:ObjectView Visibility="{Binding ShowsObjectContent,Converter={StaticResource Shown}}" />
    </DockPanel>
</Window>
