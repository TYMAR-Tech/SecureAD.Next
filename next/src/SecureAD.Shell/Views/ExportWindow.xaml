<Window x:Class="SecureAD.Shell.Views.ExportWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="940" Height="790" MinWidth="680" MinHeight="460"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="Source run" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="1" Text="{Binding SourceRun}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="Captured" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Captured}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Text="Directory scope" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Scope}" TextWrapping="Wrap" />
                </Grid>
                <TextBlock Text="{Binding SelectionHeading}" FontWeight="SemiBold" Margin="0,0,0,7" />
                <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                    <StackPanel IsEnabled="{Binding CanChooseScope}">
                        <RadioButton IsChecked="{Binding Matching}" GroupName="ExportScope" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding MatchingLabel}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding MatchingNote}" TextWrapping="Wrap" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton IsChecked="{Binding AllInScope}" GroupName="ExportScope">
                            <StackPanel>
                                <TextBlock Text="{Binding AllInScopeLabel}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding AllInScopeNote}" TextWrapping="Wrap" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12"
                        Visibility="{Binding HasPreview,Converter={StaticResource Shown}}">
                    <StackPanel>
                        <TextBlock Text="{Binding CountText}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FiltersText}" Margin="0,8,0,5" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ScopeNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource EstablishedBadSubtleBrush}" BorderBrush="{DynamicResource EstablishedBadBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding CautionTitle}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource EstablishedBadBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CautionBody}" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Coverage}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <Expander Header="{Binding SampleHeading}" IsExpanded="True" Margin="0,0,0,12"
                          Visibility="{Binding HasPreview,Converter={StaticResource Shown}}">
                    <StackPanel>
                        <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" Margin="8"
                                   Visibility="{Binding HasNoRows,Converter={StaticResource Shown}}" />
                        <DataGrid ItemsSource="{Binding Sample}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" MaxHeight="180" CanUserAddRows="False" Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding First}" Header="1" Width="*">
                                    <DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{Binding DataContext.SampleHeaders[0],RelativeSource={RelativeSource AncestorType=DataGrid}}" /></DataTemplate></DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Second}" Header="2" Width="Auto">
                                    <DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{Binding DataContext.SampleHeaders[1],RelativeSource={RelativeSource AncestorType=DataGrid}}" /></DataTemplate></DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Third}" Header="3" Width="Auto">
                                    <DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{Binding DataContext.SampleHeaders[2],RelativeSource={RelativeSource AncestorType=DataGrid}}" /></DataTemplate></DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Fourth}" Header="4" Width="Auto">
                                    <DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{Binding DataContext.SampleHeaders[3],RelativeSource={RelativeSource AncestorType=DataGrid}}" /></DataTemplate></DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Expander>
                <Expander Header="{Binding ColumnsHeading}" Margin="0,0,0,12">
                    <TextBox Text="{Binding ColumnsText,Mode=OneWay}" Style="{StaticResource SelectableMessage}" Margin="8" />
                </Expander>
                <Expander Header="{Binding ContextHeading}" Margin="0,0,0,12">
                    <StackPanel Margin="8">
                        <TextBlock Text="{Binding CsvNote}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding TextSafety}" TextWrapping="Wrap" Margin="0,8,0,8" />
                        <TextBox Text="{Binding SourceDetails,Mode=OneWay}" Style="{StaticResource SelectableMessage}" />
                    </StackPanel>
                </Expander>
                <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12"
                        Visibility="{Binding HasStatus,Converter={StaticResource Shown}}">
                    <StackPanel>
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8"
                                     Visibility="{Binding IsExporting,Converter={StaticResource Shown}}" />
                        <TextBox Text="{Binding Status,Mode=OneWay}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource SelectableMessage}">
                                    <Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource FaultBrush}" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBox Text="{Binding SavedPath,Mode=OneWay}" Style="{StaticResource SelectableMessage}" Margin="0,7,0,0"
                                 Visibility="{Binding HasSavedPath,Converter={StaticResource Shown}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" Margin="0,0,10,0" />
            <Button Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Grid>
</Window>
