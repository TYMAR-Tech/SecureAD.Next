<UserControl x:Class="SecureAD.Shell.Views.FindingDetailView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="View saved routes" Command="{Binding OpenSavedRoutesCommand}"
                    CommandParameter="{Binding FindingDetails.Finding}" Margin="0,0,8,0"
                    Visibility="{Binding FindingDetails.Finding.HasTier0Routes,Converter={StaticResource Shown}}" />
            <Button Content="Open affected object" Command="{Binding OpenAffectedObjectCommand}" Margin="0,0,8,0"
                    IsEnabled="{Binding FindingDetails.HasFinding}" />
            <Button Content="Close" Command="{Binding CloseFindingDetailsCommand}" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding FindingDetails.LoadingText}" Style="{StaticResource Caption}"
                   Visibility="{Binding FindingDetails.IsLoading,Converter={StaticResource Shown}}" />
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8"
                Visibility="{Binding FindingDetails.HasRefusal,Converter={StaticResource Shown}}">
            <TextBox Text="{Binding FindingDetails.Refusal,Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                     Foreground="{DynamicResource FaultBrush}" />
        </Border>
        <ScrollViewer x:Name="FindingDetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding FindingDetails.HasFinding,Converter={StaticResource Shown}}">
            <StackPanel>
                <TextBlock Text="{Binding FindingDetails.Finding.FindingLabel}" Style="{StaticResource RowTitle}" TextWrapping="Wrap" />
                <WrapPanel Margin="0,8,0,12">
                    <TextBlock Text="{Binding FindingDetails.Finding.Severity}" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding FindingDetails.Finding.Coverage}" Foreground="{DynamicResource SecondaryTextBrush}" />
                </WrapPanel>
                <StackPanel Visibility="{Binding FindingDetails.ShowsStandardIdentity,Converter={StaticResource Shown}}">
                    <TextBlock Text="{Binding FindingDetails.Finding.Principal,StringFormat=Principal: {0}}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding FindingDetails.Finding.DistinguishedName,StringFormat=Affected object: {0}}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding FindingDetails.Finding.Domain,StringFormat=Domain: {0}}" TextWrapping="Wrap" Margin="0,0,0,16" />
                </StackPanel>
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding FindingDetails.HasCapturedSetting,Converter={StaticResource Shown}}">
                    <StackPanel>
                        <TextBlock Text="Captured setting" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding FindingDetails.CapturedSetting.Setting}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding FindingDetails.CapturedSetting.AccountState,StringFormat=Account state at capture: {0}}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding FindingDetails.Finding.ObjectClass,StringFormat=Object type: {0}}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding FindingDetails.CapturedSetting.ControllerRoleNote}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding FindingDetails.CapturedSetting.HasControllerRoleNote,Converter={StaticResource Shown}}" />
                        <TextBlock Text="{Binding FindingDetails.CapturedSetting.ControllerDisagreement}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding FindingDetails.CapturedSetting.HasControllerDisagreement,Converter={StaticResource Shown}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding FindingDetails.HasDelegationConfiguration,Converter={StaticResource Shown}}">
                    <StackPanel>
                        <TextBlock Text="{Binding FindingDetails.DelegationConfiguration.Heading}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding FindingDetails.DelegationConfiguration.Statement}" TextWrapping="Wrap" Margin="0,6,0,12" />
                        <StackPanel Visibility="{Binding FindingDetails.DelegationConfiguration.IsConstrained,Converter={StaticResource Shown}}">
                            <TextBlock Text="{Binding FindingDetails.DelegationConfiguration.DelegatingAccount,StringFormat=Delegating account: {0}}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding FindingDetails.DelegationConfiguration.Account.ObjectClass,StringFormat=Object type: {0}}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding FindingDetails.DelegationConfiguration.Account.DomainFqdn,StringFormat=Domain: {0}}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding FindingDetails.DelegationConfiguration.Account.DistinguishedName,StringFormat=Location: {0}}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding FindingDetails.DelegationConfiguration.Resource.DistinguishedName,StringFormat=Matched resource: {0}}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding FindingDetails.DelegationConfiguration.Resource.DomainFqdn,StringFormat=Resource domain: {0}}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding FindingDetails.DelegationConfiguration.IsResourceBased,Converter={StaticResource Shown}}">
                            <TextBlock Text="{Binding FindingDetails.DelegationConfiguration.ResourceName,StringFormat=Resource: {0}}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding FindingDetails.DelegationConfiguration.Resource.ObjectClass,StringFormat=Object type: {0}}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding FindingDetails.DelegationConfiguration.Resource.DomainFqdn,StringFormat=Domain: {0}}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding FindingDetails.DelegationConfiguration.Resource.DistinguishedName,StringFormat=Location: {0}}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="{Binding FindingDetails.DelegationConfiguration.ResourceRelevance,StringFormat=Resource relevance: {0}}" TextWrapping="Wrap" />
                        <TextBlock Text="Configured service names" Style="{StaticResource SectionTitle}" Margin="0,12,0,6"
                                   Visibility="{Binding FindingDetails.DelegationConfiguration.IsConstrained,Converter={StaticResource Shown}}" />
                        <ItemsControl ItemsSource="{Binding FindingDetails.DelegationConfiguration.Services}"
                                      Visibility="{Binding FindingDetails.DelegationConfiguration.IsConstrained,Converter={StaticResource Shown}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Mode=OneWay}" Style="{StaticResource SelectableMessage}" Margin="0,0,0,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Visibility="{Binding FindingDetails.DelegationConfiguration.ShowsHolders,Converter={StaticResource Shown}}">
                            <TextBlock Text="Configured delegation holders" Style="{StaticResource SectionTitle}" Margin="0,12,0,6" />
                            <ItemsControl ItemsSource="{Binding FindingDetails.DelegationConfiguration.Holders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBox Text="{Binding DisplayName,Mode=OneWay}" Style="{StaticResource SelectableMessage}" />
                                            <TextBox Text="{Binding Sid,Mode=OneWay,StringFormat=SID: {0}}" Style="{StaticResource SelectableMessage}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock Text="{Binding FindingDetails.DelegationConfiguration.NullDaclNote}" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Visibility="{Binding FindingDetails.DelegationConfiguration.HasNullDacl,Converter={StaticResource Shown}}" />
                        <WrapPanel Margin="0,6,0,0" Visibility="{Binding FindingDetails.DelegationConfiguration.ShowsPaging,Converter={StaticResource Shown}}">
                            <Button Content="Previous" Command="{Binding FindingDetails.DelegationConfiguration.PreviousPageCommand}" />
                            <TextBlock Text="{Binding FindingDetails.DelegationConfiguration.PageLabel}" VerticalAlignment="Center" Margin="12,0" />
                            <Button Content="Next" Command="{Binding FindingDetails.DelegationConfiguration.NextPageCommand}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding FindingDetails.DelegationConfiguration.LoadingText}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Visibility="{Binding FindingDetails.DelegationConfiguration.IsLoading,Converter={StaticResource Shown}}" />
                        <TextBox Text="{Binding FindingDetails.DelegationConfiguration.Refusal,Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                                 Foreground="{DynamicResource FaultBrush}" Margin="0,6,0,0"
                                 Visibility="{Binding FindingDetails.DelegationConfiguration.HasRefusal,Converter={StaticResource Shown}}" />
                        <TextBlock Text="{Binding FindingDetails.DelegationConfiguration.ScopeNote}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        <StackPanel Visibility="{Binding FindingDetails.DelegationConfiguration.HasLimitations,Converter={StaticResource Shown}}" Margin="0,12,0,0">
                            <TextBlock Text="Saved evidence limitations" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding FindingDetails.DelegationConfiguration.Limitations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding FindingDetails.HasAttributeWritePermission,Converter={StaticResource Shown}}">
                    <StackPanel>
                        <TextBlock Text="Captured write permission" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding FindingDetails.AttributeWritePermission.Holder,StringFormat=Permission holder: {0}}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBox Text="{Binding FindingDetails.AttributeWritePermission.Sid,Mode=OneWay,StringFormat=SID: {0}}" Style="{StaticResource SelectableMessage}" />
                        <TextBlock Text="{Binding FindingDetails.AttributeWritePermission.TargetName,StringFormat=Target account: {0}}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FindingDetails.AttributeWritePermission.Target.ObjectClass,StringFormat=Object type: {0}}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FindingDetails.AttributeWritePermission.Target.DomainFqdn,StringFormat=Domain: {0}}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FindingDetails.AttributeWritePermission.Target.DistinguishedName,StringFormat=Location: {0}}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FindingDetails.AttributeWritePermission.AccountState,StringFormat=Account state at capture: {0}}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FindingDetails.AttributeWritePermission.Attribute,StringFormat=Attribute: {0}}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="Why this holder is unexpected" Style="{StaticResource SectionTitle}" Margin="0,12,0,6" />
                        <TextBlock Text="{Binding FindingDetails.AttributeWritePermission.Unexpectedness}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FindingDetails.AttributeWritePermission.NullDaclNote}" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Visibility="{Binding FindingDetails.AttributeWritePermission.HasNullDacl,Converter={StaticResource Shown}}" />
                        <StackPanel Visibility="{Binding FindingDetails.AttributeWritePermission.ShowsEntries,Converter={StaticResource Shown}}">
                            <TextBlock Text="Saved permission entries" Style="{StaticResource SectionTitle}" Margin="0,12,0,6" />
                            <ItemsControl ItemsSource="{Binding FindingDetails.AttributeWritePermission.Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding EntryType}" Style="{StaticResource RowTitle}" />
                                            <TextBlock Text="{Binding PermissionScope,StringFormat=Permission scope: {0}}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Assignment,StringFormat=Assignment: {0}}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding InheritanceNote}" TextWrapping="Wrap"
                                                       Visibility="{Binding IsInherited,Converter={StaticResource Shown}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Previous" Command="{Binding FindingDetails.AttributeWritePermission.PreviousPageCommand}" />
                                <TextBlock Text="{Binding FindingDetails.AttributeWritePermission.PageLabel}" VerticalAlignment="Center" Margin="12,0" />
                                <Button Content="Next" Command="{Binding FindingDetails.AttributeWritePermission.NextPageCommand}" />
                            </WrapPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding FindingDetails.AttributeWritePermission.LoadingText}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Visibility="{Binding FindingDetails.AttributeWritePermission.IsLoading,Converter={StaticResource Shown}}" />
                        <TextBox Text="{Binding FindingDetails.AttributeWritePermission.Refusal,Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                                 Foreground="{DynamicResource FaultBrush}" Margin="0,6,0,0"
                                 Visibility="{Binding FindingDetails.AttributeWritePermission.HasRefusal,Converter={StaticResource Shown}}" />
                        <TextBlock Text="{Binding FindingDetails.AttributeWritePermission.ScopeNote}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        <StackPanel Visibility="{Binding FindingDetails.AttributeWritePermission.HasLimitations,Converter={StaticResource Shown}}" Margin="0,12,0,0">
                            <TextBlock Text="Saved evidence limitations" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding FindingDetails.AttributeWritePermission.Limitations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,6,0,0" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding FindingDetails.ShowsSavedDescription,Converter={StaticResource Shown}}">
                    <StackPanel>
                        <TextBlock Text="Finding" Style="{StaticResource SectionTitle}" />
                        <TextBox Text="{Binding FindingDetails.Finding.Detail,Mode=OneWay}" Style="{StaticResource SelectableMessage}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Why it matters" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding FindingDetails.Finding.WhyItMatters}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="What to do" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding FindingDetails.Finding.WhatToDo}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <StackPanel Margin="0,12,0,0"
                            Visibility="{Binding FindingDetails.Finding.HasMembershipEvidence,Converter={StaticResource Shown}}">
                    <Button Content="View membership evidence" Command="{Binding FindingDetails.LoadMembershipCommand}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding FindingDetails.LoadingText}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Visibility="{Binding FindingDetails.IsLoadingMembership,Converter={StaticResource Shown}}" />
                    <TextBox Text="{Binding FindingDetails.MembershipRefusal,Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                             Foreground="{DynamicResource FaultBrush}" Margin="0,6,0,0"
                             Visibility="{Binding FindingDetails.HasMembershipRefusal,Converter={StaticResource Shown}}" />
                    <StackPanel Visibility="{Binding FindingDetails.HasMembershipDetails,Converter={StaticResource Shown}}">
                        <TextBlock Text="{Binding FindingDetails.MembershipCompleteness}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBox Text="{Binding FindingDetails.MembershipDetails,Mode=OneWay}" Style="{StaticResource SelectableMessage}" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding FindingDetails.Finding.About}" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,16,0,0" />
                <TextBlock Text="{Binding FindingDetails.Finding.MicrosoftReference}" Style="{StaticResource Caption}" Margin="0,12,0,0"
                           Visibility="{Binding FindingDetails.Finding.HasMicrosoftReference,Converter={StaticResource Shown}}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
