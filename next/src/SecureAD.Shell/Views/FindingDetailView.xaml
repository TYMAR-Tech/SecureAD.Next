                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Containing group" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Member to review for removal" FontWeight="SemiBold" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding FindingDetails.CircularMembership.Loop.Rows}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ContainingGroup}" TextWrapping="Wrap" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Member}" TextWrapping="Wrap" Margin="0,0,10,0" />
                                    <Button Grid.Column="2" Content="Review membership" Command="{Binding ReviewCommand}" />
                                </Grid>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding FindingDetails.CircularMembership.ReviewNote}" TextWrapping="Wrap" Margin="0,6,0,6" />
                        <Button Content="Group details and original evidence" Command="{Binding FindingDetails.CircularMembership.ViewDetailsCommand}"
                                HorizontalAlignment="Left" Margin="0,6,0,6" />
                        <StackPanel Visibility="{Binding FindingDetails.CircularMembership.HasDetails,Converter={StaticResource Shown}}">
                        <TextBlock Text="{Binding FindingDetails.CircularMembership.InventoryLabel}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding FindingDetails.CircularMembership.AffectedObjectNote}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="Groups in this finding" Style="{StaticResource SectionTitle}" Margin="0,12,0,6" />
                        <TextBlock Text="{Binding FindingDetails.CircularMembership.GroupNote}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding FindingDetails.CircularMembership.Groups.Rows}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Group,StringFormat=Group: {0}}" Style="{StaticResource RowTitle}" TextWrapping="Wrap" />
                                    <TextBox Text="{Binding Sid,Mode=OneWay,StringFormat=SID: {0}}" Style="{StaticResource SelectableMessage}" />
                                    <TextBlock Text="{Binding Domain,StringFormat=Domain: {0}}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Location,StringFormat=Location: {0}}" TextWrapping="Wrap" />
                                    <Button Content="Open group" Command="{Binding OpenCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                </StackPanel>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel>
                            <Button Content="Previous" Command="{Binding FindingDetails.CircularMembership.Groups.PreviousPageCommand}" />
                            <TextBlock Text="{Binding FindingDetails.CircularMembership.Groups.PageLabel}" VerticalAlignment="Center" Margin="12,0" />
                            <Button Content="Next" Command="{Binding FindingDetails.CircularMembership.Groups.NextPageCommand}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding FindingDetails.CircularMembership.Groups.LoadingText}"
                                   Visibility="{Binding FindingDetails.CircularMembership.Groups.IsLoading,Converter={StaticResource Shown}}" />
                        <TextBox Text="{Binding FindingDetails.CircularMembership.Groups.Refusal,Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                                 Foreground="{DynamicResource FaultBrush}" Visibility="{Binding FindingDetails.CircularMembership.Groups.HasRefusal,Converter={StaticResource Shown}}" />
                        <Button Content="View recorded nesting links" Command="{Binding FindingDetails.CircularMembership.ViewLinksCommand}"
                                HorizontalAlignment="Left" Margin="0,12,0,6" />
                        <StackPanel Visibility="{Binding FindingDetails.CircularMembership.HasLinks,Converter={StaticResource Shown}}">
                            <TextBlock Text="Recorded nesting links" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding FindingDetails.CircularMembership.LinksNote}" TextWrapping="Wrap" Margin="0,6,0,8" />
                            <ItemsControl ItemsSource="{Binding FindingDetails.CircularMembership.Links.Rows}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Direction}" Style="{StaticResource RowTitle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding MemberLocation,StringFormat=Member group: {0}}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ContainingGroupLocation,StringFormat=Containing group: {0}}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelfMembershipNote}" TextWrapping="Wrap"
                                                   Visibility="{Binding IsSelfMembership,Converter={StaticResource Shown}}" />
                                        <Button Content="View saved supporting values" Command="{Binding ViewCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                    </StackPanel>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel>
                                <Button Content="Previous" Command="{Binding FindingDetails.CircularMembership.Links.PreviousPageCommand}" />
                                <TextBlock Text="{Binding FindingDetails.CircularMembership.Links.PageLabel}" VerticalAlignment="Center" Margin="12,0" />
                                <Button Content="Next" Command="{Binding FindingDetails.CircularMembership.Links.NextPageCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding FindingDetails.CircularMembership.Links.LoadingText}"
                                       Visibility="{Binding FindingDetails.CircularMembership.Links.IsLoading,Converter={StaticResource Shown}}" />
                            <TextBox Text="{Binding FindingDetails.CircularMembership.Links.Refusal,Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                                     Foreground="{DynamicResource FaultBrush}" Visibility="{Binding FindingDetails.CircularMembership.Links.HasRefusal,Converter={StaticResource Shown}}" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding FindingDetails.CircularMembership.HasWitnesses,Converter={StaticResource Shown}}" Margin="0,12,0,0">
                            <TextBlock Text="Saved supporting values" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding FindingDetails.CircularMembership.SelectedRelationship}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding FindingDetails.CircularMembership.WitnessesNote}" TextWrapping="Wrap" Margin="0,6,0,6" />
                            <TextBlock Text="{Binding FindingDetails.CircularMembership.MemberOfNote}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Visibility="{Binding FindingDetails.CircularMembership.HasMemberOf,Converter={StaticResource Shown}}" />
                            <ItemsControl ItemsSource="{Binding FindingDetails.CircularMembership.Witnesses.Rows}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Source,StringFormat=Recorded on: {0}}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Attribute,StringFormat=Recorded attribute: {0}}" TextWrapping="Wrap" />
                                        <TextBox Text="{Binding Value,Mode=OneWay,StringFormat=Saved value: {0}}" Style="{StaticResource SelectableMessage}" />
                                    </StackPanel>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel>
                                <Button Content="Previous" Command="{Binding FindingDetails.CircularMembership.Witnesses.PreviousPageCommand}" />
                                <TextBlock Text="{Binding FindingDetails.CircularMembership.Witnesses.PageLabel}" VerticalAlignment="Center" Margin="12,0" />
                                <Button Content="Next" Command="{Binding FindingDetails.CircularMembership.Witnesses.NextPageCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding FindingDetails.CircularMembership.Witnesses.LoadingText}"
                                       Visibility="{Binding FindingDetails.CircularMembership.Witnesses.IsLoading,Converter={StaticResource Shown}}" />
                            <TextBox Text="{Binding FindingDetails.CircularMembership.Witnesses.Refusal,Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                                     Foreground="{DynamicResource FaultBrush}" Visibility="{Binding FindingDetails.CircularMembership.Witnesses.HasRefusal,Converter={StaticResource Shown}}" />
                        </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding FindingDetails.CircularMembership.LoadingText}"
                                   Visibility="{Binding FindingDetails.CircularMembership.IsLoading,Converter={StaticResource Shown}}" />
                        <TextBox Text="{Binding FindingDetails.CircularMembership.Refusal,Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                                 Foreground="{DynamicResource FaultBrush}" Visibility="{Binding FindingDetails.CircularMembership.HasRefusal,Converter={StaticResource Shown}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding FindingDetails.ShowsSavedDescription,Converter={StaticResource Shown}}">
                    <StackPanel>
                        <TextBlock Text="Finding" Style="{StaticResource SectionTitle}" />
                        <TextBox Text="{Binding FindingDetails.Finding.Detail,Mode=OneWay}" Style="{StaticResource SelectableMessage}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Why it matters" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding FindingDetails.Finding.WhyItMatters}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="What to do" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding FindingDetails.Finding.WhatToDo}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                        Visibility="{Binding FindingDetails.HasServiceRegistration,Converter={StaticResource Shown}}">
                    <StackPanel>
                        <TextBlock Text="Saved membership evidence" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding FindingDetails.ServiceRegistration.MembershipNote}" TextWrapping="Wrap" Margin="0,6,0,6" />
                        <TextBlock Text="{Binding FindingDetails.ServiceRegistration.MembershipCount}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FindingDetails.ServiceRegistration.MembershipCompleteness}" TextWrapping="Wrap" />
                        <TextBlock Text="Membership branches have not been opened." TextWrapping="Wrap" Margin="0,6,0,6"
                                   Visibility="{Binding FindingDetails.ServiceRegistration.MembershipNotOpened,Converter={StaticResource Shown}}" />
                        <Button Content="View membership evidence" Command="{Binding FindingDetails.ServiceRegistration.ViewMembershipCommand}" HorizontalAlignment="Left" Margin="0,6,0,6" />
                        <StackPanel Visibility="{Binding FindingDetails.ServiceRegistration.HasMemberships,Converter={StaticResource Shown}}">
                            <TextBlock Text="{Binding FindingDetails.ServiceRegistration.EmptyMemberships}" TextWrapping="Wrap"
                                       Visibility="{Binding FindingDetails.ServiceRegistration.HasNoMemberships,Converter={StaticResource Shown}}" />
                            <TextBlock Text="{Binding FindingDetails.ServiceRegistration.PartialEmpty}" TextWrapping="Wrap"
                                       Visibility="{Binding FindingDetails.ServiceRegistration.HasPartialEmpty,Converter={StaticResource Shown}}" />
                            <ItemsControl ItemsSource="{Binding FindingDetails.ServiceRegistration.Memberships.Rows}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <StackPanel Margin="0,6,0,6">
                                        <TextBlock Text="{Binding Identity}" ToolTip="{Binding ExactIdentity}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding PrimaryNote}" TextWrapping="Wrap" Visibility="{Binding IsPrimaryGroup,Converter={StaticResource Shown}}" />
                                        <Button Content="View supporting chains" Command="{Binding ViewCommand}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel>
                                <Button Content="Previous" Command="{Binding FindingDetails.ServiceRegistration.Memberships.PreviousPageCommand}" />
                                <TextBlock Text="{Binding FindingDetails.ServiceRegistration.Memberships.PageLabel}" VerticalAlignment="Center" Margin="12,0" />
                                <Button Content="Next" Command="{Binding FindingDetails.ServiceRegistration.Memberships.NextPageCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding FindingDetails.ServiceRegistration.Memberships.LoadingText}" Visibility="{Binding FindingDetails.ServiceRegistration.Memberships.IsLoading,Converter={StaticResource Shown}}" />
                            <TextBox Text="{Binding FindingDetails.ServiceRegistration.Memberships.Refusal,Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                                     Foreground="{DynamicResource FaultBrush}" Visibility="{Binding FindingDetails.ServiceRegistration.Memberships.HasRefusal,Converter={StaticResource Shown}}" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding FindingDetails.ServiceRegistration.HasRoutes,Converter={StaticResource Shown}}" Margin="0,12,0,0">
                            <TextBlock Text="{Binding FindingDetails.ServiceRegistration.SelectedMembership}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding FindingDetails.ServiceRegistration.Routes.Rows}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <StackPanel Margin="0,6,0,6">
                                        <TextBlock Text="{Binding Root}" Style="{StaticResource RowTitle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Authorization}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Protection}" TextWrapping="Wrap" />
                                        <Button Content="View chain" Command="{Binding ViewCommand}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel>
                                <Button Content="Previous" Command="{Binding FindingDetails.ServiceRegistration.Routes.PreviousPageCommand}" />
                                <TextBlock Text="{Binding FindingDetails.ServiceRegistration.Routes.PageLabel}" VerticalAlignment="Center" Margin="12,0" />
                                <Button Content="Next" Command="{Binding FindingDetails.ServiceRegistration.Routes.NextPageCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding FindingDetails.ServiceRegistration.Routes.LoadingText}" Visibility="{Binding FindingDetails.ServiceRegistration.Routes.IsLoading,Converter={StaticResource Shown}}" />
                            <TextBox Text="{Binding FindingDetails.ServiceRegistration.Routes.Refusal,Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                                     Foreground="{DynamicResource FaultBrush}" Visibility="{Binding FindingDetails.ServiceRegistration.Routes.HasRefusal,Converter={StaticResource Shown}}" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding FindingDetails.ServiceRegistration.HasSteps,Converter={StaticResource Shown}}" Margin="0,12,0,0">
                            <TextBlock Text="{Binding FindingDetails.ServiceRegistration.SelectedRoot}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding FindingDetails.ServiceRegistration.ContinuedSteps}" TextWrapping="Wrap"
                                       Visibility="{Binding FindingDetails.ServiceRegistration.Steps.IsContinuation,Converter={StaticResource Shown}}" />
                            <ItemsControl ItemsSource="{Binding FindingDetails.ServiceRegistration.Steps.Rows}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <StackPanel Margin="0,6,0,6">
                                        <TextBlock Text="{Binding Identity}" ToolTip="{Binding ExactIdentity}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding PrimaryNote}" TextWrapping="Wrap" Visibility="{Binding IsPrimaryGroup,Converter={StaticResource Shown}}" />
                                    </StackPanel>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel>
                                <Button Content="Previous" Command="{Binding FindingDetails.ServiceRegistration.Steps.PreviousPageCommand}" />
                                <TextBlock Text="{Binding FindingDetails.ServiceRegistration.Steps.PageLabel}" VerticalAlignment="Center" Margin="12,0" />
                                <Button Content="Next" Command="{Binding FindingDetails.ServiceRegistration.Steps.NextPageCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding FindingDetails.ServiceRegistration.Steps.LoadingText}" Visibility="{Binding FindingDetails.ServiceRegistration.Steps.IsLoading,Converter={StaticResource Shown}}" />
                            <TextBox Text="{Binding FindingDetails.ServiceRegistration.Steps.Refusal,Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                                     Foreground="{DynamicResource FaultBrush}" Visibility="{Binding FindingDetails.ServiceRegistration.Steps.HasRefusal,Converter={StaticResource Shown}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding FindingDetails.ServiceRegistration.LoadingText}" Visibility="{Binding FindingDetails.ServiceRegistration.IsLoading,Converter={StaticResource Shown}}" />
                        <TextBox Text="{Binding FindingDetails.ServiceRegistration.Refusal,Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                                 Foreground="{DynamicResource FaultBrush}" Visibility="{Binding FindingDetails.ServiceRegistration.HasRefusal,Converter={StaticResource Shown}}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding FindingDetails.Finding.About}" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,16,0,0" />
                <TextBlock Text="{Binding FindingDetails.Finding.MicrosoftReference}" Style="{StaticResource Caption}" Margin="0,12,0,0"
                           Visibility="{Binding FindingDetails.Finding.HasMicrosoftReference,Converter={StaticResource Shown}}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
