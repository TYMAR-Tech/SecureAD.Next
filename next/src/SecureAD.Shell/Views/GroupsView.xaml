<UserControl x:Class="SecureAD.Shell.Views.GroupsView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SecureAD.Shell.Views"
             xmlns:controls="clr-namespace:SecureAD.Shell.Controls"
             Background="{DynamicResource AssetCanvasBackground}">
    <UserControl.Resources>
        <views:BindingProxy x:Key="Model" Data="{Binding}" />
        <controls:GroupSummaryVisibility x:Key="GroupSummaryVisibility" />
        <Style x:Key="GroupColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource TableColumnHeader}">
            <Setter Property="Background" Value="{StaticResource AttributeHeaderBackground}" />
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                <ContentControl Content="{Binding}" Foreground="{StaticResource AttributeLabelBrush}" />
            </DataTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GroupSortButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" /><Setter Property="MinHeight" Value="24" />
            <Setter Property="Foreground" Value="{StaticResource AttributeLabelBrush}" />
        </Style>
        <Style x:Key="GroupCell" TargetType="TextBlock">
            <Setter Property="Margin" Value="8" /><Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>
        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="GroupValue" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding GroupLocation}" Style="{StaticResource RowTitle}" Margin="0,0,0,8" />
            <Border Background="{StaticResource AttributeHeaderBackground}" BorderBrush="{StaticResource AttributeCardBorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <WrapPanel>
                        <StackPanel Width="260" Margin="0,0,10,8">
                            <TextBlock Text="Search group name or account name" Style="{StaticResource GroupLabel}" />
                            <TextBox Text="{Binding GroupSearchText,UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchGroupsCommand}" /></TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>
                        <Button Content="Search" Command="{Binding SearchGroupsCommand}" VerticalAlignment="Bottom" Margin="0,0,14,8" />
                        <StackPanel Width="135" Margin="0,0,10,8">
                            <TextBlock Text="Group scope" Style="{StaticResource GroupLabel}" />
                            <ComboBox ItemsSource="{Binding GroupScopeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding GroupScope}" />
                        </StackPanel>
                        <StackPanel Width="135" Margin="0,0,10,8">
                            <TextBlock Text="Group type" Style="{StaticResource GroupLabel}" />
                            <ComboBox ItemsSource="{Binding GroupKindChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding GroupKind}" />
                        </StackPanel>
                        <CheckBox Content="Cycles only" IsChecked="{Binding GroupsOnlyCycles}" VerticalAlignment="Bottom" Margin="0,0,14,12" />
                        <Button Content="Clear" Command="{Binding ClearGroupFiltersCommand}" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                    </WrapPanel>
                    <TextBlock Text="Double-click a group or press Enter to open its captured object. Back preserves this list."
                               Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Expander Header="What do these counts mean?" Margin="0,8,0,0">
                        <TextBox Text="{Binding GroupCountExplanation,Mode=OneWay}" Style="{StaticResource SelectableMessage}" Margin="0,6,0,0" />
                    </Expander>
                </StackPanel>
            </Border>
            <TextBox Text="{Binding GroupQualification,Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                     Foreground="{StaticResource FaultBrush}" Margin="0,0,0,10"
                     Visibility="{Binding HasGroupQualification,Converter={StaticResource Shown}}" />
            <TextBlock Text="{Binding LoadingText}" Margin="0,0,0,10" TextWrapping="Wrap"
                       Visibility="{Binding IsLoading,Converter={StaticResource Shown}}" />
            <StackPanel Margin="0,0,0,10" Visibility="{Binding HasViewRefusal,Converter={StaticResource Shown}}">
                <TextBlock Text="{Binding ViewRefusal.Title}" Style="{StaticResource RowTitle}" />
                <TextBox Text="{Binding ViewRefusal.Detail,Mode=OneWay}" Style="{StaticResource SelectableMessage}" Foreground="{StaticResource FaultBrush}" />
            </StackPanel>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Visibility="{Binding HasListingResult,Converter={StaticResource Shown}}">
            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="Previous" Command="{Binding PreviousGroupPageCommand}" Margin="0,0,8,0" />
                <Button Content="Next" Command="{Binding NextGroupPageCommand}" Margin="0,0,12,0" />
                <Button Content="Open group" Command="{Binding OpenGroupCommand}" CommandParameter="{Binding SelectedGroup}"
                        Style="{StaticResource PrimaryButton}" />
            </WrapPanel>
            <TextBlock Text="{Binding GroupPageDescription}" Foreground="{StaticResource SecondaryTextBrush}"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
        </DockPanel>
        <Grid Visibility="{Binding HasListingResult,Converter={StaticResource Shown}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <controls:GroupInventoryGrid ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                OpenItemCommand="{Binding OpenGroupCommand}" AutoGenerateColumns="False" IsReadOnly="True"
                SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                CanUserSortColumns="False" ColumnHeaderStyle="{StaticResource GroupColumnHeader}"
                Style="{StaticResource {x:Type DataGrid}}" EnableRowVirtualization="True"
                GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource AttributeCardBorderBrush}"
                RowBackground="{StaticResource SurfaceRaisedBackground}" AlternatingRowBackground="{StaticResource AssetNavigationBackground}"
                ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="2*" MinWidth="190">
                        <DataGridTemplateColumn.Header><Button Content="Group" Style="{StaticResource GroupSortButton}" Command="{Binding Data.SortGroupNameCommand,Source={StaticResource Model}}" /></DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <StackPanel Margin="6,7"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" /></StackPanel>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" ElementStyle="{StaticResource GroupCell}" Width="Auto" MinWidth="95" />
                    <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" ElementStyle="{StaticResource GroupCell}" Width="*" MinWidth="130" />
                    <DataGridTextColumn Binding="{Binding DirectMembers}" ElementStyle="{StaticResource GroupCell}" Width="Auto" MinWidth="70">
                        <DataGridTextColumn.Header><Button Content="Direct" Style="{StaticResource GroupSortButton}" Command="{Binding Data.SortGroupDirectCommand,Source={StaticResource Model}}" /></DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Known total" Binding="{Binding KnownTotal}" ElementStyle="{StaticResource GroupCell}" Width="Auto" MinWidth="110" />
                    <DataGridTemplateColumn Header="Cycle" Width="Auto" MinWidth="100">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <Button Content="{Binding Cycle}" IsEnabled="{Binding HasCycle}"
                                    Command="{Binding Data.OpenGroupFindingsCommand,Source={StaticResource Model}}"
                                    CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="4,2" Margin="3" />
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Membership data" Binding="{Binding MembershipData}" ElementStyle="{StaticResource GroupCell}" Width="Auto" MinWidth="125" />
                </DataGrid.Columns>
            </controls:GroupInventoryGrid>
            <Border Grid.Column="1" Width="280" Margin="14,0,0,0" Background="{StaticResource AssetNavigationBackground}"
                    BorderBrush="{StaticResource AttributeCardBorderBrush}" BorderThickness="1" CornerRadius="7"
                    Visibility="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=UserControl},Converter={StaticResource GroupSummaryVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel Visibility="{Binding HasSelectedGroup,Converter={StaticResource Shown}}">
                        <TextBlock Text="Selected group" Style="{StaticResource GroupLabel}" />
                        <TextBlock Text="{Binding SelectedGroup.Name}" Style="{StaticResource RowTitle}" Margin="0,0,0,12" TextWrapping="Wrap" />
                        <Button Content="Open group" Command="{Binding OpenGroupCommand}" CommandParameter="{Binding SelectedGroup}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,0,14" />
                        <TextBlock Text="Domain" Style="{StaticResource GroupLabel}" /><TextBlock Text="{Binding SelectedGroup.Domain}" Style="{StaticResource GroupValue}" />
                        <TextBlock Text="Scope" Style="{StaticResource GroupLabel}" /><TextBlock Text="{Binding SelectedGroup.Scope}" Style="{StaticResource GroupValue}" />
                        <TextBlock Text="Direct recorded members" Style="{StaticResource GroupLabel}" /><TextBlock Text="{Binding SelectedGroup.DirectMembers}" Style="{StaticResource GroupValue}" />
                        <TextBlock Text="Known total" Style="{StaticResource GroupLabel}" /><TextBlock Text="{Binding SelectedGroup.KnownTotal}" Style="{StaticResource GroupValue}" />
                        <TextBlock Text="{Binding SelectedGroup.MembershipDetail}" Style="{StaticResource GroupLabel}" />
                        <Button Content="View SEC-052 finding" Command="{Binding OpenGroupFindingsCommand}" CommandParameter="{Binding SelectedGroup}" Margin="0,0,0,12"
                                Visibility="{Binding SelectedGroup.HasCycle,Converter={StaticResource Shown}}" />
                        <TextBlock Text="Account name (sAMAccountName)" Style="{StaticResource GroupLabel}" /><TextBlock Text="{Binding SelectedGroup.AccountName}" Style="{StaticResource GroupValue}" />
                        <TextBlock Text="Distinguished name" Style="{StaticResource GroupLabel}" />
                        <TextBox Text="{Binding SelectedGroup.DistinguishedName,Mode=OneWay}" Style="{StaticResource SelectableMessage}" Margin="0,0,0,12" />
                        <TextBlock Text="Description" Style="{StaticResource GroupLabel}" /><TextBlock Text="{Binding SelectedGroup.Description}" Style="{StaticResource GroupValue}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
