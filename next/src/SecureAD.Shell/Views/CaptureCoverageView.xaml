<UserControl x:Class="SecureAD.Shell.Views.CaptureCoverageView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SecureAD.Shell.ViewModels">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:TreeGapViewModel}">
            <StackPanel Margin="0,4,0,8">
                <TextBlock Text="{Binding Kind}" Style="{StaticResource RowTitle}" />
                <TextBox Text="{Binding Subject, Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                         FontFamily="{StaticResource IdentifierFontFamily}" />
                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{x:Static vm:ObjectNavigationText.CoverageBoundary}" TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8" />
                    <TextBlock Text="{x:Static vm:ObjectNavigationText.RunGaps}" Style="{StaticResource RowTitle}"
                               Visibility="{Binding HasCaptureGaps, Converter={StaticResource Shown}}" />
                    <ItemsControl ItemsSource="{Binding CaptureGaps}" />
                    <TextBlock Text="{x:Static vm:ObjectNavigationText.ScopeNotes}" Style="{StaticResource RowTitle}"
                               Visibility="{Binding HasScopeNotes, Converter={StaticResource Shown}}" />
                    <ItemsControl ItemsSource="{Binding ScopeNotes}" />
                    <TextBlock Text="{x:Static vm:ObjectNavigationText.NoTreeGaps}" TextWrapping="Wrap"
                               Visibility="{Binding HasNoTreeGaps, Converter={StaticResource Shown}}" />
                </StackPanel>
            </ScrollViewer>
    </Border>
</UserControl>
