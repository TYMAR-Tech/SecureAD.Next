<Application x:Class="SecureAD.Shell.App" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    The Fluent theme that ships with WPF from .NET 9 onward. First-party, so no
                    third-party styling package is taken on, and it carries the Windows 11
                    appearance, light and dark modes, and the user accent colour.

                    Merged as a resource dictionary rather than set through the ThemeMode
                    property: ThemeMode is marked Experimental (WPF0001) and documented as
                    subject to removal, which is not a dependency this product should take
                    for how it looks.
                -->
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />

                <!--
                    The product's own visual language, merged after Fluent so that where the two
                    describe the same control this one wins. Governed by
                    docs/decisions/0056-the-visual-language-encodes-three-states.md.

                    THE ORDER MATTERS AND IS NOT ALPHABETICAL. Each dictionary uses the ones
                    above it: brushes resolve palette values, state marks resolve brushes and
                    spacing, control templates resolve all of them. A dictionary moved above
                    its dependencies fails while parsing rather than quietly rendering wrong.

                    A theme switch replaces the active semantic palette, then recreates the one
                    shared brush dictionary against it. Application-level brush objects do not
                    re-evaluate an internal DynamicResource when only their palette is replaced;
                    every production brush use is therefore dynamic and receives the new objects.
                -->
                <ResourceDictionary Source="Themes/Palette.Dark.xaml" />
                <ResourceDictionary Source="Themes/Brushes.xaml" />
                <ResourceDictionary Source="Themes/Type.xaml" />
                <ResourceDictionary Source="Themes/Spacing.xaml" />
                <ResourceDictionary Source="Themes/StateMarks.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Themes/Tree.xaml" />
                <ResourceDictionary Source="Themes/Choices.xaml" />
                <ResourceDictionary Source="Themes/Tabs.xaml" />
                <ResourceDictionary Source="Themes/Assets.xaml" />
                <ResourceDictionary Source="Themes/Dashboard.xaml" />
                <ResourceDictionary Source="Themes/Home.xaml" />
                <ResourceDictionary Source="Themes/Delegations.xaml" />
                <ResourceDictionary Source="Themes/Rules.xaml" />
                <ResourceDictionary Source="Views/Sections/ObjectSectionTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
