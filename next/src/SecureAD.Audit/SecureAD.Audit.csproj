<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0-windows because capture uses System.DirectoryServices.Protocols.
         This is the only new project below the app that is Windows-bound, and the
         reason is LDAP, not presentation. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>SecureAD.Audit</RootNamespace>
    <AssemblyName>SecureAD.Audit</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="System.DirectoryServices.Protocols" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecureAD.Kernel\SecureAD.Kernel.csproj" />
    <ProjectReference Include="..\SecureAD.Evidence\SecureAD.Evidence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The capture session already keeps its offline connection substitution inside the
         assembly so that callers use the one production connection policy. The run's per-domain
         timings are internal for gate 4's reason - a bare list cannot say whether it was
         measured - and the check that the run measures them at all has to be able to read them.
         Same narrow grant the derivation, judgement, shell and command line already make. -->
    <InternalsVisibleTo Include="SecureAD.Next.Tests" />
  </ItemGroup>

</Project>
