<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SecureAD.Evidence</RootNamespace>
    <AssemblyName>SecureAD.Evidence</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecureAD.Kernel\SecureAD.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- BundleContents keeps its collections off the public surface, per gate 4: a bare list
         cannot say whether it is empty because nothing was found or because nothing looked. The
         command line formats them into a report, and the tests exercise them. Same narrow grant
         the audit, derivation, judgement, shell and command line projects already make. -->
    <InternalsVisibleTo Include="securead-cli" />
    <InternalsVisibleTo Include="SecureAD.Next.Tests" />
  </ItemGroup>

</Project>
