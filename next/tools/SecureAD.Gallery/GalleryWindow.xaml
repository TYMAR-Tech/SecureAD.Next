<Window x:Class="SecureAD.Gallery.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:vm="clr-namespace:SecureAD.Shell.ViewModels"
        Title="SecureAD control gallery - not part of the product"
        Height="900" Width="1240">

    <!--
        Every control the design system dresses, once, on one page.

        WHAT IS HERE IS WHAT THE PRODUCT ACTUALLY USES. Nothing is invented: there is no severity
        chip and no big-number tile, because the product has neither yet and a harness that shows
        vocabulary the product does not have is a harness that lies about the product.

        The two things known to be UNDRESSED are marked. They are the whole of what remains of
        F-0056-2 - the tick box, and anything that scrolls.
    -->

    <Window.Resources>
        <x:Array x:Key="Rows" Type="sys:String">
            <sys:String>ad.lab</sys:String>
            <sys:String>ba.ad.lab</sys:String>
            <sys:String>ph.ad.lab</sys:String>
        </x:Array>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The rail, exactly as the shell builds it: navy chrome, three entries, one selected. -->
        <Border Grid.Column="0" Background="{StaticResource RailBackground}">
            <StackPanel>
                <TextBlock Text="SecureAD"
                           FontFamily="{StaticResource UiFontFamily}"
                           FontSize="{StaticResource ScreenTitleFontSize}"
                           FontWeight="{StaticResource EmphasisFontWeight}"
                           Foreground="{StaticResource RailSelectedTextBrush}"
                           Margin="15,20,15,20" />

                <RadioButton Content="Home" GroupName="S" />
                <RadioButton Content="Runs" GroupName="S" IsChecked="True" />
                <RadioButton Content="Audit" GroupName="S" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">

                <TextBlock Text="Control gallery" Style="{StaticResource ScreenTitle}" />
                <TextBlock Text="Every control the product dresses. Not part of SecureAD."
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="0,2,0,20" />

                <!-- ============================ Type ============================ -->
                <TextBlock Text="Type" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Screen title" Style="{StaticResource ScreenTitle}" />
                        <TextBlock Text="Section title" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Row title" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Field label" Style="{StaticResource FieldLabel}"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="Body text, which is what most sentences on a screen are." />
                        <TextBlock Text="Caption" Style="{StaticResource Caption}" />
                        <TextBlock Text="CN=Linda Lopez,OU=Users,DC=ba,DC=ad,DC=lab"
                                   Style="{StaticResource Identifier}" />
                        <TextBlock Text="Secondary text, for a sentence supporting the one above it."
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>

                <!-- ============================ State marks ============================ -->
                <TextBlock Text="State marks - four states, four silhouettes"
                           Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ContentControl Content="{x:Static vm:FactState.EstablishedGood}" Style="{StaticResource StateMark}"
                                            VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Established, and good" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ContentControl Content="{x:Static vm:FactState.EstablishedBad}" Style="{StaticResource StateMark}"
                                            VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Established, and worth attention" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ContentControl Content="{x:Static vm:FactState.NotEstablished}" Style="{StaticResource StateMark}"
                                            VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Not established - the quietest, and the only hollow one"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Content="{x:Static vm:FactState.Fault}" Style="{StaticResource StateMark}"
                                            VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="A fault" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============================ Buttons ============================ -->
                <TextBlock Text="Buttons" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Ordinary" Margin="0,0,10,0" />
                        <Button Content="Primary" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                        <Button Content="Stop" Style="{StaticResource DangerButton}" Margin="0,0,10,0" />
                        <Button Content="Disabled" IsEnabled="False" Margin="0,0,10,0" />
                        <Button Content="Validate" />
                    </StackPanel>
                </Border>

                <!-- ============================ Fields ============================ -->
                <TextBlock Text="Fields" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBox Text="An editable field" Width="300" HorizontalAlignment="Left"
                                 Margin="0,0,0,10" />
                        <TextBox Text="" Width="300" HorizontalAlignment="Left" Margin="0,0,0,10" />
                        <TextBox Text="A selectable message, which an operator can copy."
                                 Style="{StaticResource SelectableMessage}" />

                        <!-- UNDRESSED. Still WPF's own. One of the two things left in F-0056-2. -->
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <CheckBox IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Tick box - UNDRESSED, still Windows' own"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============================ The table ============================ -->
                <TextBlock Text="The table" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <DataGrid ItemsSource="{StaticResource Rows}"
                              ColumnHeaderStyle="{StaticResource TableColumnHeader}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="Transparent"
                              BorderBrush="{StaticResource DividerBrush}"
                              HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                              MinRowHeight="{StaticResource DenseRowMinHeight}"
                              ColumnHeaderHeight="34"
                              MaxHeight="180">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Include" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="True" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Domain" Binding="{Binding}" MinWidth="150" />
                            <DataGridTextColumn Header="Read from" Binding="{Binding}" MinWidth="190" />
                            <DataGridTemplateColumn Header="Read it from instead" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Width="200" Margin="0,0,8,0" />
                                            <Button Content="Validate" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- ============================ Scrolling ============================ -->
                <TextBlock Text="Scrolling - UNDRESSED, still Windows' own"
                           Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <ScrollViewer Height="90" VerticalScrollBarVisibility="Visible">
                        <StackPanel>
                            <TextBlock Text="One" /><TextBlock Text="Two" /><TextBlock Text="Three" />
                            <TextBlock Text="Four" /><TextBlock Text="Five" /><TextBlock Text="Six" />
                            <TextBlock Text="Seven" /><TextBlock Text="Eight" /><TextBlock Text="Nine" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ============================ Surfaces ============================ -->
                <TextBlock Text="Surfaces and chrome" Style="{StaticResource SectionTitle}"
                           Margin="0,0,0,8" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,40">
                    <StackPanel>
                        <Border Background="{StaticResource SurfaceBackground}" Padding="10"
                                Margin="0,0,0,6">
                            <TextBlock Text="Surface" />
                        </Border>
                        <Border Background="{StaticResource SurfaceRaisedBackground}" Padding="10"
                                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                                Margin="0,0,0,6">
                            <TextBlock Text="Raised surface, ruled" />
                        </Border>
                        <Border Background="{StaticResource FaultSubtleBrush}"
                                BorderBrush="{StaticResource FaultBrush}" BorderThickness="1"
                                Padding="10" Margin="0,0,0,6">
                            <TextBlock Text="A notice - what a MessageBox used to be" />
                        </Border>
                        <Border Background="{StaticResource ScrimBrush}" Padding="10">
                            <TextBlock Text="The scrim, laid over a surface a panel has taken the place of"
                                       Foreground="{StaticResource RailSelectedTextBrush}" />
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
